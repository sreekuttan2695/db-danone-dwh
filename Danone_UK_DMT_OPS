CREATE function [ma_cff].[ufn_1week_sales_data_Adeel_bkp] 
(	
	-- Add the parameters for the function here
	@iriweek int 
)
RETURNS TABLE 
AS
RETURN
(

with ecom_data as
(
select pd.*, iriweek from ecom.tesco_all_backdata_pivot pd
join [uksqlwp09\bld1].sl_time.dbo.sl_week t on convert(datetime,pd.sat_week_end_date) = t.datestamp and iriweek = @iriweek
),


prods_with_max_gencode as
(
Select stub_prodkey, swcode, min(gencode) gencode from ecom.stub_attrs
group by stub_prodkey, swcode
),
 
Prods as
(select 
        gencode,
		iricode = stuff(stub_prodkey,3,0,gencode)
	   ,swcode	=	case --if these are Sainsbury or Tesco PL codes then remove the 27 coding
							when
								stub_prodkey like '27_011%' or stub_prodkey like '27_052%' or stub_prodkey like '27_008%' 
							then
								concat('00000',right(stuff(stub_prodkey,3,0,gencode),7))
						else
							stuff(stuff(stub_prodkey,3,0,gencode),3,1,'')
						end
		,prodkey =	stub_prodkey --stuff(iricode,3,1,'')
 from prods_with_max_gencode
),

tpn_ean_xref as
(select * from ( 
select 
RANK() OVER(PARTITION BY tpn ORDER BY iricode asc) ean_rank,
	tpn,swcode, prodkey, ean,iricode from rdw.ecom_tes_prod_master_tpn_ean_xref x
join Prods s  on left(rtrim(x.ean),12) = stuff(s.iricode,3,1,'')
) a where ean_rank = 1
),

tes_ecomm as (
select 
ret				=	'tes'
,cff_geogid		=	'00001'
,xf.iricode
,Prodkey
,xf.swcode
,unit_sales		=	Sales_units
,val_sales		=	Sales_value	*	100										--	to show values in pence
,unit_price		=	CASE WHEN Sales_value <> 0 THEN (Sales_value	*	100) / (Sales_units * 1.00) ELSE 0 END 
,iriweek
 from ecom_data d
join tpn_ean_xref xf on d.TPN = xf.tpn
)

select distinct
	*
--,	iriweek			=	case when (select iriweek from time_ids) = @iriweek then cast(@iriweek as varchar) else concat('No data for requested week ',@iriweek,'; presenting week ',(select iriweek from time_ids),' for iriweek ',@iriweek) end
,	cff_output		=	concat
						(
							bc.bc_13
						,	cff_geogid
						,	'+'
						,	right(concat('00000000000',round(unit_sales,0)),11)
						,	'+'
						,	right(concat('00000000000',convert(nvarchar,convert(bigint,round(val_sales,0)))),11)
						,	'+'
						,	right(concat('00000000000',convert(nvarchar,convert(bigint,round(unit_price,0)))),11)
						)
,	cff_filename	=	concat('infoscan.',@iriweek,'.sl1.SALES')
,	ecf_output		=	concat
						(
							stuff(iricode,3,0,'0')								,	char(9)
						,	cff_geogid											,	char(9)
						,	''														,	char(9)	-- Day - empty as this is weekly
						,	''														,	char(9) -- Transaction code - empty
						,	round(unit_sales,0)									,	char(9)
						,	convert(nvarchar,convert(bigint,round(val_sales,0)))	,	char(9)
						,	convert(nvarchar,convert(bigint,round(unit_price,0)))
						)
,	ecf_filename	=	concat('common.uk.',@iriweek,'.sl1.WEEKLY')
from
tes_ecomm
cross apply
	get_bc(prodkey) bc
)
GO
