CREATE FUNCTION [dbo].[get_bc] 
(	
	-- Add the parameters for the function here
	@bc_no_cd char(12) 
	 
)
RETURNS TABLE 
AS
RETURN 
(
	-- Add the SELECT statement with parameter references here
	select bc_13 = 
    @bc_no_cd + ltrim(right(10 - right(((Cast(Left(right(rtrim(@bc_no_cd), 11),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 9),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 7),1) as int) + 
	Cast(Left(right(rtrim(@bc_no_cd), 5),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 3),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 1),1) as int)) * 3) + 
	Cast(Left(right(rtrim(@bc_no_cd), 12),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 10),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 8),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 6),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 4),1) as int) +
	Cast(Left(right(rtrim(@bc_no_cd), 2),1) as int), 1), 1)) 
)

