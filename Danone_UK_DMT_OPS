-- =============================================
-- Author:		Adeel Abid
-- Create date: 07/10/2021
-- Description:	Creating procedure to move code from job to procedure for updating dim tables (IMS.dim_time,RDW.IMS_MASTER_TIME,ims.dim_prod)
-- =============================================
CREATE PROCEDURE [iqvia].[sp_update_ims_dim_tbls]
	
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

	BEGIN TRY
	truncate table IMS.dim_time
	insert into IMS.dim_time
	select TimeID = right(column_name,7)
	from information_schema.columns 
	where table_schema='ims' and table_name in('latest_ims_data_view','latest_ims_data_view_uk') and column_name like '%MTH%'
	group by right(column_name,7) 
	order by min(ordinal_position)

	END TRY
	
	BEGIN CATCH
	SELECT ERROR_MESSAGE() AS [Error Message]
         ,ERROR_LINE() AS ErrorLine
         ,ERROR_NUMBER() AS [Error Number]  
         ,ERROR_SEVERITY() AS [Error Severity]  
         ,ERROR_STATE() AS [Error State]  
	END CATCH

	
	BEGIN TRY
	insert into RDW.IMS_MASTER_TIME
	select * from [RDW].[IMS_MASTER_TIME_UPDATE_VIEW]
	except
	select * from RDW.IMS_MASTER_TIME
	END TRY
	
	BEGIN CATCH
	SELECT ERROR_MESSAGE() AS [Error Message]
         ,ERROR_LINE() AS ErrorLine
         ,ERROR_NUMBER() AS [Error Number]  
         ,ERROR_SEVERITY() AS [Error Severity]  
         ,ERROR_STATE() AS [Error State]  
	END CATCH
    
	BEGIN TRY
	truncate table ims.dim_prod
	insert into ims.dim_prod
	select IMS_Pack, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format] 
	from ims.latest_ims_data_view where Category <> ''
	union
	select IMS_Pack, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format] 
	from ims.latest_ims_data_view_uk where Category <> ''
	END TRY

	BEGIN CATCH
	SELECT ERROR_MESSAGE() AS [Error Message]
         ,ERROR_LINE() AS ErrorLine
         ,ERROR_NUMBER() AS [Error Number]  
         ,ERROR_SEVERITY() AS [Error Severity]  
         ,ERROR_STATE() AS [Error State]  
	END CATCH
	
END
GO
