-- Description: Roll-forward STORE files were creating blank when selecting from ma_cff.view_store_file due to rdw.master_time_iri_xref having no future weeks.
--				Method for ECF generation changed to create STORE file based on selecting from table function ma_cff.ufn_1week_store_file_data
--
-- Author:		Chris Westgate
-- Change date:	27 Nov 2020
-- Description: TODO: add restriction for JS e-commerce to not perform any JS actions for weeks after 2150 owing to Danone purchase of JSO data from this point
--				add jobsteps to trnsfer files, email notificaion and transfer files.
-- =============================================
--/*
CREATE procedure [ma_cff].[usp_create_ecf_fileset] 
	-- Add the parameters for the stored procedure here
	@file_path		nvarchar(max)	=	N'\\WIN0287\PROJECTS\DANONE\ma_cff_files\'	-- file path for generation of flat files
, 	@full_run		varchar(1)		=	'N'											-- 'Y' if sproc should produce flat files for every week in rdw.master_time_iri_xref (160 weeks)
,	@run_s_week		int				=	null										-- if full run is 'Y' this is irrelevant otherwise if left null with null run_e_week will create for all weeks in latest 445 otherwise this is the start week of range to create
,	@run_e_week		int				=	null										-- if full run is 'Y' this is irrelevant otherwise if left null with null run_s_week will create for all weeks in latest 445 otherwise this is the end week of range to create
,	@roll_forward	varchar(1)		=	'Y'											-- if set to 'Y' then if on full run or creating ECF files for latest period weeks, will add a further 8 weeks - will not have any effect if running for specified range
,	@refresh_mst	varchar(1)		=	'Y'											-- 'Y' will ensure that local master summary table (comm code) data is refreshed with data from main store-level database server (UKSQLWP09\BLD1)
,	@create_sales	nvarchar(max)	=	N'Y'										-- 'Y' will ensure export code for SALES file is included
,	@create_master	nvarchar(max)	=	N'Y'										-- 'Y' will ensure export code for MASTER file is included
,	@create_catdesc	nvarchar(max)	=	N'Y'										-- 'Y' will ensure export code for CATDESC file is included
,	@create_store	nvarchar(max)	=	N'Y'										-- 'Y' will ensure export code for STORE file is included
,	@cff_format		nvarchar(max)	=	N'N'										-- 'Y' will create export code for common format files
,	@ecf_format		nvarchar(max)	=	N'Y'										-- 'Y' will create export code for extended common format files
,	@create_job		varchar(1)		=	N'Y'										-- 'N' will not create the job
,	@run_job		nvarchar(max)	=	N'Y'										-- 'N' will not perform the export but if job not createdwill display the SQL to be used to perform the export, for debugging purposes

as begin
--*/begin														/*
--*/	declare		@file_path		nvarchar(max)	=	N'\\WIN0287\PROJECTS\DANONE\ma_cff_files\'		/*
--*/	declare		@full_run		varchar(1)		=	'N'												/*
--*/	declare		@run_s_week		int				=	null											/*
--*/	declare		@run_e_week		int				=	null											/*
--*/	declare		@roll_forward	varchar(1)		=	'Y'												/*
--*/	declare		@refresh_mst	varchar(1)		=	'N'												/*
--*/	declare		@create_sales	nvarchar(max)	=	N'Y'											/*
--*/	declare		@create_master	nvarchar(max)	=	N'Y'											/*
--*/	declare		@create_catdesc	nvarchar(max)	=	N'Y'											/*
--*/	declare		@create_store	nvarchar(max)	=	N'Y'											/*
--*/	declare		@cff_format		nvarchar(max)	=	N'N'											/*
--*/	declare		@ecf_format		nvarchar(max)	=	N'Y'											/*
--*/	declare		@create_job		varchar(1)		=	N'Y'											/*
--*/	declare		@run_job		nvarchar(max)	=	N'N'

--local variable declarations
	declare @earliest_run_week	nvarchar(max)	
	declare @latest_run_week	nvarchar(max)
	declare @bcp_export_cmd_sql	nvarchar(max)	=	null

	if @full_run = 'Y'
		select
			@earliest_run_week	=	cast(min(iriweek) as nvarchar(max))
		,	@latest_run_week	=	cast(max(iriweek) + case when @roll_forward='Y' then 8 else 0 end as nvarchar(max))
		from
			rdw.master_time_iri_xref
	else
		if coalesce(@run_s_week,@run_e_week) is null 
			select top 1
				@earliest_run_week	=	cast(x.iriweek-(cast(left(t.timelabel,1) as int)-1) as nvarchar(max))
			,	@latest_run_week	=	cast(x.iriweek + case when @roll_forward='Y' then 8 else 0 end as nvarchar(max))
			from
				rdw.master_time_iri_xref x 
			join
				(select enddate, timelabel from rdw.master_time where tlevel in ('04WEEK','05WEEK')) t on t.enddate=x.enddate
			order by
				x.iriweek desc
		else
			if @run_s_week is null
				select
					@earliest_run_week	=	cast(min(iriweek) as nvarchar(max))
				,	@latest_run_week	=	cast(@run_e_week as nvarchar(max))
				from
					rdw.master_time_iri_xref
			else
				if @run_e_week is null
					select
						@earliest_run_week	=	cast(@run_s_week as nvarchar(max))
					,	@latest_run_week	=	cast(max(iriweek) as nvarchar(max))
					from
						rdw.master_time_iri_xref
				else
					if @run_s_week > @run_e_week
						select
							@earliest_run_week	=	cast(@run_e_week as nvarchar(max))
						,	@latest_run_week	=	cast(@run_s_week as nvarchar(max))
					else
						select
							@earliest_run_week	=	cast(@run_s_week as nvarchar(max))
						,	@latest_run_week	=	cast(@run_e_week as nvarchar(max))

	raiserror('running from iriweek %s to iriweek %s',0,1,@earliest_run_week,@latest_run_week) with nowait
	if @roll_forward = 'Y'
		raiserror('(latest 8 weeks are rolled forward from latest week of genuine data)',0,1) with nowait

	if @refresh_mst='Y' begin
		raiserror('updating tesco master summary table (main_sldb.sl_tes.dbo.sl_master_summary_table -> ma_cff.tes_mst)',0,1) with nowait
		truncate table ma_cff.tes_mst
		insert into
			ma_cff.tes_mst
		select
			*
		from
			main_sldb.sl_tes.dbo.sl_master_summary_table

		if @earliest_run_week < 2151 begin --only perform JSB actions if we are creating data from earlier than 2151 when Danone started purchasing JSO instead of sending JS E-Commerce to us
			raiserror('updating sainsbury master summary table (main_sldb.sl_jsb.dbo.sl_master_summary_table -> ma_cff.jsb_mst)',0,1) with nowait
			truncate table ma_cff.jsb_mst
			insert into
				ma_cff.jsb_mst
			select
				*
			from
				main_sldb.sl_jsb.dbo.sl_master_summary_table
		end

		raiserror('updating tesco catdesc summary table (main_sldb.sl_tes.dbo.sl_catdesc_summary_table -> ma_cff.tes_catdesc)',0,1) with nowait
		truncate table ma_cff.tes_catdesc
		insert into
			ma_cff.tes_catdesc
		select
			*
		from
			main_sldb.sl_tes.dbo.sl_catdesc_summary_table

		if @earliest_run_week < 2151 begin --only perform JSB actions if we are creating data from earlier than 2151 when Danone started purchasing JSO instead of sending JS E-Commerce to us
			raiserror('updating sainsbury catdesc summary table (main_sldb.sl_jsb.dbo.sl_catdesc_summary_table -> ma_cff.jsb_catdesc)',0,1) with nowait
			truncate table ma_cff.jsb_catdesc
			insert into
				ma_cff.jsb_catdesc
			select
				*
			from
				main_sldb.sl_jsb.dbo.sl_catdesc_summary_table
		end
	end
	else
		raiserror('passed-in parameter @refresh_mst not set to ''Y'', using existing master summary and catdesc data',0,1) with nowait

	raiserror('generating query to create job steps',0,1) with nowait
	select
		@bcp_export_cmd_sql = 
			N';with
'		+	N'	run_weeks as
'		+	N'	(
'		+	N'		select
'		+	N'			iriweek		=	(N-1)+' + @earliest_run_week + N'
'		+	N'		,	str_iriweek	=	cast((N-1)+' + @earliest_run_week + N' as nvarchar(max))
'		+	N'		from
'		+	N'			' + db_name() + N'.qc.ufn_numbers((' + @latest_run_week + N'-' + @earliest_run_week + N')+1)
'		+	N'	)
'		+	N'
'		+	N'select
'		+	N'	ac.sc_type
'		+	N',	ac.bcp_cmd
'		+	N'from
'		+	N'(
'		+	N'	--common format files here
'		+	N'	--SALES file (this is weekly data)
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	1
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select cff_output from ' + db_name() + N'.ma_cff.ufn_1week_sales_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''infoscan.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.SALES'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @cff_format + N'''	=	''Y''
'		+	N'	and	''' + @create_sales + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--MASTER file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	2
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_master_file_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''infoscan.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.MASTER'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @cff_format + N'''	=	''Y''
'		+	N'	and	''' + @create_master + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--CATDESC file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	3
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_catdesc_file_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''infoscan.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.CATDESC'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @cff_format + N'''	=	''Y''
'		+	N'	and	''' + @create_catdesc + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--STORE file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	4
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.view_store_file where iriweek='' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''infoscan.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.STORE'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @cff_format + N'''	=	''Y''
'		+	N'	and	''' + @create_store + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--extended common format files here
'		+	N'	--WEEKLY file (sales data)
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	5
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_sales_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''common.uk.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.WEEKLY'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @ecf_format + N'''	=	''Y''
'		+	N'	and	''' + @create_sales + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--MASTER file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	6
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_master_file_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''common.uk.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.MASTER'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @ecf_format + N'''	=	''Y''
'		+	N'	and	''' + @create_master + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--CATDESC file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	7
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_catdesc_file_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''common.uk.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.CATDESC'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @ecf_format + N'''	=	''Y''
'		+	N'	and	''' + @create_catdesc + N'''	=	''Y''
'		+	N'	union all
'		+	N'	--STORE file
'		+	N'	select
'		+	N'		iriweek
'		+	N'	,	op_type	=	8
'		+	N'	,	sc_type	=	''CmdExec''
'		+	N'	,	bcp_cmd	=	concat
'		+	N'					(
'		+	N'						cast(N''bcp "select ecf_output from ' + db_name() + N'.ma_cff.ufn_1week_store_file_data('' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N'')'' as nvarchar(max))
'		+	N'					,	cast(N''" queryout "'' as nvarchar(max))
'		+	N'					,	N''' + @file_path + N'''
'		+	N'					,	cast(N''common.uk.'' as nvarchar(max))
'		+	N'					,	str_iriweek
'		+	N'					,	cast(N''.sl1.STORE'' as nvarchar(max))
'		+	N'					,	cast(N''" /c /T /S' + @@SERVERNAME + N''' as nvarchar(max))
'		+	N'					)
'		+	N'	from
'		+	N'		run_weeks
'		+	N'	where
'		+	N'		''' + @ecf_format + N'''	=	''Y''
'		+	N'	and	''' + @create_store + N'''	=	''Y''
'		+	N') ac
'		+	N'order by
'		+	N'	ac.iriweek
'		+	N',	ac.op_type'

	if @create_job='Y'
		raiserror('creating export job',0,1) with nowait
	else
		raiserror('selecting export job step commands',0,1) with nowait

	exec STG.create_generic_multistep_multitype_job
		@job_db			=	'Danone_UK_DMT_OPS'
	,	@job_name		=	'DAN_SN_DMT_TO_MA_ECOM_ECF_EXPORT'
	,	@job_cat		=	'Danone DMT to MA transition'
	,	@job_desc		=	'Creates extended common format files of E-Commerce data provided by Danone, exported from DMT system db Danone_UK_DMT_OPS for import as new retailer for MA consumption'
	,	@job_step_query	=	@bcp_export_cmd_sql
	,	@run_dyn_sql	=	@create_job
	,	@start_job		=	@run_job

end
