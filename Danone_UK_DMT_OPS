CREATE view [PRD].[DIM_TIME] as

with	AllTimes	as	(	select CONVERT(INT,TIME_KEY) TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL
							from RDW.MASTER_TIME
						)
--	select * from AllTimes	/*
,		W01Weeks	as	(	select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL 
							from AllTimes
							where left(TLEVEL,2)='01'
						)
--	select * from W01Weeks	/*
,		W45Times	as	(	select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL
							from AllTimes
							where left(TLEVEL,2) in ('04','05')
						)
--	select * from W45Times order by TIME_SORT	/*
,		W13Times	as	(	select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL
							from AllTimes
							where left(TLEVEL,2)='13'
						)
--	select * from W13Times	/*
,		W52Times	as	(	select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL
							from AllTimes
							where left(TLEVEL,2)='52'
						)
--	select * from W52Times	/*
,		YTDTimes	as	(	select a.TimeID, a.EndDate, a.TIME_KEY, a.TIME_SORT, a.LONGNAME, a.SHORTNAME, a.TimeLabel, a.TLEVEL
							from AllTimes a
							where a.SHORTNAME like 'YTD%'
							and not exists	(	select 0 
												from	(	select TimeID from W45times
															union all
															select TimeID from W13times
															union all
															select TimeID from W52times
														) e
												where e.TimeID	=	a.TimeID
											)
						)
--	select * from YTDTimes	/*

select
	TimeID
,	EndDate
,	TIME_KEY
,	TIME_SORT
,	LONGNAME
,	SHORTNAME
,	TimeLabel
,	TLEVEL
,	LatestWeek		=	CASE WHEN TIMEID=(select MAX(TIMEID) from W01Weeks) then 1 else 0 end
,	Latest45Week	=	CASE WHEN left(TLEVEL,2) in ('04','05') and TIME_SORT=(select MAX(TIME_SORT) from W45Times) then 1 else 0 end
,	Latest13Week	=	CASE WHEN TIMEID=(select MAX(TIMEID) from W13Times) then 1 else 0 end
,	Latest52Week	=	CASE WHEN TIMEID=(select MAX(TIMEID) from W52Times) then 1 else 0 end
,	YTD				=	CASE WHEN SHORTNAME='YTD' then 1 else 0 end
,	YTD_YAG			=	CASE WHEN SHORTNAME='YTD YAG' then 1 else 0 end
from	(	
			select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from W01Weeks
			union
			select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from W45Times
			union
			select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from W13Times
			union
			select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from W52Times
			union
			select TimeID, EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from YTDTimes
		) AllTime

