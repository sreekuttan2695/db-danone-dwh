CREATE PROC [STG].[FACT_CSD_VIEW_CREATE]

@run_dyn_sql varchar(1)='Y'

as

/*
Requires STG.SUBVIEW_COALESCE to be correctly populated before execution

This is populated in sproc STG.FACT_SUBVIEW_COALESCE
*/
declare @MaxMeasLoadTable nvarchar(100)
declare @ProdViewName nvarchar(150)
declare @cmd_exec varchar(2000)
declare @dynsql nvarchar(2000)
--declare @FactviewCreatePath varchar(1000)='D:\Projects\Danone\SSIS\CreateSQL\FinalViewCreates.SQL' --e.g.'D:\Projects\Danone\SSIS\CreateSQL\FinalViewCreates.SQL'
--Commented line above declared folder used in 444 system, altered to below to avoid clashes #445_change
declare @FactviewCreatePath varchar(1000)='D:\Projects\Danone\SSIS\CreateSQL_445\FinalViewCreates.SQL' 

--RAISERROR('Stored proc STG.FACT_CSD_VIEW_CREATE requires a correct server path for the SQL create script file',16,1)
--RETURN

IF EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[STG].[FINAL_FACTVIEW_CREATE_STATEMENTS]') AND type in (N'U'))
  DROP TABLE [STG].[FINAL_FACTVIEW_CREATE_STATEMENTS]

CREATE TABLE [STG].[FINAL_FACTVIEW_CREATE_STATEMENTS](
	[VIEW_ID] [int] IDENTITY(1,1) NOT NULL,
	[VIEW_DEF] [varchar](max) NOT NULL
) ON [PRIMARY]

--First set up/alter the view to look at the longest list of measures
select top 1 @MaxMeasLoadTable=replace(MOVE_LOAD_TABLE_NAME,'FACT','MEAS')
from RDW.LOAD_MASTER where T2FILE_ID<37 and MOVE_LOADED=1
order by MEASURE_COUNT desc

select @dynsql=case when OBJECT_ID('RDW.MAX_MEASURE_VIEW', 'V') IS NOT NULL then 'ALTER ' else 'CREATE ' end
              +N'VIEW RDW.MAX_MEASURE_VIEW as select * from ' + @MaxMeasLoadTable
print @dynsql
exec sp_executesql @dynsql

--Delete existing views in the PRD schema
set @ProdViewName=''

while @ProdViewName < (select 'PRD.' + MAX(TABLE_NAME) from INFORMATION_SCHEMA.VIEWS where TABLE_SCHEMA='PRD' and TABLE_NAME like 'C%'
                       and TABLE_NAME not like '%CFACT%') begin
  select @ProdViewName='PRD.' + MIN(TABLE_NAME) from INFORMATION_SCHEMA.VIEWS 
    where TABLE_SCHEMA='PRD' and TABLE_NAME not like '%CFACT%' and TABLE_NAME like 'C%' and 'PRD.' + TABLE_NAME > @ProdViewName
  set @dynsql='drop view ' + @ProdViewName
  print @dynsql
  if @run_dyn_sql='Y' exec sp_executesql @dynsql
end;

--Populate factview create/alter statements for "single" ie non-coalesced fact subviews
with PotentialDuplicates as (select substring(table_name,charindex('C',table_name),5) + '_' +
                                    replace(table_name,left(table_name,charindex('C',table_name) + 14),'') ProperGrouping
                                   ,TABLE_SCHEMA, TABLE_NAME
                             from INFORMATION_SCHEMA.VIEWS where TABLE_SCHEMA='STG' and TABLE_NAME like 'LT%')

insert into [STG].[FINAL_FACTVIEW_CREATE_STATEMENTS]([VIEW_DEF])
select case when OBJECT_ID ('PRD.' + ProperGrouping, 'V') IS NOT NULL then 'ALTER ' else 'CREATE ' end
     + 'VIEW PRD.' + ProperGrouping + ' AS select GEOGID, TIMEID, PRODID, PLV, IS_LLVL'
     + RDW.MeasureSelectList(TABLE_NAME) + ' from ' + TABLE_SCHEMA + '.' + TABLE_NAME + ' D
'    + 'GO'
from PotentialDuplicates
     where ProperGrouping in (select ProperGrouping  from PotentialDuplicates
                              group by ProperGrouping having COUNT(TABLE_NAME)=1)

--Now insert coalesced view create/alter statements
insert into [STG].[FINAL_FACTVIEW_CREATE_STATEMENTS]([VIEW_DEF])
select case when OBJECT_ID (RetTimeA, 'V') IS NOT NULL then 'ALTER ' else 'CREATE ' end
                 + 'VIEW ' + RetTimeA + ' AS select coalesce(V.GEOGID, P.GEOGID) GEOGID, coalesce(V.TIMEID, P.TIMEID) TIMEID, coalesce(V.PRODID, P.PRODID) PRODID, '
                 + 'coalesce(V.PLV, P.PLV) PLV, coalesce(V.IS_LLVL, P.IS_LLVL) IS_LLVL' + (select ', coalesce(V.' + RDW.CleanMeasureName(MEAS_KEY,LONGNAME,'Y')
                 + N',P.' + RDW.CleanMeasureName(MEAS_KEY,LONGNAME,'Y')+ N') ' +  + RDW.CleanMeasureName(MEAS_KEY,LONGNAME,'Y')
                   from RDW.MAX_MEASURE_VIEW FOR XML PATH('')) + ' from ' + case when CoalesceOrderB>CoalesceOrderA then T2A else T2B end
                 + ' P ' + case when JoinOrderA=JoinOrderB then 'JOIN ' when JoinOrderA>JoinOrderB then 'LEFT OUTER JOIN ' else 'RIGHT OUTER JOIN ' end
                 + case when CoalesceOrderB>CoalesceOrderA then T2B else T2A end + ' V ON V.TIMEID=P.TIMEID and V.PRODID=P.PRODID
'                + 'GO'
from STG.SUBVIEW_COALESCE

SET @cmd_exec='sqlcmd -S ' + convert(varchar,SERVERPROPERTY('ServerName')) + ' -E -y 0 -Q "SET NOCOUNT ON select convert(varchar(max),view_def) from [' + DB_NAME() 
             +'].[STG].[FINAL_FACTVIEW_CREATE_STATEMENTS] order by VIEW_ID" -o "'+ @FactviewCreatePath + '"'
PRINT @cmd_exec
if @run_dyn_sql='Y' EXEC MASTER..XP_CMDSHELL @cmd_exec

SET @cmd_exec='sqlcmd -S ' + convert(varchar,SERVERPROPERTY('ServerName')) + ' -E -d ' + DB_NAME() + ' -i "'+ @FactviewCreatePath + '"'
PRINT @cmd_exec
if @run_dyn_sql='Y' EXEC MASTER..XP_CMDSHELL @cmd_exec

update RDW.LOAD_MASTER set CSD_VIEWS_CREATED=1
GO
