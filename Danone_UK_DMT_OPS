CREATE PROC [STG].[FACT_SUBVIEW_COALESCE]

@run_dyn_sql varchar(1)='Y'

as

--test
--exec [STG].[FACT_SUBVIEW_COALESCE] 'N'

IF EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[STG].[SUBVIEW_COALESCE]') AND type in (N'U'))
  DROP TABLE [STG].[SUBVIEW_COALESCE]

CREATE TABLE [STG].[SUBVIEW_COALESCE](
	[RetTimeA] [varchar](100) NOT NULL,
	[T2A] [varchar](100) NOT NULL,
	[JoinOrderA] [int] NULL,
	[CoalesceOrderA] [float] NULL,
	[RetTimeB] [varchar](100) NOT NULL,
	[T2B] [varchar](100) NOT NULL,
	[JoinOrderB] [int] NULL,
	[CoalesceOrderB] [float] NULL
) ON [PRIMARY]

IF  EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[STG].[SUBVIEW_PRECOALESCE]') AND type in (N'U'))
DROP TABLE [STG].[SUBVIEW_PRECOALESCE]

CREATE TABLE [STG].[SUBVIEW_PRECOALESCE](
	[T1] [bigint] NULL,
	[T1TBL] [nvarchar](257) NULL,
	[T1RT] [nvarchar](4000) NULL,
	[T2] [bigint] NULL,
	[T2TBL] [nvarchar](257) NULL,
	[T2RT] [nvarchar](4000) NULL
) ON [PRIMARY];

with PotentialDuplicates as (select substring(table_name,charindex('C',table_name),5) + '_' +
                                    replace(table_name,left(table_name,charindex('C',table_name) + 14),'') ProperGrouping
                                   ,TABLE_SCHEMA, TABLE_NAME
                             from INFORMATION_SCHEMA.VIEWS where TABLE_SCHEMA='STG' and TABLE_NAME like 'LT%')

insert into STG.SUBVIEW_PRECOALESCE
  select a.T1, a.T1TBL, a.T1RT, b.T2, b.T2TBL, b.T2RT  from  
    (select RANK() over (partition by ProperGrouping order by TABLE_NAME) T1,
            TABLE_SCHEMA + '.' + TABLE_NAME T1TBL, ProperGrouping T1RT
     from PotentialDuplicates
     where ProperGrouping in (select ProperGrouping  from PotentialDuplicates
                              group by ProperGrouping having COUNT(TABLE_NAME)=2)
     ) a
    join
    (select RANK() over (partition by ProperGrouping order by TABLE_NAME) T2,
            TABLE_SCHEMA + '.' + TABLE_NAME T2TBL, ProperGrouping T2RT
     from PotentialDuplicates
     where ProperGrouping in (select ProperGrouping  from PotentialDuplicates
                              group by ProperGrouping having COUNT(TABLE_NAME)=2)
     ) b on b.T2RT=a.T1RT
  where a.T1=1 and b.T2=2

declare @RetTime varchar(50)
declare @dynsql nvarchar(4000)

set @RetTime=''

while @RetTime<(select MAX(T1RT) from STG.SUBVIEW_PRECOALESCE) begin
  select @RetTime=MIN(T1RT) from STG.SUBVIEW_PRECOALESCE where T1RT>@RetTime
  select @dynsql=N'insert into STG.SUBVIEW_COALESCE ' +
                 N'select ''PRD.' + @RetTime + N''', T2A, JoinOrderA, CoalesceOrderA, RetTimeB, T2B, JoinOrderB, CoalesceOrderB ' +
                 N'from (select ''' + @RetTime + N''' RetTimeA, ''' + T1TBL + N''' T2A, count(*) JoinOrderA, Max(M00001011_Unit_Sales) CoalesceOrderA ' +
                 N'from ' + T1TBL + N' where PLV=1 and left(PROD_KEY,1)=''0'' group by T2FILE) A ' +
                 N'join (select ''' + @RetTime + ''' RetTimeB, ''' + T2TBL + N''' T2B, count(*) JoinOrderB, Max(M00001011_Unit_Sales) CoalesceOrderB ' +
                 N'from ' + T2TBL + N' where PLV=1 and left(PROD_KEY,1)=''0'' group by T2FILE) B on B.RetTimeB=A.RetTimeA'
  from STG.SUBVIEW_PRECOALESCE where T1RT=@RetTime
  print @dynsql
  if @run_dyn_sql = 'Y' exec sp_executesql @dynsql
end

GO
