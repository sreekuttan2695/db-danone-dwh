CREATE   VIEW [iqvia].[PRODUCT_EAN_LIST_CSV]
/* =============================================================================
   Purpose : RFC-4180 lines for iqvia.PRODUCT_EAN_LIST (every field quoted,
             embedded quotes doubled). Header row has sort_key = 0.
             Exported by bcp with ORDER BY sort_key, sort_name.
   Change  : 2026-09-23  initial version
   ============================================================================= */
AS
SELECT sort_key  = 0,
       sort_name = CONVERT(nvarchar(255), NULL),
       csv_line  = CONVERT(nvarchar(max),
                   N'"Prod_Desc","Mapping_Status","Prod_Source","EAN","iricode14","Mapped_On","Lookup_Rows",'
