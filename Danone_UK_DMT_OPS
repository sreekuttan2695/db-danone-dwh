CREATE VIEW [RDW].[IMS_MASTER_TIME_UPDATE_VIEW] as

--NOTE that although IMS data is no longer broken into weeks in the IMS TIME views or in the CSD,
-- weeks are still required to enable period end dates to be calculated for new periods, from their previous year's counterparts

with newmonth as (	/*
					--TEST
					select NM='MTH0817' --<----- PUT A "NEW" MONTH IN HERE IN FORMAT MTHmmYY
--*/				select NM=TimeID from IMS.DIM_TIME												/*
--*/				except																			/*
--*/				select distinct IMSMonth from RDW.IMS_MASTER_TIME where IMSMonth is not null	
				)
-- select * from newmonth /*
,    yagmonth as (select NM,LEFT(NM, 5) + convert(varchar,convert(int,RIGHT(nm,2))-1) ym from newmonth)
-- select * from yagmonth /*
,    yagtimes as (select * from RDW.IMS_MASTER_TIME where IMSMonth in (select ym from yagmonth))
-- select * from yagtimes /*
,    newweeks as (select IMSYear+1 IMSYear, convert(varchar,IMSYear + 1) + RIGHT(IMSQuarter,5) IMSQuarter, NM.NM IMSMonth
	                   , 'w/e ' + convert(varchar, dateadd(dd,-1,dateadd(yyyy,1,convert(datetime,REPLACE(IMSWeek,'w/e ','')))), 106) IMSWeek
	                   , dateadd(yyyy,1,convert(datetime,REPLACE(IMSWeek,'w/e ',''))) IMSWeekEnd
                  from yagtimes y join yagmonth ym on ym.ym=y.IMSMonth join newmonth nm on nm.nm=ym.nm)
-- select * from newweeks /*
select * from (
SELECT distinct TimeID = '445' + CONVERT(varchar, IMSYear), IMSYear, IMSQuarter = null, IMSMonth = null, IMSWeek = null from newweeks
union all
SELECT distinct TimeID = '445' + CONVERT(varchar, IMSYear) + '00' + RIGHT(IMSQuarter,1), IMSYear, IMSQuarter, IMSMonth = null, IMSWeek = null from newweeks
union all
select TimeID = '445'+CONVERT(varchar,max(IMSWeekEnd),112), IMSYear, IMSQuarter, IMSMonth, IMSWeek = null from newweeks group by IMSYear, IMSQuarter, IMSMonth
union all
select TimeID = '445001' + CONVERT(varchar,IMSWeekEnd,12), IMSYear, IMSQuarter, IMSMonth, IMSWeek from newweeks where IMSWeek is not null) a
except select * from rdw.IMS_MASTER_TIME
--*/--*/--*/--*/--*/--*/--*/--*/

