    [GEOG_KEY] [varchar](50) NOT NULL,
    [PROD_KEY] [varchar](50) NOT NULL,
    [CATID]    [varchar](50) NULL' + (
select ', ' + [RDW].[CleanMeasureName](MEAS_KEY,LONGNAME,'Y') + ' Float NULL' 
