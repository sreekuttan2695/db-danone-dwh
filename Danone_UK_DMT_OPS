CREATE view [RDW].[view_loaded_product_provenance] as 
select
	l.t2file_id
,	l.t2file_name
,	p.prod_id
,	p.prod_key
,	p.prod_cc
,	longname		=	ltrim(rtrim(p.longname)) +
						case	when left(prod_key,1)='9' 
								then ' - ' + stuff(right(prod_key,13),3,0,'0')
								else '' 
						end
,	p.prod_attr1
,	p.prod_attr2
