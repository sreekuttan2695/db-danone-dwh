CREATE proc [STG].[OBS_TRANSFORM] as

declare @DynSQL nvarchar(4000)
declare @OBSRowCount int

--Requires RDW.MASTER_PROD and RDW.MASTER_TIME to already have been updated

--Add in any geographies that don't already exist in RDW.MASTER_GEOG for OBS
--there haven't been any so far so I am just raising an error here so when we do
-- get some the code can be written to update the RDW.MASTER_GEOG table
if exists (
select distinct RET_DESC from obs.LatestData
except
select distinct ret_desc from rdw.MASTER_GEOG_XREF)
  --raiserror('Geographies exist in OBS.LatestData data that do not exist in RDW.MASTER_GEOG_XREF - sort it',16,1)
  insert into RDW.MASTER_GEOG
    select '000000', RET_DESC, RET_DESC, 1 from (select distinct RET_DESC from obs.LatestData
                                                 except
                                                 select distinct ret_desc from rdw.MASTER_GEOG_XREF) g

--Make sure we've got the latest swcodes to connect to the UPCs
exec RDW.REFRESH_SLDB_STUB_LOOKUP

--Check there aren't any missing products that are in OBS data but not yet in RDW.MASTER_PROD
if exists (select distinct left(UPC,12) from obs.LatestData where left(UPC,12) <> ''
           except
           select SWCODE from RDW.MASTER_PROD_XREF)
  raiserror('Products exist in OBS.LatestData data that do not exist in RDW.MASTER_PROD_XREF',16,1)

--HISTORIC - commented out: Ensure there are no datatype conversion issues with imported OBS data
--select * from OBS.LatestData where OBSUnit='NULL' or OBSValue='NULL' or OBSVolume='NULL'
--update OBS.LatestData set OBSUnit=null where OBSUnit='NULL'
--update OBS.LatestData set OBSValue=null where OBSValue='NULL'
--update OBS.LatestData set OBSVolume=null where OBSVolume='NULL'

--Add on the solution-specific unique integer IDs for Geography, Time and Product
--storing the output in a "non-aggregated" table
--
--note this table will likely have fewer rows that the Load table (actually a view, OBS.LatestData,
-- which should have been altered to point to the latest loaded OBS data) because OBS will contain
-- time periods outwith the 156 weeks in the DMT solution
select @OBSRowCount=COUNT(*) from OBS.LatestData --<--- for 20140731 data was 20628

truncate table STG.FACT_OBS_NONAGG

--NOTE prepending 1 to time_sort here to counter the removal of the prepended week count from time_sort
--  as part of 445 changes... 

insert into STG.FACT_OBS_NONAGG
--drop table tst.fact_obs_nonagg
select g.GEOG_ID, p.ProdID, convert(int,'1' + t.time_sort) TimeID,o.* 
--into tst.fact_obs_nonagg
from obs.LatestData o
join RDW.MASTER_GEOG_XREF g on g.ret_desc=o.RET_DESC
join RDW.MASTER_TIME_IRI_XREF t on t.IRIWeek=o.iriweek
join RDW.MASTER_PROD_XREF p on p.SWCODE=left(o.UPC,12) and o.iriweek between p.week_first_moved and p.WEEK_LAST_MOVED
--join RDW.MASTER_PROD_XREF p on p.SWCODE=left(o.UPC,12)
--select * from stg.FACT_OBS_NONAGG o
