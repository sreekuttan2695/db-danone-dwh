CREATE view [RDW].[master_time_ims_lkup] as

with week_days AS (
SELECT dow=0 UNION ALL SELECT dow=1 UNION ALL SELECT dow=2 UNION ALL
SELECT dow=3 UNION ALL SELECT dow=4 UNION ALL SELECT dow=5 UNION ALL
SELECT dow=6),

allwkdays AS (
SELECT DayDate=Dateadd(dd, -d.dow, e.datestamp),
EndDate=e.datestamp,
TIME_KEY=CONVERT(VARCHAR, e.datestamp, 112),
iriweek
FROM [uksqlwp09\bld1].sl_time.dbo.sl_week e, week_days d)

select 
daydate,
enddate,
time_key,
iriweek,
MonthN = Month(daydate),
ndays=Datediff(day, Dateadd(day, 1 - Day(daydate), daydate),
                   Dateadd(month, 1, Dateadd(day, 1 - Day(daydate), daydate))),
CONCAT('MTH',right(concat('0',cast(month(DayDate) as varchar(2))),2),cast(right(year(DayDate),2) as varchar(2))) imsmonth
from allwkdays
