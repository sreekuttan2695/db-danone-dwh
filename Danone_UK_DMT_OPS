,    LT as (select AH.ProdHierID, AH.LevType, AP.* from AP JOIN AH on AH.LevType<>'ST' and AH.CATID=LEFT(AP.PROD_CC,4)
            where left(AP.prod_key,3) in ('101','202','303','404','505','606','707','808','900'))
