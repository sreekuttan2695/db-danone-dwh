create view [dbo].[ma_cff] as

with
	tes_cc as
	(
		select
			cc.com_lvl
		,	cd.*
		from
		(
			select distinct com_lvl='COM1', code=left(comm1,2) from ma_cff.view_master_file where geog_id='tes'
			union all
			select distinct com_lvl='COM2', code=left(comm1,3) from ma_cff.view_master_file where geog_id='tes'
			union all
			select distinct com_lvl='COM3', code=left(comm1,4) from ma_cff.view_master_file where geog_id='tes'
			union all
			select distinct com_lvl='COM4', code=left(comm1,5) from ma_cff.view_master_file where geog_id='tes'
		) cc
		join --tst.tes_catdesc cd on cd.code=cc.code
		(	select
				r	=	rank() over (partition by code order by maxtime desc)
			,	*
			from
			(
				select
					*
				from
					ma_cff.tes_catdesc
			) tcd
		) cd on cd.code=cc.code
		where
			cd.r	=	1
	)
-- select * from tes_cc /*
,	jsb_cc as
	(
		select
			cc.com_lvl
		,	cd.*
		from
		(
			select distinct com_lvl='COM1', code=comm1 from ma_cff.view_master_file where geog_id='jsb'
			union all
			select distinct com_lvl='COM2', code=concat(comm1,comm2) from ma_cff.view_master_file where geog_id='jsb' --43 rows
		) cc
	join
	(	select
			r	=	rank() over (partition by code order by maxtime desc)
		,	*
		from
		(
			select
				*
			from
				ma_cff.jsb_catdesc
		) jcd
	) cd on cd.code=cc.code
	where
		cd.r	=	1
	)
-- select * from jsb_cc /*

select
	*
,	cff_output		=	concat(com_lvl,ccode,cast(cat_desc as char(50)))
,	cff_filename	=	concat('infoscan.',t.iriweek,'.sl1.CATDESC')
from
(
	select *, ccode=cast(left(code,2) as char(24)) from tes_cc where com_lvl='COM1'
	union all
	select *, ccode=cast(concat(cast(left(code,2) as char(6)),cast(left(code,3) as char(6))) as char(24)) from tes_cc where com_lvl='COM2'
	union all
	select *, ccode=cast(concat(cast(left(code,2) as char(6)),cast(left(code,3) as char(6)),cast(left(code,4) as char(6))) as char(24)) from tes_cc where com_lvl='COM3'
	union all
	select *, ccode=concat(cast(left(code,2) as char(6)),cast(left(code,3) as char(6)),cast(left(code,4) as char(6)),cast(left(code,5) as char(6))) from tes_cc where com_lvl='COM4'
	union all
	select *, ccode=cast(code as char(24)) from jsb_cc
) acc
cross join
	rdw.master_time_iri_xref t
---*/--*/--*/--*/--*/
GO
