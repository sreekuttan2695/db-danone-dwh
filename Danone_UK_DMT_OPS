create view [redslim].[load_tbl_fact_8] as

select
	rn				=	row_number() over (order by cast(time_key as int), geog_key, prod_key)
,	original_key	=	concat	(	catid
								,	time_key
								,	geog_key
								,	case 
										when right(prod_key,34)=replicate('0',34) then	'101'
										when right(prod_key,31)=replicate('0',31) then	'202'
										when right(prod_key,28)=replicate('0',28) then	'303'
										when right(prod_key,25)=replicate('0',25) then	'404'
										when right(prod_key,22)=replicate('0',22) then	'505'
										when right(prod_key,19)=replicate('0',19) then	'606'
										when right(prod_key,16)=replicate('0',16) then	'707'
										when right(prod_key,13)=replicate('0',13) then	'808'
										else											'900'
									end
								,	prod_key
								,	left(concat('00',(select cast(count(1) as varchar) from stg.load_tbl_meas_8)),4)
								)
,	* 
from
	stg.load_tbl_fact_8
where
	left(prod_key,1) <> '9'
