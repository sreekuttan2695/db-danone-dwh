--/*
CREATE proc [STG].[BUP_CREATE_FACT_SUBVIEW] 

 @t2filename varchar(500)
,@cat_id varchar(4) 
,@facttable varchar(50)
,@geogkey varchar(50)
,@timespan varchar(3)
,@run_cmd_sql varchar(1)='Y'

as 
--*/	declare	@t2filename		varchar(500)	=	'W2124.C4093A.R1210WO.DESC'		/*
--*/	declare	@cat_id			varchar(4)		=	'4093'							/*
--*/	declare	@facttable		varchar(50)		=	'STG.LOAD_TBL_FACT_1'			/*
--*/	declare	@geogkey		varchar(50)		=	'502155'						/*
--*/	declare	@timespan		varchar(3)		=	'001'							/*
--*/	declare	@run_cmd_sql	varchar(1)		=	'Y'

declare @cmd_exec varchar(8000)
declare @geogid int
declare @geogname varchar(500)
declare @tlevel varchar(10)
declare @subview_name varchar(500)

set nocount on

select @geogid=GEOG_ID, @geogname=LONGNAME from RDW.MASTER_GEOG where GEOG_KEY=@geogkey
select @tlevel=TLEVEL from RDW.MASTER_TIME where left(TIME_KEY,3)=@timespan
set @subview_name = LEFT(@facttable,CHARINDEX('.',@facttable)) + 'LT'
                  + RIGHT('000' + REPLACE(RIGHT(@facttable,len(@facttable)-charindex('.',@facttable)),'LOAD_TBL_FACT_',''),3)
                  + '_' + REPLACE(LEFT(RIGHT(@t2filename,LEN(@t2filename)-CHARINDEX('.',@t2filename)),
                    PATINDEX('%.D%',RIGHT(@t2filename,len(@t2filename)-charindex('.',@t2filename)))-1),'.','_')
                  + '_' + RDW.CleanString(@geogname,'[^A-Za-z0-9]') + '_' + @tlevel 

select cmd_exec='sqlcmd -E -S ' + convert(varchar,SERVERPROPERTY('ServerName')) + ' -d ' + DB_NAME() + ' -h-1 -Q "' +  case when OBJECT_ID (@subview_name, 'V') IS NOT NULL then 'ALTER ' else 'CREATE ' end
				+'VIEW ' + @subview_name + ' as WITH WEEKS AS (select CONVERT(INT,TIME_KEY) TimeID, EndDate, TIME_KEY, TIME_SORT'
				+', LONGNAME, SHORTNAME, TimeLabel, TLEVEL from RDW.MASTER_TIME where TLEVEL=''' + @tlevel
                +'''), PRODS AS (select *,coalesce(l9name, l8name, l7name, l6name, l5name, l4name, l3name, l2name, l1name) ProdName from '
                +'RDW.MASTER_PROD where CatID=' + @cat_id + ') SELECT ''' + @t2filename + ''' T2FILE, ' + convert(varchar,@geogid) +' GEOGID, '''
                + @geogname + ''' GEOG_NAME, T.TIMEID, P.PRODID, P.PLV, P.IS_LLVL, P.ProdName, D.TIME_KEY, D.GEOG_KEY, D.PROD_KEY, D.CATID'
                + RDW.MeasureSelectList(right(@facttable,len(@facttable)-patindex('%.L%',@facttable))) + ' FROM ' + @facttable 
                +' D JOIN WEEKS T ON T.TIME_KEY=D.TIME_KEY JOIN PRODS P ON P.PROD_KEY=D.PROD_KEY where D.GEOG_KEY=''' + @geogkey + '''"'
PRINT 'CREATING FOR ' + @t2filename
select create_cmd_exec=@cmd_exec
if @run_cmd_sql='Y' EXEC MASTER..XP_CMDSHELL @cmd_exec

GO
