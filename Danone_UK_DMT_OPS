/****** Object:  UserDefinedFunction [ma_cff].[ufn_1week_sales_data_bkp_20211110]    Script Date: 30/09/2026 07:46:39 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE function [ma_cff].[ufn_1week_sales_data_bkp_20211110]
(
-- Add the parameters for the function here
	@iriweek int
) RETURNS TABLE AS
RETURN
(	
	WITH TimeIDs as (
	select iriweek = case
			when exists	(select 1 from [PRD].[tes_ecom_data] where iriweek=@iriweek)
			then
				(select distinct iriweek from [PRD].[tes_ecom_data] where iriweek=@iriweek)
			else
				(select max(iriweek) from [PRD].[tes_ecom_data])
			end 
	)

	SELECT 
	 [item_dim_key]
    ,[tpn]
    ,[barcode]
    ,[upc]
    ,[prodkey]
    ,[iricode13]
    ,[iricode14]
    ,[geogid]
    ,[iriweek] = case when (select iriweek from TimeIDs) = @iriweek then cast(@iriweek as varchar) else concat('No data for requested week ',@iriweek,'; presenting week ',(select iriweek from TimeIDs),' for iriweek ',@iriweek) end
    ,[sales_units]
    ,[sales_value]
    ,[unit_price]
    , ecf_output = concat (iricode14,
							char(9),
							geogid, 
							char(9),
							'',
							char(9), -- Day - empty as this is weekly
							'', 
							char(9),                                   -- Transaction code - empty
							round(sales_units,0),
							char(9),
							convert(nvarchar,convert(bigint,round(sales_value,0))), 
							char(9),
							convert(nvarchar,convert(bigint,round(unit_price,0))) )
      , ecf_filename = concat('common.uk.',@iriweek,'.sl1.WEEKLY')
    from
        prd.tes_ecom_data where iriweek = (select iriweek from TimeIDs)
)
