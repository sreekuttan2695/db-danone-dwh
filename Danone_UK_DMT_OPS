CREATE PROC [STG].[CREATE_FACT_SUBVIEWS] 

@recreate_all_fsv varchar(1)='Y',
@run_dyn_sql varchar(1)='Y'

as

declare @catid nvarchar(4)
declare @ml_tblname varchar(200)
declare @t2fname varchar(500)
declare @dynsql nvarchar(4000)

--test
--exec STG.CREATE_FACT_SUBVIEWS 'N'

set @ml_tblname=''

while @ml_tblname < (select 'STG.' + MAX(TABLE_NAME) from INFORMATION_SCHEMA.VIEWS where TABLE_SCHEMA='STG' and TABLE_NAME like 'LT%') begin
  select @ml_tblname='STG.' + MIN(TABLE_NAME) from INFORMATION_SCHEMA.VIEWS 
    where TABLE_SCHEMA='STG' and TABLE_NAME like 'LT%' and 'STG.' + TABLE_NAME > @ml_tblname
  set @dynsql='drop view ' + @ml_tblname
  print @dynsql
  if @run_dyn_sql='Y' exec sp_executesql @dynsql
end

if @recreate_all_fsv='Y'
  update RDW.LOAD_MASTER set FACT_VIEW_CREATED=0

set @ml_tblname=''

while @ml_tblname<(select MAX(MOVE_LOAD_TABLE_NAME) from RDW.LOAD_MASTER where MOVE_LOADED=1 and FACT_VIEW_CREATED=0) begin
  select @ml_tblname=MIN(MOVE_LOAD_TABLE_NAME) from RDW.LOAD_MASTER where MOVE_LOADED=1 and FACT_VIEW_CREATED=0 and MOVE_LOAD_TABLE_NAME>@ml_tblname
  select @catid=substring(MOVE_LOAD_JOBNAME,charindex('C',MOVE_LOAD_JOBNAME)+1,4), @t2fname=right(t2file_name,len(t2file_name)-patindex('%\W%',t2file_name)) --backslash but no #445_change required
    from RDW.LOAD_MASTER where MOVE_LOAD_TABLE_NAME=@ml_tblname
  print @ml_tblname
  set @dynsql=N'declare @GKey nvarchar(50), @TPer nvarchar(3), @subviewname nvarchar(100), @sqlstring nvarchar(2000)
set @GKey=N''''
while @GKey<(select MAX(GEOG_KEY) from ' + @ml_tblname + ') begin
  select @GKey=MIN(GEOG_KEY) from ' + @ml_tblname + ' where GEOG_KEY>@GKey
  set @TPer=N''''
  while @TPer<(select MAX(left(TIME_KEY,3)) from ' + @ml_tblname + ' where GEOG_KEY=@GKey) begin
    select @TPer=MIN(left(TIME_KEY,3)) from ' + @ml_tblname + ' where GEOG_KEY=@GKey and left(TIME_KEY,3)>@TPer
    set @subviewname=N''' + @ml_tblname + '_' + ''' + @GKey + N''_'' + @TPer
    set @sqlstring=N''exec [STG].[CREATE_FACT_SUBVIEW] ''''' + @t2fname + ''''',''''' + @catid + ''''',''''' + @ml_tblname + ''''','
    + ''''''' + @GKey + '''''','''''' + @TPer + '''''',''''Y''''''
    print @sqlstring
    exec sp_executesql @sqlstring
  end
end'
  print @dynsql
  if @run_dyn_sql='Y' exec sp_executesql @dynsql

  update RDW.LOAD_MASTER set FACT_VIEW_CREATED=1 where MOVE_LOAD_TABLE_NAME=@ml_tblname
end

GO
