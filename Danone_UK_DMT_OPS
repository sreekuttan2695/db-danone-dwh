                              (V.PLV=3 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and coalesce(V.L4Name, P.L4Name) is null) or
                              (V.PLV=4 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and V.L4Name=P.L4Name and coalesce(V.L5Name, P.L5Name) is null) or
                              (V.PLV=5 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and V.L4Name=P.L4Name and V.L5Name=P.L5Name and coalesce(V.L6Name, P.L6Name) is null) or
                              (V.PLV=6 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and V.L4Name=P.L4Name and V.L5Name=P.L5Name and V.L6Name=P.L6Name and coalesce(V.L7Name, P.L7Name) is null) or
                              (V.PLV=7 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and V.L4Name=P.L4Name and V.L5Name=P.L5Name and V.L6Name=P.L6Name and V.L7Name=P.L7Name and coalesce(V.L8Name, P.L8Name) is null) or
                              (V.PLV=8 and V.L2Name=P.L2Name and V.L3Name=P.L3Name and V.L4Name=P.L4Name and V.L5Name=P.L5Name and V.L6Name=P.L6Name and V.L7Name=P.L7Name and V.L8Name=P.L8Name and coalesce(V.L9Name, P.L9Name, V.L10Name, P.L10Name) is null) or
                              (V.PLV=9 and V.L9Name=P.L9Name and V.L10Name=P.L10Name)
                             ) 
 when NOT MATCHED then
   insert (ProdHierID, PLV, IS_LLVL, CatID, PROD_KEY, L1Name, L2Name, L3Name
           , L4Name, L5Name, L6Name, L7Name, L8Name, L9Name, L10Name)
   values (V.ProdHierID, V.PLV, V.IS_LLVL, V.CatID, V.PROD_KEY, V.L1Name, V.L2Name, V.L3Name
           , V.L4Name, V.L5Name, V.L6Name, V.L7Name, V.L8Name, V.L9Name, V.L10Name)
 when NOT MATCHED by SOURCE
      and P.PROD_KEY NOT LIKE 'OLD%' 
      and P.ProdHierID IN (select ProdHierID 
                           from RDW.PROD_HIERARCHIES
                           where FromProdLoadTable LIKE 'ELN.CUSTOM%') then
   update set PROD_KEY='OLD_' + P.PROD_KEY
 output $action, Inserted.ProdID, deleted.ProdID, Inserted.ProdHierID, deleted.ProdHierID, Inserted.PLV, deleted.PLV
      , Inserted.IS_LLVL, deleted.IS_LLVL, Inserted.CatID, deleted.CatID, inserted.PROD_KEY, deleted.PROD_KEY
