CREATE proc [ecom].[stuff_jsb_live] as begin
--print 'not doing anything right now!' end
declare @status_msg varchar(255)

--1. prep DMT linking data
select @status_msg=convert(varchar,getdate(),126) + '--> preparing DMT linking data'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_fs') is not null drop table ecom.jsb_xrv_fs
select
	timeid
,	prodid
,	fs_val
,	fs_uni
,	fs_vol
into
	ecom.jsb_xrv_fs
from
	ecom.view_jsb_xref_data_fascia_summary

--2. create complete list of weeks and prodids for next step
select @status_msg=convert(varchar,getdate(),126) + '--> creating DMT product list over time'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_all_time_prod') is not null drop table ecom.jsb_xrv_all_time_prod

select distinct
	timeid
,	prodid
into
	ecom.jsb_xrv_all_time_prod
from
	ecom.jsb_xrv_fs

--3 create multi-value table, joined to products to give IRICodes for mapping
select @status_msg=convert(varchar,getdate(),126) + '--> preparing DMT linking data table'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_all_linkable_dmt_data') is not null drop table ecom.jsb_xrv_all_linkable_dmt_data
select
	tp.timeid
,	tp.prodid
,	p.level1
,	p.level1_Attr
,	p.proddesc
,	p.IRICode
,	prod_id = case when IRICode like '27_011%' then '00000' + right(iricode,7) else STUFF(iricode,3,1,'') end
,	fs.fs_val
,	fs.fs_uni
,	fs.fs_vol
into
	ecom.jsb_xrv_all_linkable_dmt_data
from
	ecom.jsb_xrv_all_time_prod tp
join
	(				select prodid, level1, level1_attr, proddesc, iricode from PRD.DIM_PROD_4093 where PLV=9
		union all	select prodid, level1, level1_attr, proddesc, iricode from PRD.DIM_PROD_4101 where PLV=9
	) p on p.prodid=tp.prodid
left outer join
	ecom.jsb_xrv_fs fs on fs.timeid=tp.timeid and fs.prodid=tp.prodid

--4 reduce working size of JS E-Commerce data
select @status_msg=convert(varchar,getdate(),126) + '--> create ecommerce working dataset'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_working_dataset') is not null drop table ecom.jsb_working_dataset
select
	[product]
,	[ID Number]
,	[End Date]
,	[Sales]
,	[units]
,	[Price Per Unit]
into
	ecom.jsb_working_dataset
from
	danone_uk_dmt_ops.ecom.jsb_backdata --<-- this must have been loaded using new routine...
where
	[End Date] in (select distinct top 156 [End Date] from ecom.jsb_backdata order by [End Date] desc)

--5 create data table with timeid for linking later
select @status_msg=convert(varchar,getdate(),126) + '--> add timeid to ecommerce data'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_data_forlive') is not null drop table ecom.jsb_data_forlive
select
	d.[product]
,	d.[ID Number]
,	d.[End Date]
,	value_sales			=	d.[Sales]
,	unit_sales			=	d.[units]
,	d.[Price Per Unit]
,	tx.[IRIWeek]
,	[timeid]			=	cast(tx.time_key as int)
into
	ecom.jsb_data_forlive
from
	ecom.jsb_working_dataset d 
join
	rdw.MASTER_TIME_IRI_XREF tx on tx.EndDate=d.[End Date]
order by
	tx.IRIWeek

--6 create list of ecommerce products to be able to create xrefs
select @status_msg=convert(varchar,getdate(),126) + '--> create list of ecommerce products'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_prod_list') is not null drop table ecom.jsb_prod_list
select distinct
	prod_sel	=	right(ltrim(rtrim(product)),charindex(' ',reverse(rtrim(product)))-1)
,	product		=	ltrim(rtrim(product))
into
	ecom.jsb_prod_list
from
	ecom.jsb_data_forlive

if object_id(N'ecom.jsb_products') is not null drop table ecom.jsb_products
select
	prod_sel
,	product_code	=	right('000000000000'+prod_sel,12)
,	prod_name		=	left(product,len(product)-8)
,	product
into
	ecom.jsb_products 
from
	ecom.jsb_prod_list

--7 master summary table to match by product names
select @status_msg=convert(varchar,getdate(),126) + '--> import JSB master summary table from SLDB'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_mst') is not null drop table ecom.jsb_mst
select
	mintime
,	maxtime
,	geog_id
,	prod_id
,	comm1
,	comm2
,	prod_name
into
	ecom.jsb_mst
from
	[uksqlwp09\bld1].sl_jsb.dbo.sl_master_summary_table 

--8 remove duplication from master summary table; latest files received will have latest product descriptions anyway
select @status_msg=convert(varchar,getdate(),126) + '--> remove duplicates from MST'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_mst_nodups') is not null drop table ecom.jsb_mst_nodups
select
	mintime		=	min(mintime)
,	maxtime		=	max(maxtime)
,	prod_id
,	prod_name	=	ltrim(rtrim(replace(Prod_name,'''','')))
into
	ecom.jsb_mst_nodups 
from
	ecom.jsb_mst
group by
	prod_id
,	prod_name

--9 bring across xrefs from shelf edge label tables in SL_JSB db
select @status_msg=convert(varchar,getdate(),126) + '--> import JSB shelf-edge label table from SLDB'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_prod_sel_xref') is not null
	drop table ecom.jsb_prod_sel_xref

create table
	ecom.jsb_prod_sel_xref
	(
		prod_sel		nvarchar(500)	NOT NULL
	,	product_code	nvarchar(12)	NOT NULL
	,	prod_name		nvarchar(4000)	NOT NULL
	,	product			nvarchar(500)	NOT NULL
	,	barcode			varchar(13)		NOT NULL
	,	prod_id			varchar(12)		NOT NULL
	,	wfm				int				NOT NULL
	,	wlm				int				NOT NULL
	)
on [PRIMARY]

insert into
	ecom.jsb_prod_sel_xref
execute
	[uksqlwp09\bld1].sl_jsb.dbo.sp_executesql
N'
select
	prod_sel
,	product_code
,	prod_name
,	product
into
	#prods_for_xref
from
	[win0287\bld1].danone_uk_dmt_ops.ecom.jsb_products

select
	x.prod_sel
,	x.product_code
,	x.prod_name
,	x.product
,	l.barcode
,	prod_id			=	left(l.barcode,12)
,	wfm				=	min(l.iri_week)
,	wlm				=	max(l.iri_week)
from
	shelf_edge_label l
join
	#prods_for_xref x on x.product_code=l.product_code
group by
	x.prod_sel
,	x.product_code
,	x.prod_name
,	x.product
,	l.barcode

drop table #prods_for_xref'

--10 create xref tables to use to link ecom products to multiple potential SWCode, from SEL table and from master summary table
select @status_msg=convert(varchar,getdate(),126) + '--> create ecommerce to DMT prod xref tables'
raiserror(@status_msg , 0, 1) with nowait
