GO


CREATE view [redslim].[view_master_geog_agg] as

--difference between this master_geog_agg and RDW.MASTER_GEOG_AGG is that AggGeogID uses GEOG_KEY of aggregate geography
--not the Geog_ID from RDW.MSATER_GEOG for the geog_key 

---Aggregate geographies are 1=SIG HBA/OTC, 20=Major Multiples inc BT SD & WL, 64=SIG HBA/OTC EXC IMS
with agg_geogs as (select AggGeogID = GEOG_KEY, AggGeogName = LONGNAME from RDW.MASTER_GEOG where GEOG_ID in (1,20))    

--"Sub" geographies are 11=Total Coop Societies, 30=Asda, 31=Boots, 33=Morrisons, 34=Sainsburys, 35=Superdrug,  
--                      36=Tesco and 38=Waitrose  
select
	a.AggGeogID, a.AggGeogName, GeogID = g.Geog_ID, g.GEOG_KEY, g.LONGNAME  
from
	agg_geogs a
,	RDW.MASTER_GEOG g
where
	g.GEOG_ID in (11,30,31,33,34,35,36,38)
GO
