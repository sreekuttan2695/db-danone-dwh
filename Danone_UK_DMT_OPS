,	M00001041_Unit_Price		=	SUM(M00001013_Val_Sales			) / SUM(M00001011_Unit_Sales		)
,	M00001042_Vol_Price			=	SUM(M00001012_Vol_Sales			) / SUM(M00001011_Unit_Sales		)
--into
--	tmp_latest_fact_tes_ecom_timeaggs
from
	ecom.view_current_build_fact_tes d
join
	[win0287\bld1].danone_uk_dmt_ops.rdw.master_time_agg ta on ta.WTimeID=d.TIMEID
