create view [QC].[view_CSD_time_summary] as

with alltimes as (	select * from Danone_UK_DMT_OPS.PRD.DIM_TIME	)

select
	tlvl		=	'01 wk periods'
,	mintime		=	min(TIME_KEY)
,	maxtime		=	max(TIME_KEY)
,	time_count	=	count(TIME_KEY)
from
	alltimes
where
	time_key like '001%'
union all
select
	tlvl		=	'04/05 wk periods'	
,	mintime		=	(
						select
							TIME_KEY
						from 
							alltimes
						where
							(time_key like '004%' or time_key like '005%')
						and	TIME_SORT	=	(	
												select
													min(TIME_SORT)
												from
													alltimes
												where
													time_key like '004%' or time_key like '005%'
											)
					)
,	maxtime		=	(
						select
							TIME_KEY
						from 
							alltimes
						where
							(time_key like '004%' or time_key like '005%')
						and	TIME_SORT	=	(	
												select
													max(TIME_SORT)
												from
													alltimes
												where
													time_key like '004%' or time_key like '005%'
											)
					)
,	time_count	=	count(TIME_KEY)
from
	alltimes
where
	time_key like '004%' or time_key like '005%'
union all
select
	tlvl		=	'13 wk periods'
,	mintime		=	min(TIME_KEY)
,	maxtime		=	max(TIME_KEY)
,	time_count	=	count(TIME_KEY)
from
	alltimes
where
	time_key like '013%'
union all
select
	tlvl		=	'52 wk periods'
,	mintime		=	min(TIME_KEY)
,	maxtime		=	max(TIME_KEY)
,	time_count	=	count(TIME_KEY)
from
	alltimes
where
	time_key like '052%'
union all
select
	tlvl		=	'ytd time periods'
,	mintime		=	min(TIME_KEY)
,	maxtime		=	max(TIME_KEY)
,	time_count	=	count(TIME_KEY)
from
	alltimes
where
	ytd		=	1
or	YTD_YAG	=	1
