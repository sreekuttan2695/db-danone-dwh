CREATE view [ff_ext].[view_formatted_for_xinlin_jsb_2018] as
select
	g.retailer_name
,	g.fascia
,	g.store_number
,	g.address1
,	g.posttown
,	g.postcode
,	store			=	concat
						(
							g.store_number
						,	' - '
						,	g.address1
						,	' '
						,	posttown
						,	' '
						,	postcode
						)
,	d.prod_desc
,	t.time_id
,	t.datenum_date
,	t.week_label
,	d.tot_val
,	d.eib_val
,	d.dom_val
from
	ff_ext.data_for_xinlin_2018_h1 d
join
	ff_ext.dim_time t on t.time_id=d.iri_week
join
	ff_ext.dim_geog g on g.ret_id=d.ret_id and g.store_id=d.store_id
where
	d.ret_id	=	5
--and	d.iri_week	<	2014
