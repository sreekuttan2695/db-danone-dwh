CREATE view [RDW].[DATA_PROCESSING_COMPLETE] as

select 'Latest Tape II data' DataProcessItem,
  case when (select COUNT(0) from RDW.LOAD_MASTER)
           =(select SUM(CONVERT(int,CSD_VIEWS_CREATED)) from RDW.LOAD_MASTER)
         then 1 else 0 end ProcessCompleted
union all
select 'Latest OBS data' DataProcessItem,
  case when (select count(0) from RDW.NON_IRI_DATA_LOAD_MASTER where NON_IRI_DATA_TYPE='OBS')
           =(select sum(data_processed) from RDW.NON_IRI_DATA_LOAD_MASTER where NON_IRI_DATA_TYPE='OBS')
         then 1 else 0 end ProcessCompleted
union all
select 'Latest IMS data' DataProcessItem,
  case when (select count(0) from RDW.NON_IRI_DATA_LOAD_MASTER where NON_IRI_DATA_TYPE like 'IMS%')
           =(select sum(data_processed) from RDW.NON_IRI_DATA_LOAD_MASTER where NON_IRI_DATA_TYPE like 'IMS%')
         then 1 else 0 end ProcessCompleted
union all
select 'Automatic CSD Build' DataProcessItem, AutoCSDBuild
  from RDW.PAUSE_AFTER_DATA_PROCESSING

