      , deleted.L4Name, Inserted.L5Name, deleted.L5Name, Inserted.L6Name, deleted.L6Name, Inserted.L7Name, deleted.L7Name
      , Inserted.L8Name, deleted.L8Name, Inserted.L9Name, deleted.L9Name, Inserted.L10Name, deleted.L10Name)
 as Changes (ChangeAction, NEW_ProdID, OLD_ProdID, NEW_ProdHierID, OLD_ProdHierID, NEW_PLV, OLD_PLV, NEW_IS_LLVL, OLD_IS_LLVL
           , NEW_CatID, OLD_CatID, NEW_PROD_KEY, OLD_PROD_KEY, NEW_L1Name, OLD_L1Name, NEW_L2Name, OLD_L2Name, NEW_L3Name, OLD_L3Name
