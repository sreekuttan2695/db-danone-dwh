-- =============================================
-- Author:		Adeel Abid
-- Create date: 02/09/2021
-- Description:	Create final tesco online data table with all data associated based on EANs
-- =============================================
CREATE PROCEDURE [ma_cff].[sp_update_tes_ecom_data_tbl]
	
AS
BEGIN
	--Referencing TPNs and EANs with tesco agg data
	select
	    t.tpn
	  , t.ean
	  , d.*
	into
	#tmptbl1
	from
	    dbo.tes_agg_data_by_geog d
	    join
	        rdw.ecom_tes_prod_master_tpn_ean_xref t
	        on
	            d.prod_id = left(t.ean,12)
	order by
	    d.time_id
	  , t.tpn
	--select * from #tmptbl1
	
	
	--Summing up data by TPNs
	select
	    tpn
	  , time_id
	  , sum(v_value) as valsales
	  , sum(v_unit)  as unitsales
	into
	    #tmptbl2
	from
	    #tmptbl1
	group by
	    tpn
	  , time_id
	--select * from #tmptbl2
	
	
	--Calculating %age sale of each EAN
	select
	    t1.tpn
	  , t1.ean
	  , t1.prod_id
	  , t1.time_id
	  , cast((ISNULL(t1.v_value / NULLIF(t2.valsales,0),0)) as decimal(18,2)) as pc_val
	into
	    #tmptbl3
	from
	    #tmptbl1 t1
	    join
	        #tmptbl2 t2
	        on
	            t1.tpn         = t2.tpn
	            and t1.time_id = t2.time_id
	--select * from #tmptbl3
	
	
	--Referencing TPNs and EANs with tesco online data provided by Danone
	select
	    pd.tpn
	  , pd.Sales_units
	  , pd.Sales_value * 100 as Sales_value
	  , iriweek
	into
	    #tmptbl4
	from
	    ecom.tesco_all_backdata_pivot pd
	    join
	        [uksqlwp09\bld1].sl_time.dbo.sl_week t
	        on
	            convert(datetime,pd.sat_week_end_date) = t.datestamp
	--select * from #tmptbl4
	
	
	--Distributing Sales within the EANs and excluising 0 sales records
	select
	    t3.tpn
	  , t3.ean
	  , t3.prod_id
	  , t4.iriweek
	  , cast(sales_units * (pc_val) as decimal(18,0)) as sales_units
	  , cast(sales_value * (pc_val) as decimal(18,0)) as sales_value
	into
	    #tmptbl5
	from
	    #tmptbl3 t3
	    join
	        #tmptbl4 t4
	        on
	            t3.tpn         = t4.TPN
	            and t3.time_id = t4.iriweek
	where
	    cast(sales_units * (pc_val) as decimal(18,0)) <> 0
	order by
	    iriweek
	  , tpn
	--select * from #tmptbl5
	
	
	--Taking max item_dim_key for product based on prodkey
	select
	    max(item_dim_key) item_dim_key
	  , prodkey
	into
	    #tmptbl6
	from
	    ma_monetdb.view_item_identifiers
	group by
	    prodkey
	--select * from #tmptbl6
	
	
	--final query which will have iricode from mdm and correct sales based on the percentage records
	DROP TABLE IF EXISTS prd.tes_ecom_data
	select
	    i.item_dim_key
	  , d.tpn
	  , barcode = convert(varchar(15),convert(bigint,i.barcode)) 
	  , upc = convert(varchar(15),convert(bigint,i.upc))
	  , i.prodkey
	  , i.iricode13
	  , i.iricode14
	  , geogid = '00001'
	  , d.iriweek
	  , d.sales_units
	  , d.sales_value
	  , unit_price = cast((d.sales_value / d.sales_units) as decimal(18,0))
	  into prd.tes_ecom_data
	from
	    #tmptbl5 d
	    join
	        #tmptbl6 p
	        on
	            d.prod_id = p.prodkey
	    join
	        ma_monetdb.view_item_identifiers i
	        on
	            p.item_dim_key = i.item_dim_key
	order by
	    d.iriweek
	
	--Dropping temp tables creatd during the process
	drop table #tmptbl1
	drop table #tmptbl2
	drop table #tmptbl3
	drop table #tmptbl4
	drop table #tmptbl5
	drop table #tmptbl6
END
GO
