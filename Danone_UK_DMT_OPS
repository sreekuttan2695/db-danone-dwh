-- =============================================
-- Author:		Chris Westgate
-- Create date: 8 January 2020
-- Description:	Returns a string containing bcp command to
--				- select from table/view defined by @tbl_schema.@tbl_name
--				- output to file defined by @op_file_path + @op_file_name
--				- including column headers
--				- separated by character @sep
--				String can then be executed using xp_cmdshell
-- =============================================
--/*
create function [ff_ext].[bup_ufn_bcp_cmd]
(	
	@tbl_schema				varchar(255)
,	@tbl_name				varchar(255)
,	@op_file_name			varchar(255)	=	null
,	@op_file_path			varchar(255)	=	'D:\projects\Danone\Output_Files\' --(select '\\' + convert(nvarchar(max),SERVERPROPERTY('machinename')) + '\PROJECTS\Danone\output_files\')
,	@order_ordinal_string	varchar(255)	=	',1,2'	-- Note preceding comma required in string
,	@sep					varchar(1)		=	','
)
RETURNS TABLE 
AS
RETURN 
--*/	declare @tbl_schema				varchar(255)	=	'ff_ext'							/*
--*/	declare @tbl_name				varchar(255)	=	'view_formatted_for_xinlin'			/*
--*/	declare @op_file_name			varchar(255)	=	null								/*
--*/	declare @op_file_path			varchar(255)	=	'D:\projects\Danone\Output_Files\'	/*
--*/	declare @order_ordinal_string	varchar(255)	=	',1,8,9'							/*
--*/	declare @sep					varchar(1)		=	',';

with opcols as (select * from information_schema.columns where table_schema=@tbl_schema and table_name=@tbl_name)
-- select * from opcols /*
select
	bcp_cmd	=	
	'bcp "select '
+	stuff
	(
		(
		select
			', ' + quotename(column_name)
		from
			opcols
		for
			xml path('')
		,	type
		).value('(./text())[1]','VARCHAR(MAX)')
	,1,2,''
	)
+	' from (select cn=1'
+	(
	select
		', ' + quotename(column_name) + '=''''' + column_name + ''''''
	from
		opcols
	for
		xml path('')
	,	type
	).value('(./text())[1]','VARCHAR(MAX)')
+	' union all select cn=2'
+	(
	select
		', ' + quotename(column_name) + '=cast(' + quotename(column_name) + ' as varchar(255))'
	from
		opcols
	for
		xml path('')
	,	type
	).value('(./text())[1]','VARCHAR(MAX)')
+	' from ' + db_name() + '.' + @tbl_schema + '.' + @tbl_name + ') a order by cn' 
+	@order_ordinal_string
+	'" queryout "' + @op_file_path + isnull(@op_file_name,'ufn_bcp_cmd_test_output.csv')
+	'" /c /t"' + @sep + '" /T /S' + @@SERVERNAME
