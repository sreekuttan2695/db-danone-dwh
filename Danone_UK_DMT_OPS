CREATE view [QC].[TAPEII_MEASURE_POPULATION_QUERY_VIEW] as

with MT as (select MAX(right(TIME_KEY,6)) MAXT from RDW.MASTER_TIME)

select
 'begin transaction insert into [QC].[TAPEII_MEASURE_POPULATION_DENORM] ' 
+ 'select ProdID, ' + substring(p.TABLE_NAME, 2,4) + ' Catid, '''
+ SUBSTRING(p.TABLE_NAME,7,LEN(p.TABLE_NAME)-13)  + ''' TapeIIGeogName, '''
+ RIGHT(p.TABLE_NAME,6) + ''' TimeLevel' + (select ', case when [' + COLUMN_NAME + '] is null then 0 else 1 end [' + COLUMN_NAME + ']' 
                                            from INFORMATION_SCHEMA.COLUMNS c 
                                            where c.table_schema=p.table_schema and c.table_name=p.table_name and c.COLUMN_NAME like 'M%' 
                                            order by ORDINAL_POSITION for xml path ('')
                                            ) + ' from ' + p.TABLE_SCHEMA + '.' + P.TABLE_NAME
+ ' d where d.TIMEID=' + convert(varchar,convert(int,left(right(p.TABLE_NAME,6),2))) + MT.MAXT + ' and d.PLV=1 commit' QC_STMT
from information_schema.views p,MT where p.table_schema='PRD' and p.table_name like 'C%' and p.table_name not like 'CFACT%'


