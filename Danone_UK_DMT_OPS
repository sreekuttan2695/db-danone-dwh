CREATE   PROCEDURE [iqvia].[usp_bcp_queryout]
/* =============================================================================
   Purpose : Run bcp queryout through xp_cmdshell and fail loudly unless bcp
             reports a copied-row count. Replaces unchecked xp_cmdshell calls.
   Inputs  : @query     - single-line SELECT, no double quotes (cmd-line safe)
             @file_full - full path of the output file (UNC or local)
             @server    - instance for bcp -S; NULL = @@SERVERNAME (env-neutral)
   Outputs : @rows_out  - rows written, parsed from bcp output
             THROW 50120-50122 on invalid input or bcp failure
   Change  : 2026-09-23  initial version
   ============================================================================= */
    @query     nvarchar(3000),
    @file_full nvarchar(400),
    @server    sysname = NULL,
    @rows_out  int OUTPUT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @cmd varchar(8000);
    DECLARE @rc  int;
    DECLARE @msg nvarchar(2048);
    DECLARE @out TABLE (line_no int IDENTITY(1, 1) NOT NULL, line nvarchar(4000) NULL);

    SET @rows_out = NULL;

    IF @query IS NULL OR @file_full IS NULL
        THROW 50120, N'usp_bcp_queryout: @query and @file_full are required.', 1;

    IF CHARINDEX(N'"', @query) > 0
       OR CHARINDEX(N'"', @file_full) > 0
       OR CHARINDEX(NCHAR(13), @query) > 0
       OR CHARINDEX(NCHAR(10), @query) > 0
        THROW 50121, N'usp_bcp_queryout: @query and @file_full must be single-line and contain no double quotes.', 1;

    SET @cmd = CONVERT(varchar(8000),
                   CONCAT(N'bcp "', @query, N'" queryout "', @file_full,
                          N'" -c -T -S "', COALESCE(@server, @@SERVERNAME), N'"'));

    INSERT INTO @out (line)
    EXEC @rc = master.dbo.xp_cmdshell @cmd;

    SELECT @rows_out = MAX(TRY_CONVERT(int, LEFT(LTRIM(o.line), CHARINDEX(N' ', LTRIM(o.line) + N' ') - 1)))
    FROM @out AS o
    WHERE o.line LIKE N'%rows copied%';

    IF ISNULL(@rc, 1) <> 0 OR @rows_out IS NULL
    BEGIN
        SET @msg = LEFT(CONCAT(N'usp_bcp_queryout failed (xp_cmdshell rc=', @rc, N'). bcp output:',
                               (SELECT N' | ' + o.line
                                FROM @out AS o
                                WHERE o.line IS NOT NULL
                                ORDER BY o.line_no
                                FOR XML PATH(''), TYPE).value('.', 'nvarchar(max)')), 2048);
        THROW 50122, @msg, 1;
    END;
END;
GO
