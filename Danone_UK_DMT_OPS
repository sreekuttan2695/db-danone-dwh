 from rdw.MASTER_PROD_XREF x
full outer join tst.MASTER_PROD_XREF t on t.CatID=x.CatID and t.PROD_KEY=x.PROD_KEY
order by coalesce(x.catid, t.catid), coalesce(x.PROD_KEY,t.prod_key)

select * from rdw.master_prod_xref where SWCODE='505159400853'
select * from tst.master_prod_xref where SWCODE='505159400853'
--*/
