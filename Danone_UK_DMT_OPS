-- =============================================
-- Author:		Chris Westgate
-- Create date: 4 Nov 2020
-- Description:	Returns latest integrated IQVIA dataset from the most recently-built CSD DB
-- =============================================
CREATE FUNCTION [ma_mdm].[NOT_USEDufn_eib_export_for_monetdb] 
(
	-- Add the parameters for the function here
	@force_db	int	=	null
)
RETURNS 
@eib_dataset TABLE 
(
	-- Add the column definitions for the TABLE variable here
	DataType_ID	int
,	vn_dim_key	int
,	it_dim_key	int
,	tm_dim_key	int
,	ValueSales	int
,	UnitSales	int
,	VolumeSales	int
)
AS
BEGIN
	-- Fill the table variable with the rows for your result set
	if @force_db=1 or (select top 1 csd_database from qc.view_csd_db_build_dates order by build_date desc) = 'Danone_UK_DMT_CSD_DB1' begin
		with
			geog_xref as
			(
			select
				geogid
			,	geogl1name
			,	vn_dim_key	=	case geogid
									when 11 then 715694
									when 20 then 715682
									when 30 then 715933
									when 31 then 715935
									when 33 then 715937
									when 34 then 715938
									when 35 then 715941
									when 36 then 715942
									when 38 then 715947
								else
									null --not possible
								end
			from
				Danone_UK_DMT_CSD_DB1.st.dim_geog
			where
				geogid in (11, 20, 30, 31, 33, 34, 35, 36, 38)
			)
		insert into
			@eib_dataset
		select distinct 
			DataType_ID		=	cast(2 as int)
		,	g.vn_dim_key
		,	it_dim_key		=	cast(x.item_dim_key as int)
		,	tm_dim_key		=	cast(t.IRIWeek as int)
		,	ValueSales		=	cast(round(eib_data.OBSValue*100,0) as int)
		,	UnitSales		=	cast(round(eib_data.OBSUnit,0) as int)
		,	VolumeSales		=	cast(round(eib_data.OBSVolume*100,0) as int)
		from
			Danone_UK_DMT_CSD_DB1.st.fact_obs eib_data
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=eib_data.TIMEID
		join
			geog_xref g on g.geogid=eib_data.geogid
		join
			ma_mdm.view_xref_dmt_prodid_to_ma_item_key x on x.prodid=eib_data.PRODID
		where
			len(eib_data.timeid)	=	7
		and eib_data.timeid			like '1%'
	end
	else begin
		with
			geog_xref as
			(
			select
				geogid
			,	geogl1name
			,	vn_dim_key	=	case geogid
									when 11 then 715694
									when 20 then 715682
									when 30 then 715933
									when 31 then 715935
									when 33 then 715937
									when 34 then 715938
									when 35 then 715941
									when 36 then 715942
									when 38 then 715947
								else
									null --not possible
								end
			from
				Danone_UK_DMT_CSD_DB2.st.dim_geog
			where
				geogid in (11, 20, 30, 31, 33, 34, 35, 36, 38)
			)
		insert into
			@eib_dataset
		select distinct 
			DataType_ID		=	cast(2 as int)
		,	g.vn_dim_key
		,	it_dim_key		=	cast(x.item_dim_key as int)
		,	tm_dim_key		=	cast(t.IRIWeek as int)
		,	ValueSales		=	cast(round(eib_data.OBSValue*100,0) as int)
		,	UnitSales		=	cast(round(eib_data.OBSUnit,0) as int)
		,	VolumeSales		=	cast(round(eib_data.OBSVolume*100,0) as int)
		from
			Danone_UK_DMT_CSD_DB2.st.fact_obs eib_data
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=eib_data.TIMEID
		join
			geog_xref g on g.geogid=eib_data.geogid
		join
			ma_mdm.view_xref_dmt_prodid_to_ma_item_key x on x.prodid=eib_data.PRODID
		where
			len(eib_data.timeid)	=	7
		and eib_data.timeid			like '1%'
	end

	RETURN 
END
