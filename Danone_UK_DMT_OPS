---Aggregate geographies are 1=SIG HBA/OTC, 20=Major Multiples inc BT SD & WL, 64=SIG HBA/OTC EXC IMS
with AggGeogs as (select GEOG_ID AggGeogID, LONGNAME AggGeogName from RDW.MASTER_GEOG where GEOG_ID in (1,20,64))

--"Sub" geographies are 11=Total Coop Societies, 30=Asda, 31=Boots, 33=Morrisons, 34=Sainsburys, 35=Superdrug,
--                      36=Tesco and 38=Waitrose
select A.AggGeogID, A.AggGeogName, G.Geog_ID GeogID, G.GEOG_KEY, G.LONGNAME
from AggGeogs A, RDW.MASTER_GEOG G where G.GEOG_ID in (11,30,31,33,34,35,36,38)
