-- =============================================
-- Author:		Adeel Abid
-- Create date: 01/09/2021
-- Description:	Update Tesco base tables. i.e. aggregated by gerog, master table, catdesc table 
-- =============================================
CREATE
PROCEDURE [ma_cff].[sp_update_tes_base_tbls]
    --EXEC [ma_cff].[sp_update_tes_base_tbls]
AS
BEGIN
    -- SET NOCOUNT ON added to prevent extra result sets from
    -- interfering with SELECT statements.
    SET NOCOUNT ON;
    DECLARE
        @maxweek as int;
        DECLARE
            @minweek as int;
            SELECT
                @maxweek = max(source)
            from
                [uksqlwp09\bld1].META.dbo.updated
            where
                ret = 'tes' SET @minweek = @maxweek -260
                --SET @maxweek = NULL
                IF @maxweek       = 0
                OR @maxweek IS NULL RAISERROR (N'@maxweek parameter cannot be null, please investigate.', -- Message text.
                16,                                                                                       -- Severity,
                1                                                                                         -- State,
                )
            ; -- Second argument.
        ELSE
            --Insert latest week data into the aggregated table
            insert into dbo.tes_agg_data_by_geog
            select *
            from
                [uksqlwp09\bld1].[sl_tes].dbo.sl_base_data_ta d1
            where
                --time_id = @maxweek and
                time_id not in
                (
                    select distinct
                        time_id
                    from
                        dbo.tes_agg_data_by_geog d2
                )


            --Maintaining the history of 5 years data
            delete
            from
                dbo.tes_agg_data_by_geog
            where
                time_id <= @minweek


                --updating tesco catdesc summary table
                raiserror('updating tesco catdesc summary table (main_sldb.sl_tes.dbo.sl_catdesc_summary_table -> ma_cff.tes_catdesc)',0,1) with nowait
            truncate table ma_cff.tes_catdesc
            insert into ma_cff.tes_catdesc
            select *
            from
                main_sldb.sl_tes.dbo.sl_catdesc_summary_table


                --updating tesco master summary table
                raiserror('updating tesco master summary table (main_sldb.sl_tes.dbo.sl_master_summary_table -> ma_cff.tes_mst)',0,1) with nowait
            truncate table ma_cff.tes_mst
            insert into ma_cff.tes_mst
            select *
            from
                main_sldb.sl_tes.dbo.sl_master_summary_table
        END
GO
