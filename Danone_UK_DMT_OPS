create FUNCTION [RDW].[bup_MeasureSelectList] 
(
	-- Add the parameters for the function here
	@LoadTblToCompare varchar(200)
)
RETURNS varchar(max)
AS
BEGIN
	-- Declare the return variable here
	DECLARE @MeasString varchar(max)

	SELECT TOP 1 @LoadTblToCompare=ISNULL(@LoadTblToCompare,MOVE_LOAD_TABLE_NAME) from RDW.LOAD_MASTER WHERE MOVE_LOADED=1 order by MEASURE_COUNT desc
	-- Add the T-SQL statements to compute the return value here
	SELECT @MeasString = (SELECT ', ' + CASE
                          WHEN CT.COLUMN_NAME is null THEN 'NULL as [' ELSE 'D.[' END + MT.COLUMN_NAME + ']'
                          FROM 
                          (SELECT COLUMN_NAME, ORDINAL_POSITION from INFORMATION_SCHEMA.COLUMNS WHERE COLUMN_NAME LIKE 'M%'
                           and TABLE_NAME = (select TOP 1 TABLE_NAME
                                             from INFORMATION_SCHEMA.COLUMNS 
                                             where TABLE_NAME like 'LOAD_TBL_FACT%' and COLUMN_NAME like 'M%'
                                             group by TABLE_NAME order by count(COLUMN_NAME) desc)) MT
                          LEFT OUTER JOIN
                          (SELECT COLUMN_NAME from INFORMATION_SCHEMA.COLUMNS
                           WHERE TABLE_NAME=@LoadTblToCompare and COLUMN_NAME like 'M%') CT on CT.COLUMN_NAME=MT.COLUMN_NAME
                           ORDER BY MT.ORDINAL_POSITION FOR XML PATH (''))

	-- Return the result of the function
	RETURN @MeasString

END

