	p.product
,	mintime		=	m.mintime
,	maxtime		=	m.maxtime
,	prod_id		=	m.prod_id
,	prod_name	=	m.prod_name
from
	ecom.jsb_products p --802 rows
join
	ecom.jsb_mst_nodups m on m.Prod_name=p.prod_name --825 rows
where p.product in (select product from ecom.jsb_products
					except
					select product from ecom.jsb_prod_sel_xref)
union all
select
	product
,	wfm
,	wlm
,	prod_id
,	prod_name
from
	ecom.jsb_prod_sel_xref

