/****** Object:  StoredProcedure [STG].[sp_create_assosia_stg_tbl]    Script Date: 30/09/2026 07:46:40 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
-- =============================================
-- Author:		Adeel Abid
-- Create date: 13/12/2021
-- Description:	This Procedure take values from Meta table about columns and create stg the table, also insert data into it from Raw data table
-- =============================================
CREATE PROCEDURE [STG].[sp_create_assosia_stg_tbl]
AS
BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;
	DECLARE @cols	AS NVARCHAR(MAX);
	DECLARE @query  AS NVARCHAR(MAX) 
	DECLARE @dsql	AS NVARCHAR(MAX) = N''
	DECLARE @New_Col_info table
	(	Orig_col_name	varchar(50)
	,	New_Col_name	varchar(50)
	,	Col_data_type	varchar(50)
	)
	
	select @cols = STUFF((SELECT ',' + QUOTENAME(COLUMN_NAME)
	from
		INFORMATION_SCHEMA.COLUMNS
	where
		table_schema		=	'dbo'
	and	table_name			=	'assosia_rtlr_meta'
	--and ordinal_position	>	5
	and	ordinal_position	between	1	and	12
	order by
		ordinal_position
		FOR XML PATH(''), TYPE
	            ).value('.', 'NVARCHAR(MAX)') 
	        ,1,1,'')
	
	set @query = 'select 
	         Orig_Col_Name,
	         replace (New_Col_Name,''COLUMN_NAMES:'','''') as New_Column_Name,
			 ''VARCHAR (500)'' as Col_Data_Type
	     from (select * from dbo.assosia_rtlr_meta where [column 0] like ''COLUMN_NAMES%'') a
	     unpivot
	     (
	        New_Col_Name
	        for Orig_Col_Name in ('+@cols+')
	     ) u'
	insert into @New_Col_info exec sp_executesql @query;
	
	
	IF OBJECT_ID(N'stg.assosia_rtlr_data', N'U') IS NOT NULL  
	   DROP TABLE [stg].[assosia_rtlr_data];  
	
	
	SELECT @dsql += New_Col_name + ' ' + 
	       [Col_data_type] + ','        
	FROM @New_Col_info
	
	SELECT @dsql = 'CREATE TABLE stg.assosia_rtlr_data (' + LEFT(@dsql, LEN(@dsql) - 1) + ')'
	EXEC sp_executesql @dsql

	Insert into stg.assosia_rtlr_data
	Select * from [raw].assosia_rtlr_data
END
GO
