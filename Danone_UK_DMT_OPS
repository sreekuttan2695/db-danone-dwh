create view [t2_output].[view_desc_3] as
--/*
with
	desc_head
as
(
	select
		rn			=	1
	,	t2_output	=	'4093ST00BABY MILK             Disc SchCOUNT                                                                                                                                                                                                   '
)
-- select * from desc_head	/*
,	time_desc
as
(
	select
		rn			=	row_number() over (order by cast(right(time_key,6) as int))
	,	t2_output	=	concat(TIME_CC,'01',TIME_KEY,SPACE(31),LONGNAME,'                                                                                                                                                                ')
	from
		STG.LOAD_TBL_TIME_3
	where
		LEFT(time_key,3) in ('004','005')
)
-- select * from time_desc	/*
,	geog_desc
as
(
	select
		rn			=	1
	,	t2_output	=	concat(geog_cc,'02',geog_key,GEOG_NAME,'00')
	from
		STG.LOAD_TBL_GEOG_3
)
-- select * from geog_desc	/*
,	kcat_desc
as
(
	select
		rn			=	1
	,	t2_output	=	'4093ST0300000                                   FOOD                                    F                                                                                                                                                     '
)
-- select * from kcat_desc	/*
,	meas_desc
as
(
	select
		rn			=	row_number() over (order by meas_id)
	,	t2_output	=	CONCAT(meas_cc,'04',MEAS_KEY,LONGNAME,right('000' + cast(row_number() over (order by meas_id) as varchar),3),right(space(11)+rtrim(DATATYPE),11))
	from
		[win0377\dev1].dan_uk_gt1_ops.stg.LOAD_TBL_MEAS_3
	where
		MEAS_KEY in ('00001011','00001013','00001012','00008990','00002020','00003010','00001041','00001042')
