-- =============================================
-- Author:		Chris Westgate
-- Create date: 28 Sep 2020
-- Description:	Returns one week of Tesco (and originally Sainsbury) data from the E-Commerce back data sent by Danone,
--				with formatting for Common Format File output and Extended Common Format file output
-- Change:		27 Nov 2020 ueacw - per request from Dave Russell, no longer include JS data from IRI week 2151 onwards (Danone purchased data from IRI)
-- Change:		10 Dec 2020 ueacw - temporarily include rolled forward JS data because of gap between Danone's purchase and IRI's ability to fulfil in MA
-- Change:		Jan 2021 ueacw	  - instead of rolled forward Danone-supplied JS data, bring through JS online data from Tape 2 files for weeks 2151 onwards
-- Change:		Jan 2021 ueacw    - MA is populated with JS Online data directly from the warehouse, prevent JS data coming through completely
-- =============================================
--/*
CREATE function [ma_cff].[ufn_1week_sales_data_CW] 
(	
	-- Add the parameters for the function here
	@iriweek int 
)
RETURNS TABLE 
AS
RETURN
(
--*/	declare	@iriweek	int	=	2152;
--geog_id 82 = Tesco Online; geog_id 84 = Sainsbury Online
with
	prod_ids as
	(
		select
			prodid
		,	iricode	=	l10name
		,	swcode	=	case --if these are Sainsbury or Tesco PL codes then remove the 27 coding
							when
								l10name like '27_011%' or l10name like '27_052%' or l10name like '27_008%' 
							then
								concat('00000',right(l10name,7))
						else
							stuff(l10name,3,1,'')
						end
		,	prodkey	=	stuff(l10name,3,1,'')
		 from
			rdw.master_prod
		where
			catid			in	(4093,4101)
		and	prodhierid		in	(1,3)
		and	is_llvl			=	1
		and	left(l10name,1)	<>	'I'
	)
,	time_ids as
	(
		select
			iriweek	=
				case
					when exists	(select 1 from rdw.master_time_iri_xref where iriweek=@iriweek)
						then
						(select iriweek from rdw.master_time_iri_xref where iriweek=@iriweek)
					else
						(select max(iriweek) from rdw.master_time_iri_xref)
					end
		,	tkey	=
				case
					when exists (select 1 from rdw.master_time_iri_xref where iriweek=@iriweek)
						then
						(select cast(time_key as int) from rdw.master_time_iri_xref where iriweek=@iriweek)
					else
						(select cast(max(time_key) as int) from rdw.master_time_iri_xref)
				end
	)
-- select * from prod_ids /* 4212 rows
,	tes_ecom as
	(
		select distinct
			d.geogid
		,	ret				=	'tes'
		,	cff_geogid		=	'00001'
		,	d.timeid
		,	d.prodid
		,	p.iricode
		,	p.prodkey
		,	p.swcode
		,	unit_sales		=	d.M00001011_Unit_Sales
		,	val_sales		=	d.M00001013_Val_Sales	*	100										--	to show values in pence
		,	unit_price		=	(d.M00001013_Val_Sales	*	100) / (d.M00001011_Unit_Sales*1.00)	--	force unit price calc as this will be done in fastload process
		from
			[ecom].[view_current_build_fact_tes] d
		join
			prod_ids p on p.prodid=d.prodid
		where
			d.geogid		=	82
		and timeid			=	(select tkey from time_ids)
	)
-- select * from tes_ecom /*
,	jsb_ecom as
	(
		select distinct
			d.geogid
		,	ret			=	'jsb'
		,	cff_geogid	=	'00002'
		,	d.timeid
		,	d.prodid
		,	p.iricode
		,	p.prodkey
		,	p.swcode
		,	unit_sales	=	d.M00001011_Unit_Sales
		,	val_sales	=	d.M00001013_Val_Sales	*	100										--	to show values in pence
		,	unit_price	=	(d.M00001013_Val_Sales	*	100) / (d.M00001011_Unit_Sales*1.00)	--	force unit price calc as this will be done in fastload process
		from
			[ecom].[view_current_build_fact_sai] d
		join
			prod_ids p on p.prodid=d.prodid
		where
			d.geogid		=	84
		and timeid			=	(select tkey from time_ids)
		and	timeid			<	1201116	-- NB time restriction for week 2151 (which has time key 1201115 so will be included) was put in
										-- here on 27 Nov 2020 because Danone will purchase JS online data from IRI from week 2151
										-- onwards and data should not be included in any weeks where it is not required, i.e. from week
										-- 2151 onwards - in reality the data may not exist in these tables beyond this point but there
										-- should still be a restriction here
		and	@iriweek		<	2151
	)
-- select * from jsb_ecom /*
--,	jsb_temp_rollforward_ecom as --this name will change in future planned change
--	(
--		select distinct
--			d.geogid
--		,	ret			=	'jsb'
--		,	cff_geogid	=	'00002'
--		,	d.timeid
--		,	d.prodid
--		,	p.iricode
--		,	p.prodkey
--		,	p.swcode
--		,	unit_sales	=	d.M00001011_Unit_Sales
--		,	val_sales	=	d.M00001013_Val_Sales	*	100										--	to show values in pence
--		,	unit_price	=	(d.M00001013_Val_Sales	*	100) / (d.M00001011_Unit_Sales*1.00)	--	force unit price calc as this will be done in fastload process
--		from
--			[ecom].[view_current_build_fact_sai] d --This will change to reflect tape 2 JS online data source in future planned change
--		join
--			prod_ids p on p.prodid=d.prodid
--		where
--			d.geogid		=	84
--		and timeid			=	(select tkey from time_ids)
--		and	@iriweek		>	2150 --prevents double-presentation in weeks 2150 and below
--		--restriction below will be implemented once bringing data through from tape 2 files
--		--and	timeid			>	1201116	-- NB time restriction for week 2151 (which has time key 1201115 so will be included) was put in
--		--								-- here on 27 Nov 2020 because Danone will purchase JS online data from IRI from week 2151
--		--								-- onwards and data should not be included in any weeks where it is not required, i.e. from week
--		--								-- 2151 onwards - in reality the data may not exist in these tables beyond this point but there
--		--								-- should still be a restriction here
--	)
-- select * from jsb_temp_rollforward_ecom /*

select
	ae.geogid
,	ae.ret
,	ae.cff_geogid
,	ae.timeid
,	ae.prodid
,	ae.iricode
,	ae.prodkey
,	barcode			=	bc.bc_13
,	ae.swcode
,	ae.unit_sales
,	ae.val_sales
,	ae.unit_price
,	iriweek			=	case when (select iriweek from time_ids) = @iriweek then cast(@iriweek as varchar) else concat('No data for requested week ',@iriweek,'; presenting week ',(select iriweek from time_ids),' for iriweek ',@iriweek) end
,	cff_output		=	concat
						(
							bc.bc_13
						,	ae.cff_geogid
						,	'+'
						,	right(concat('00000000000',round(ae.unit_sales,0)),11)
						,	'+'
						,	right(concat('00000000000',convert(nvarchar,convert(bigint,round(ae.val_sales,0)))),11)
						,	'+'
						,	right(concat('00000000000',convert(nvarchar,convert(bigint,round(ae.unit_price,0)))),11)
						)
,	cff_filename	=	concat('infoscan.',@iriweek,'.sl1.SALES')
,	ecf_output		=	concat
						(
							stuff(ae.iricode,3,0,'0')								,	char(9)
						,	ae.cff_geogid											,	char(9)
						,	''														,	char(9)	-- Day - empty as this is weekly
						,	''														,	char(9) -- Transaction code - empty
						,	round(ae.unit_sales,0)									,	char(9)
						,	convert(nvarchar,convert(bigint,round(ae.val_sales,0)))	,	char(9)
						,	convert(nvarchar,convert(bigint,round(ae.unit_price,0)))
						)
,	ecf_filename	=	concat('common.uk.',@iriweek,'.sl1.WEEKLY')
from
(
	--select * from jsb_temp_rollforward_ecom
	--union all
	select * from jsb_ecom
	union all
	select * from tes_ecom
) ae
cross apply
	get_bc(ae.prodkey) bc	-- barcode inc 27 code used for 13-digit code in cff MASTER and SALES files at David Russell's request
)
--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/--*/
GO
