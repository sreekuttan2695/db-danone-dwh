							JOIN RDW.MASTER_PROD_IMS_LKUP lkp on P.IMS_Pack = lkp.prod_desc
							--only retrieve products we care about - that is, not ones which we automatically include
							where p.Category not in (select category from rdw.excluded_IMS_categories)
							)
--select * from NewIntegratedProds /*
,    FactDataForIMSNIP as (select np.*, FACT_MONTH,
							UNITS = cast(cast(REPLACE(REPLACE(UNITS, '#N/A', ''), '-', '') as float) as int) 
						   ,ValSales = cast(cast(REPLACE(REPLACE(VALUE_STG, '#N/A', ''), '-', '') as float) as int) 
						   ,VOLUME = cast(cast(REPLACE(REPLACE(VOLUME, '#N/A', ''), '-', '') as float) as int) 
						   ,NET_WEIGHT = cast(cast(REPLACE(REPLACE(NET_WEIGHT, '#N/A', ''), '-', '') as float) as int) 
						 from IMS.FACT_UK f
                            JOIN NewIntegratedProds np on f.IMS_Pack = np.IMS_Pack)  
--select * from FactDataForIMSNIP /*  
,    FactsWithoutZeroes as (select * from FactDataForIMSNIP where UNITS <> 0 and CONVERT(int, cast(ValSales as float)) <> 0)  
-- select distinct IMS_Pack from FactsWithoutZeroes /*  
,    Potential_MapProds as (select Prod_Source, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack, EAN, IRICode14  
       , earliestsale = 'MTH' + convert(varchar , MIN(convert(int,right(FACT_MONTH,2) + SUBSTRING(FACT_MONTH,4,2))) )  
