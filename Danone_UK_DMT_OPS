-- =============================================
-- Author:		Chris Westgate
-- Create date: 8 January 2020
-- Description:	Returns a string containing bcp command to
--				- select from table/view defined by @tbl_schema.@tbl_name
--				- output to file defined by @op_file_path + @op_file_name
--				- including column headers
--				- separated by character @sep
--				String can then be executed using xp_cmdshell
--
-- Update date:	17 Nov 2020
-- Author:		Chris Westgate
-- Description:	@to_copy_paste parameter added, default of 'N'
--				parameter ensures correct number of single quotes are added
--				depending on whether the string output by this function is
--				to be copied & pasted into SSMS (@to_copy_paste='Y'), or
--				to be executed programatically (@to_copy_paste='N', default)
--				Also altered implicit concatenation using '+' to explicit
--				concatenation using concat function EXCEPT for adding the ordinal string:
--				this allows a NULL order by clause rather than making a requirement to
--				stipulate an order clause other than a default (col1, col2)
--
-- Update date:	08 Mar 2021
-- Author:		Chris Westgate
-- Description:	@restrict parameter added, default of null
--				If specified with a number will restrict output to top N lines of output
--
-- =============================================
--/*
CREATE function [ff_ext].[ufn_bcp_cmd]
(	
	@tbl_schema				varchar(255)
,	@tbl_name				varchar(255)
,	@op_file_name			varchar(255)	=	null
,	@op_file_path			varchar(255)	=	'D:\projects\Danone\Output_Files\' --(select '\\' + convert(nvarchar(max),SERVERPROPERTY('machinename')) + '\PROJECTS\Danone\output_files\')
,	@order_ordinal_string	varchar(255)	=	null --',1,2'	-- Note preceding comma required in string
,	@sep					varchar(1)		=	','
,	@to_copy_paste			varchar(1)		=	'N'
,	@restrict_to_top_n		varchar(255)	=	null
)
RETURNS TABLE 
AS
RETURN 
--*/	declare @tbl_schema				varchar(255)	=	'ff_ext'									/*
--*/	declare @tbl_name				varchar(255)	=	'view_formatted_for_xinlin_4_wks_2160_on'	/*
--*/	declare @op_file_name			varchar(255)	=	'all_ret_20210123_to_20210213.csv'			/*
--*/	declare @op_file_path			varchar(255)	=	'D:\projects\Danone\Output_Files\'			/*
--*/	declare @order_ordinal_string	varchar(255)	=	',1,8,9'									/*
--*/	declare @sep					varchar(1)		=	','											/*
--*/	declare @to_copy_paste			varchar(1)		=	'N'											/*
--*/	declare @restrict_to_top_n		varchar(255)	=	null;

with opcols as (select column_name=column_name collate database_default from information_schema.columns where table_schema=@tbl_schema and table_name=@tbl_name)
-- select * from opcols /*
select
	bcp_cmd	= cast(
		concat
		(
--			'D:\"Program Files\Microsoft SQL Server\Client SDK"\ODBC\130\Tools\Binn\bcp "select '
			'bcp "select '
		,	stuff
			(
				(
				select
					concat(', ',quotename(column_name))
				from
					opcols
				for
					xml path('')
				,	type
				).value('(./text())[1]','VARCHAR(MAX)')
			,1,2,''
			)
		,	' from (select cn=1'
		,	(
			select
				case when @to_copy_paste = 'Y' then
					concat(', ',quotename(column_name),'=''',column_name,'''')
				else
					concat(', ',quotename(column_name),'=''''',column_name,'''''')
				end
			from
				opcols
			for
				xml path('')
			,	type
			).value('(./text())[1]','VARCHAR(MAX)')
		,	' union all select ','top '+@restrict_to_top_n+' ','cn=2'
		,	(
			select
				case when @to_copy_paste = 'Y' then
					concat(', ',quotename(column_name),'=nullif(cast(',quotename(column_name),' as varchar(255))',','''')') 
				else
					concat(', ',quotename(column_name),'=nullif(cast(',quotename(column_name),' as varchar(255))',','''''''')') 
				end
			from
				opcols
			for
				xml path('')
			,	type
			).value('(./text())[1]','VARCHAR(MAX)')
		,	concat(' from ' , db_name() , '.' , @tbl_schema , '.' , @tbl_name , ') a')
		,	' order by cn' + @order_ordinal_string
		,	concat('" queryout "' , @op_file_path , isnull(@op_file_name,'ufn_bcp_cmd_test_output.csv'))
		,	concat('" /q /c /t"' , @sep , '" /T /S' , @@SERVERNAME)
	) as varchar(max)) collate latin1_general_ci_as
--*/
GO
