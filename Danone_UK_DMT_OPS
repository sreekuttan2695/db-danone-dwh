-- select * from meas_desc	/*
,	leveldesc
as
(				select rn=1,t2_output='4093ST0500000010                                CATEGORY                                001                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000029                                MANUFACTURER                            002                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000040                                BRAND                                   003                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000209                                SECTOR                                  004                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000020                                TYPE                                    005                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000075                                PACKAGE                                 006                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000141                                WEIGHT                                  007                                                                                                                                                   '
	union all	select rn=2,t2_output='4093ST0500000080                                COUNT                                   008                                                                                                                                                   '
)
-- select * from leveldesc	/*
,	prod_desc
as
(
	select
		rn			=	ROW_NUMBER() over (order by (select null))
	,	t2_output	=	concat(prod_cc,'06',prod_key,longname,prod_attr1,prod_attr2,prod_attr3,prod_attr4,prod_attr5,prod_attr6,prod_attr7,prod_attr8)
	from
		stg.load_tbl_prod_3
)
-- select * from prod_desc	/*
,	desc_foot
as
(
	select
		rn			=	1
	,	t2_output	=	concat
						(	'4093ST'
						,	replicate('ÿ',82)
						,	right
							(
								concat
								(	space(10)
								,	cast
									(
										(select count(1) from desc_head)
									+	(select count(1) from time_desc)
									+	(select count(1) from geog_desc)
									+	(select count(1) from kcat_desc)
									+	(select count(1) from meas_desc)
									+	(select count(1) from leveldesc)
									+	(select count(1) from prod_desc)
									+	1
									as varchar
									)
								)
