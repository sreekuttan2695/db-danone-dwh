CREATE   PROCEDURE [iqvia].[sp_update_MASTER_PROD_IMS_LKUP_tbl_OLD]
/* =============================================================================
   Purpose : Validate the auto-assigned mappings in iqvia.NEW_PRODS_WITH_MAPPING
             and apply the clean ones to RDW.MASTER_PROD_IMS_LKUP (one row per
             IQVIA pack). Rejected rows are skipped; every issue is logged and
             emailed. Match key is the pack; when the pack is new, its EAN is
             also checked against other packs (R15, real_map/mock_map only -
             mockprod code collisions are always errors via R11/R12). EAN and
             iricode14 are validated against the lookup, the batch and
             ma_monetdb.view_item_identifiers either way.
   Inputs  : @recipients     - email recipients (required)
             @mail_profile   - Database Mail profile
             @dry_run        - 1 = validate, log, email; lookup untouched
             @allow_remap    - 1 = a mapped pack may take a new code (warned,
                               history kept); 0 = remaps rejected (default)
             @build_job_name - abort if this Agent job is running; NULL skips
   Outputs : RDW.MASTER_PROD_IMS_LKUP (INSERT/UPDATE), RDW.MASTER_PROD_IMS_LKUP_BKP
             (pre-change snapshot), iqvia.lkup_merge_run / lkup_merge_issue /
             master_prod_ims_lkup_hist, email, one summary result set
   Rules   : R01 format            R02 iricode14/EAN pair   R03 Prod_Source
             R04 pack in IMS_AVP   R05 batch duplicates     R07 remap
             R08 lookup duplicates R09 real/mock_map in MDM R10 MDM ambiguous
             R11 mock code in MDM  R12 code used by other pack
             R13 shared real/mock_map code (info)   R14 mock range (warn)
             R15 EAN already on a different pack (real_map/mock_map; same
                 rejected-by-default / @allow_remap posture as R07)
   Change  : 2026-09-23  Rewrite of the 18-Sep MERGE (ON Prod_Desc+EAN+iricode14,
                         insert-only), which duplicated packs on remap and on
                         NULL codes. UPDATE + INSERT in one transaction.
             2026-09-23  Match key extended: pack first (unchanged); when the
                         pack is new, fall back to EAN against a different pack
                         (R15), applied only with @allow_remap = 1 and only when
                         the EAN match is unambiguous. Guards against two batch
                         rows resolving to the same lookup row.
   ============================================================================= */
    @recipients     nvarchar(max)='UKSIDanoneDMT@circana.com; UKTSGSERVICE@Circana.com;',
    @mail_profile   sysname = N'DBA',
    @dry_run        bit     = 0,
    @allow_remap    bit     = 0,
    @build_job_name sysname = N'DAN_UK_IQVIA_MTHLY_Data_Load_Process'
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    DECLARE @run_id     int;
    DECLARE @applied    bit = 0;
    DECLARE @msg        nvarchar(2048);
    DECLARE @subject    nvarchar(255);
    DECLARE @body       nvarchar(max);
    DECLARE @issue_rows int;
    DECLARE @n_codes    int = 0;
    DECLARE @n_batch int = 0, @x_ins int = 0, @x_upd int = 0, @n_ins int = 0, @n_upd int = 0,
            @n_same  int = 0, @n_dup int = 0, @n_rej int = 0, @n_warn int = 0;

    SET @dry_run     = ISNULL(@dry_run, 0);
    SET @allow_remap = ISNULL(@allow_remap, 0);

    IF NULLIF(LTRIM(RTRIM(@recipients)), N'') IS NULL
        THROW 50140, N'sp_update_MASTER_PROD_IMS_LKUP_tbl: @recipients is required.', 1;

    INSERT INTO iqvia.lkup_merge_run (source_name, dry_run, allow_remap, started_at, status)
    VALUES (N'iqvia.NEW_PRODS_WITH_MAPPING', @dry_run, @allow_remap, SYSDATETIME(), 'RUNNING');

    SET @run_id = CONVERT(int, SCOPE_IDENTITY());

    BEGIN TRY
        EXEC iqvia.usp_assert_job_not_running @job_name = @build_job_name;

        /* NEW_PRODS_WITH_MAPPING uses NOT IN: a NULL category empties it silently */
        IF EXISTS (SELECT 1 FROM RDW.excluded_IMS_categories AS e WHERE e.category IS NULL)
            THROW 50142, N'NULL category in RDW.excluded_IMS_categories: NEW_PRODS_WITH_MAPPING (NOT IN) would return no rows. Fix the data first.', 1;

        SELECT @n_codes = COUNT(*) FROM iqvia.new_products_barcode;

        /* ==== 1. Batch ======================================================= */
        CREATE TABLE #batch
        (
            batch_row      int           IDENTITY(1, 1) NOT NULL PRIMARY KEY,
            Prod_Desc      nvarchar(255) NULL,
            src_raw        varchar(255)  NULL,
            Prod_Source    varchar(20)   NULL,
            EAN            varchar(50)   NULL,
            iricode14      varchar(50)   NULL,
            Category       nvarchar(255) NULL,
            Sub_Category_1 nvarchar(255) NULL,
            Sub_Category_2 nvarchar(255) NULL,
            Manufacturer   nvarchar(255) NULL,
            Brand          nvarchar(255) NULL,
            Product        nvarchar(255) NULL,
            [Format]       nvarchar(255) NULL,
            ean_ok         bit           NOT NULL DEFAULT (0),
            code14_ok      bit           NOT NULL DEFAULT (0),
            avp_rows       int           NULL,
            avp_key        int           NULL,
            lkp_rows       int           NULL,
            lkp_EAN        varchar(50)   NULL,
            lkp_iricode14  varchar(14)   NULL,
            lkp_source     varchar(20)   NULL,
            is_identical   bit           NOT NULL DEFAULT (0),
            is_dup         bit           NOT NULL DEFAULT (0),
            ean_other_desc   nvarchar(255) NULL,   -- other pack the EAN already belongs to (if any)
            ean_other_source varchar(20)   NULL,
            ean_other_rows   int           NULL,   -- how many distinct other packs share this EAN
            match_key        varchar(4)    NULL,   -- 'PACK' | 'EAN' | NULL (no existing row -> INSERT)
            match_desc       nvarchar(255) NULL,   -- lookup Prod_Desc that UPDATE targets
            action         varchar(10)   NULL
        );

        INSERT INTO #batch (Prod_Desc, src_raw, Prod_Source, EAN, iricode14,
                            Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format])
        SELECT NULLIF(m.Prod_Desc, N''),
               m.Prod_Source,
               CASE LOWER(LTRIM(RTRIM(m.Prod_Source)))
                    WHEN 'mockprod'  THEN 'mockprod'
                    WHEN 'mock_prod' THEN 'mockprod'
                    WHEN 'mock_map'  THEN 'mock_map'
                    WHEN 'real_map'  THEN 'real_map'
               END,
               NULLIF(LTRIM(RTRIM(m.EAN)), ''),
               NULLIF(LTRIM(RTRIM(m.iricode14)), ''),
               m.Category, m.Sub_Category_1, m.Sub_Category_2, m.Manufacturer, m.Brand, m.Product, m.[FORMAT]
        FROM   iqvia.NEW_PRODS_WITH_MAPPING AS m;

        SET @n_batch = @@ROWCOUNT;

        /* ==== 2. Enrich: formats, AVP key, current lookup state ============== */
        UPDATE #batch
        SET    ean_ok    = CASE WHEN LEN(EAN) = 13       AND EAN       NOT LIKE '%[^0-9]%' THEN 1 ELSE 0 END,
               code14_ok = CASE WHEN LEN(iricode14) = 14 AND iricode14 NOT LIKE '%[^0-9]%' THEN 1 ELSE 0 END;

        UPDATE b
        SET    b.avp_rows = a.n,
               b.avp_key  = a.avp_key
        FROM   #batch AS b
        CROSS APPLY (SELECT n = COUNT(*), avp_key = MIN(x.AVP_Key)
                     FROM   RDW.IMS_AVP AS x
                     WHERE  x.ATR_NAME  = N'IMS Pack'
                       AND  x.ATR_VALUE = b.Prod_Desc) AS a;

        UPDATE b
        SET    b.lkp_rows      = l.n,
               b.lkp_EAN       = l.ean,
               b.lkp_iricode14 = l.code14,
               b.lkp_source    = CASE LOWER(LTRIM(RTRIM(l.src))) WHEN 'mock_prod' THEN 'mockprod'
                                                                 ELSE LOWER(LTRIM(RTRIM(l.src))) END
        FROM   #batch AS b
        CROSS APPLY (SELECT n = COUNT(*), ean = MAX(x.EAN), code14 = MAX(x.iricode14), src = MAX(x.Prod_Source)
                     FROM   RDW.MASTER_PROD_IMS_LKUP AS x
                     WHERE  x.Prod_Desc = b.Prod_Desc) AS l;

        /* Pack not in the lookup yet: does its EAN already belong to a different pack?
           real_map/mock_map only - a mockprod code collision is always an error (R11/R12),
           never a rename candidate.                                                       */
        UPDATE b
        SET    b.ean_other_rows = o.n
        FROM   #batch AS b
        CROSS APPLY (SELECT n = COUNT(*)
                     FROM   RDW.MASTER_PROD_IMS_LKUP AS l
                     WHERE  l.EAN = b.EAN AND l.Prod_Desc <> b.Prod_Desc) AS o
        WHERE  b.lkp_rows = 0 AND b.Prod_Source IN ('real_map', 'mock_map') AND b.ean_ok = 1;

        UPDATE b
        SET    b.ean_other_desc   = o.Prod_Desc,
               b.ean_other_source = o.Prod_Source
        FROM   #batch AS b
        CROSS APPLY (SELECT TOP (1) l.Prod_Desc, l.Prod_Source
                     FROM   RDW.MASTER_PROD_IMS_LKUP AS l
                     WHERE  l.EAN = b.EAN AND l.Prod_Desc <> b.Prod_Desc
                     ORDER BY l.Prod_Desc) AS o
        WHERE  ISNULL(b.ean_other_rows, 0) > 0;

        /* Already mapped exactly like this -> NOCHANGE, bypasses all rules
           (covers a mock code that has since been created in MDM).             */
        UPDATE #batch
        SET    is_identical = 1
        WHERE  lkp_rows      = 1
          AND  lkp_EAN       = EAN
          AND  lkp_iricode14 = iricode14
          AND  lkp_source    = Prod_Source;

        /* Duplicate packs inside the batch */
        CREATE TABLE #pack_variants
        (
            Prod_Desc  nvarchar(255) NOT NULL PRIMARY KEY,
            n_rows     int           NOT NULL,
            n_variants int           NOT NULL
        );

        INSERT INTO #pack_variants (Prod_Desc, n_rows, n_variants)
        SELECT b.Prod_Desc,
               COUNT(*),
               COUNT(DISTINCT CONCAT(b.EAN, '|', b.iricode14, '|', b.Prod_Source))
        FROM   #batch AS b
        WHERE  b.Prod_Desc IS NOT NULL
        GROUP BY b.Prod_Desc
        HAVING COUNT(*) > 1;

        WITH r AS
        (
            SELECT b.is_dup,
                   rn = ROW_NUMBER() OVER (PARTITION BY b.Prod_Desc ORDER BY b.batch_row)
            FROM   #batch AS b
            WHERE  EXISTS (SELECT 1 FROM #pack_variants AS v
                           WHERE v.Prod_Desc = b.Prod_Desc AND v.n_variants = 1)
        )
        UPDATE r SET is_dup = 1 WHERE rn > 1;

        /* ==== 3. MDM rows touching the batch codes (view scanned once) ======= */
        CREATE TABLE #mdm
        (
            iricode13    varchar(50)   NULL,
            iricode14    varchar(50)   NULL,
            item_dim_key int           NULL,
            prod_desc    nvarchar(255) NULL
        );

        INSERT INTO #mdm (iricode13, iricode14, item_dim_key, prod_desc)
        SELECT i.iricode13, i.iricode14, i.item_dim_key, LEFT(CONVERT(nvarchar(4000), i.prod_desc), 255)
        FROM   ma_monetdb.view_item_identifiers AS i
        WHERE  i.iricode13 IN (SELECT b.EAN       FROM #batch AS b WHERE b.EAN IS NOT NULL)
           OR  i.iricode14 IN (SELECT b.iricode14 FROM #batch AS b WHERE b.iricode14 IS NOT NULL);

        CREATE TABLE #mdm13
        (
            iricode13    varchar(50)   NOT NULL PRIMARY KEY,
            n_items      int           NOT NULL,
            item_dim_key int           NULL,
            iricode14    varchar(50)   NULL,
            n_code14     int           NOT NULL,
            prod_desc    nvarchar(255) NULL
        );

        INSERT INTO #mdm13 (iricode13, n_items, item_dim_key, iricode14, n_code14, prod_desc)
        SELECT m.iricode13, COUNT(DISTINCT m.item_dim_key), MIN(m.item_dim_key),
               MIN(m.iricode14), COUNT(DISTINCT m.iricode14), MIN(m.prod_desc)
        FROM   #mdm AS m
        WHERE  m.iricode13 IS NOT NULL
        GROUP BY m.iricode13;

        /* ==== 4. Rules ======================================================= */
        CREATE TABLE #issue
        (
            batch_row             int            NULL,
            Prod_Desc             nvarchar(255)  NULL,
            Prod_Source           varchar(20)    NULL,
            EAN                   varchar(50)    NULL,
            iricode14             varchar(50)    NULL,
            severity              varchar(5)     NOT NULL,
            rule_code             varchar(30)    NOT NULL,
            message               nvarchar(1000) NOT NULL,
            mdm_item_dim_key      int            NULL,
            mdm_prod_desc         nvarchar(255)  NULL,
            conflicting_prod_desc nvarchar(255)  NULL
        );

        /* R01  Pack present; EAN 13 digits; iricode14 14 digits */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R01_FORMAT',
               CONCAT(N'Invalid:',
                      CASE WHEN b.Prod_Desc IS NULL THEN N' pack description missing;' ELSE N'' END,
                      CASE WHEN b.ean_ok    = 0     THEN N' EAN must be 13 digits;'    ELSE N'' END,
                      CASE WHEN b.code14_ok = 0     THEN N' iricode14 must be 14 digits;' ELSE N'' END)
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  (b.Prod_Desc IS NULL OR b.ean_ok = 0 OR b.code14_ok = 0);

        /* R02  iricode14 pairs with EAN: MDM value if the EAN is in MDM, else the
                view_item_identifiers formula LEFT(EAN,2) + '0' + SUBSTRING(EAN,3,11) */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, mdm_item_dim_key, mdm_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R02_PAIR',
               CONCAT(N'iricode14 does not pair with EAN; expected ',
                      COALESCE(m.iricode14, LEFT(b.EAN, 2) + '0' + SUBSTRING(b.EAN, 3, 11)),
                      CASE WHEN m.iricode13 IS NOT NULL THEN N' (MDM)' ELSE N' (derived)' END),
               m.item_dim_key, m.prod_desc
        FROM   #batch AS b
        LEFT JOIN #mdm13 AS m
               ON m.iricode13 = b.EAN
              AND m.n_code14  = 1
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.ean_ok = 1 AND b.code14_ok = 1
          AND  b.iricode14 <> COALESCE(m.iricode14, LEFT(b.EAN, 2) + '0' + SUBSTRING(b.EAN, 3, 11));

        /* R03  Prod_Source recognised */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R03_SOURCE',
               CONCAT(N'Prod_Source ''', b.src_raw, N''' not recognised (real_map, mock_map, mockprod)')
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source IS NULL;

        /* R04  Pack resolves to exactly one IMS Pack key */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R04_PACK',
               CASE WHEN b.avp_rows = 0 THEN N'Pack not found in RDW.IMS_AVP (IMS Pack)'
                    ELSE CONCAT(N'Pack has ', b.avp_rows, N' IMS Pack keys in RDW.IMS_AVP') END
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Desc IS NOT NULL
          AND  b.avp_rows <> 1;

        /* R05  Same pack more than once in the batch */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R05_BATCH_DUP',
               CONCAT(N'Pack appears ', v.n_rows, N' times in the batch with ', v.n_variants, N' different codes')
        FROM   #batch AS b
        JOIN   #pack_variants AS v ON v.Prod_Desc = b.Prod_Desc
        WHERE  b.is_identical = 0
          AND  v.n_variants > 1;

        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'INFO', 'R05_BATCH_DUP',
               N'Identical duplicate row in batch; first occurrence used'
        FROM   #batch AS b
        WHERE  b.is_dup = 1;

        /* R07  Pack already mapped to different codes. Replacing a real_map /
                mock_map with a mock product is always rejected.                */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14,
               CASE WHEN d.downgrade = 0 AND @allow_remap = 1 THEN 'WARN' ELSE 'ERROR' END,
               'R07_REMAP',
               CONCAT(N'Pack already mapped to ', b.lkp_EAN, N' / ', b.lkp_iricode14, N' (', b.lkp_source,
                      N'); batch has ', b.EAN, N' / ', b.iricode14, N' (', b.Prod_Source, N')',
                      CASE WHEN d.downgrade = 1   THEN N' - would replace a real/mock mapping with a mock product'
                           WHEN @allow_remap = 1  THEN N' - remap applied, history kept'
                           ELSE N' - remap not allowed (@allow_remap = 0)' END)
        FROM   #batch AS b
        CROSS APPLY (SELECT downgrade = CASE WHEN b.lkp_source IN ('real_map', 'mock_map')
                                              AND b.Prod_Source = 'mockprod' THEN 1 ELSE 0 END) AS d
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.lkp_rows = 1;

        /* R08  Pack already has more than one lookup row */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R08_LKUP_DUP',
               CONCAT(N'Pack has ', b.lkp_rows, N' rows in RDW.MASTER_PROD_IMS_LKUP; run the cleanup first')
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.lkp_rows > 1;

        /* R09  real_map / mock_map must point at an existing MDM item */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R09_NOT_IN_MDM',
               CONCAT(N'EAN not found in view_item_identifiers; ', b.Prod_Source, N' must map to an existing item')
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.ean_ok = 1
          AND  b.Prod_Source IN ('real_map', 'mock_map')
          AND  NOT EXISTS (SELECT 1 FROM #mdm13 AS m WHERE m.iricode13 = b.EAN);

        /* R10  EAN matches more than one MDM item */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, mdm_item_dim_key, mdm_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R10_MDM_AMBIGUOUS',
               CONCAT(N'EAN matches ', m.n_items, N' items in view_item_identifiers'),
               m.item_dim_key, m.prod_desc
        FROM   #batch AS b
        JOIN   #mdm13 AS m ON m.iricode13 = b.EAN
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  m.n_items > 1;

        /* R11  A new mock product's code must not exist in MDM at merge time */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, mdm_item_dim_key, mdm_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R11_MDM_CLASH',
               CONCAT(N'Code already belongs to Danone item ', c.item_dim_key, N' (', c.prod_desc, N') via ', c.matched_on),
               c.item_dim_key, c.prod_desc
        FROM   #batch AS b
        CROSS APPLY (SELECT TOP (1) m.item_dim_key, m.prod_desc,
                            matched_on = CASE WHEN m.iricode13 = b.EAN THEN N'iricode13' ELSE N'iricode14' END
                     FROM   #mdm AS m
                     WHERE  m.iricode13 = b.EAN OR m.iricode14 = b.iricode14
                     ORDER BY CASE WHEN m.iricode13 = b.EAN THEN 0 ELSE 1 END, m.item_dim_key) AS c
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source = 'mockprod';

        /* R12  A mock code must belong to one pack only: lookup ... */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, conflicting_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R12_CODE_IN_USE',
               CONCAT(N'Code already mapped to another pack in the lookup (', o.Prod_Source, N')'),
               o.Prod_Desc
        FROM   #batch AS b
        CROSS APPLY (SELECT TOP (1) l.Prod_Desc, l.Prod_Source
                     FROM   RDW.MASTER_PROD_IMS_LKUP AS l
                     WHERE  (l.EAN = b.EAN OR l.iricode14 = b.iricode14)
                       AND  l.Prod_Desc <> b.Prod_Desc
                     ORDER BY l.Prod_Desc) AS o
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source = 'mockprod';

        /* ... and batch */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, conflicting_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'ERROR', 'R12_CODE_IN_USE',
               N'Code also assigned to another pack in this batch',
               o.Prod_Desc
        FROM   #batch AS b
        CROSS APPLY (SELECT TOP (1) x.Prod_Desc
                     FROM   #batch AS x
                     WHERE  (x.EAN = b.EAN OR x.iricode14 = b.iricode14)
                       AND  x.Prod_Desc <> b.Prod_Desc
                       AND  x.is_dup = 0
                     ORDER BY x.Prod_Desc) AS o
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source = 'mockprod';

        /* R13  real_map / mock_map sharing an item with other packs is legitimate (PP/PI variants) */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, conflicting_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'INFO', 'R13_SHARED_CODE',
               CONCAT(N'EAN also mapped to ', o.n, N' other pack(s)'),
               o.example
        FROM   #batch AS b
        CROSS APPLY (SELECT n = COUNT(*), example = MIN(l.Prod_Desc)
                     FROM   RDW.MASTER_PROD_IMS_LKUP AS l
                     WHERE  l.EAN = b.EAN
                       AND  l.Prod_Desc <> b.Prod_Desc) AS o
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source IN ('real_map', 'mock_map')
          AND  o.n > 0;

        /* R14  Mock codes belong in the restricted-circulation range (prefix 2) */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14, 'WARN', 'R14_RANGE',
               N'mockprod EAN outside the restricted-circulation range (does not start with 2)'
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.Prod_Source = 'mockprod'
          AND  b.ean_ok = 1
          AND  LEFT(b.EAN, 1) <> '2';

        /* R15  Pack is new to the lookup, but its EAN already belongs to a different
                pack (real_map/mock_map only). Same posture as R07: rejected by default;
                @allow_remap = 1 treats it as a rename of that existing row (WARN, history
                kept), and only when the EAN is unambiguous (exactly one other pack).      */
        INSERT INTO #issue (batch_row, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code, message, conflicting_prod_desc)
        SELECT b.batch_row, b.Prod_Desc, b.Prod_Source, b.EAN, b.iricode14,
               CASE WHEN @allow_remap = 1 AND b.ean_other_rows = 1 THEN 'WARN' ELSE 'ERROR' END,
               'R15_EAN_OTHER_PACK',
               CONCAT(N'EAN already mapped to a different pack (', b.ean_other_desc, N', ', b.ean_other_source, N')',
                      CASE WHEN b.ean_other_rows > 1 THEN N' and other packs too - ambiguous, remap not applied' ELSE N'' END,
                      CASE WHEN @allow_remap = 1 AND b.ean_other_rows = 1
                           THEN N' - treated as a pack rename (remap allowed), history kept'
                           WHEN @allow_remap = 0
                           THEN N' - not merged (@allow_remap = 0); confirm it is the same item before allowing a remap'
                           ELSE N'' END),
               b.ean_other_desc
        FROM   #batch AS b
        WHERE  b.is_identical = 0 AND b.is_dup = 0
          AND  b.lkp_rows = 0
          AND  ISNULL(b.ean_other_rows, 0) > 0;

        /* ==== 5. Match key and action per row =================================
           Match on the pack first (unchanged, one row per pack). Only when the
           pack is new do we fall back to matching on EAN - and only when the
           match is unambiguous and the operator has explicitly allowed it. This
           is deliberately the narrow case: it does not reintroduce the 18-Sep
           bug, which matched pack+EAN+iricode14 together on every row.         */
        UPDATE b
        SET    b.match_key  = CASE WHEN b.lkp_rows = 1 THEN 'PACK'
                                    WHEN @allow_remap = 1 AND b.ean_other_rows = 1 THEN 'EAN'
                                    ELSE NULL END,
               b.match_desc = CASE WHEN b.lkp_rows = 1 THEN b.Prod_Desc
                                    WHEN @allow_remap = 1 AND b.ean_other_rows = 1 THEN b.ean_other_desc
                                    ELSE b.Prod_Desc END
        FROM   #batch AS b;

        UPDATE b
        SET    b.action = CASE
                              WHEN b.is_dup = 1       THEN 'DUPLICATE'
                              WHEN b.is_identical = 1 THEN 'NOCHANGE'
                              WHEN EXISTS (SELECT 1 FROM #issue AS i
                                           WHERE i.batch_row = b.batch_row AND i.severity = 'ERROR') THEN 'REJECT'
                              WHEN b.match_key IS NOT NULL THEN 'UPDATE'
                              ELSE 'INSERT'
                          END
        FROM   #batch AS b;

        /* Two batch rows resolving to the same existing lookup row (same pack,
           or - only possible with @allow_remap = 1 - the same EAN-matched
           rename target) would corrupt one of them if applied together.       */
        IF EXISTS (SELECT 1 FROM #batch AS b WHERE b.action = 'UPDATE' GROUP BY b.match_desc HAVING COUNT(*) > 1)
        BEGIN
            SET @msg = N'Two batch rows resolve to the same existing lookup row; apply stopped. Check R15_EAN_OTHER_PACK rows for a shared rename target.';
            THROW 50143, @msg, 1;
        END;

        SELECT @x_ins  = ISNULL(SUM(CASE WHEN b.action = 'INSERT'    THEN 1 ELSE 0 END), 0),
               @x_upd  = ISNULL(SUM(CASE WHEN b.action = 'UPDATE'    THEN 1 ELSE 0 END), 0),
               @n_same = ISNULL(SUM(CASE WHEN b.action = 'NOCHANGE'  THEN 1 ELSE 0 END), 0),
               @n_dup  = ISNULL(SUM(CASE WHEN b.action = 'DUPLICATE' THEN 1 ELSE 0 END), 0),
               @n_rej  = ISNULL(SUM(CASE WHEN b.action = 'REJECT'    THEN 1 ELSE 0 END), 0)
        FROM   #batch AS b;

        SELECT @n_warn = COUNT(DISTINCT i.batch_row)
        FROM   #issue AS i
        JOIN   #batch AS b ON b.batch_row = i.batch_row
        WHERE  i.severity = 'WARN'
          AND  b.action IN ('INSERT', 'UPDATE');

        INSERT INTO iqvia.lkup_merge_issue (run_id, Prod_Desc, Prod_Source, EAN, iricode14, severity, rule_code,
                                            message, mdm_item_dim_key, mdm_prod_desc, conflicting_prod_desc)
        SELECT @run_id, i.Prod_Desc, i.Prod_Source, i.EAN, i.iricode14, i.severity, i.rule_code,
               LEFT(i.message, 1000), i.mdm_item_dim_key, i.mdm_prod_desc, i.conflicting_prod_desc
        FROM   #issue AS i;

        /* ==== 6. Apply ======================================================= */
        IF @dry_run = 0 AND (@x_ins + @x_upd) > 0
        BEGIN
            BEGIN TRANSACTION;

            DROP TABLE IF EXISTS RDW.MASTER_PROD_IMS_LKUP_BKP;

            SELECT l.IQVIA_Prod_ID, l.Prod_Source, l.Prod_Desc, l.EAN, l.iricode14,
                   l.Category, l.Sub_Category_1, l.Sub_Category_2, l.Manufacturer, l.Brand, l.Product, l.[Format],
                   l.DateStamp
            INTO   RDW.MASTER_PROD_IMS_LKUP_BKP
            FROM   RDW.MASTER_PROD_IMS_LKUP AS l;

            UPDATE l
            SET    l.IQVIA_Prod_ID  = b.avp_key,
                   l.Prod_Source    = b.Prod_Source,
                   l.Prod_Desc      = b.Prod_Desc,     -- no-op when match_key = 'PACK'; applies the rename when 'EAN'
                   l.EAN            = b.EAN,
                   l.iricode14      = b.iricode14,
                   l.Category       = b.Category,
                   l.Sub_Category_1 = b.Sub_Category_1,
                   l.Sub_Category_2 = b.Sub_Category_2,
                   l.Manufacturer   = b.Manufacturer,
                   l.Brand          = b.Brand,
                   l.Product        = b.Product,
                   l.[Format]       = b.[Format],
                   l.DateStamp      = GETDATE()
            OUTPUT @run_id, 'UPDATE', inserted.Prod_Desc,
                   deleted.EAN, deleted.iricode14, deleted.Prod_Source,
                   inserted.EAN, inserted.iricode14, inserted.Prod_Source,
                   SYSDATETIME(), SUSER_SNAME()
            INTO   iqvia.master_prod_ims_lkup_hist (run_id, action, Prod_Desc,
                                                    old_EAN, old_iricode14, old_Prod_Source,
                                                    new_EAN, new_iricode14, new_Prod_Source,
                                                    changed_at, changed_by)
            FROM   RDW.MASTER_PROD_IMS_LKUP AS l
            JOIN   #batch AS b ON b.match_desc = l.Prod_Desc
            WHERE  b.action = 'UPDATE';

            SET @n_upd = @@ROWCOUNT;

            INSERT INTO RDW.MASTER_PROD_IMS_LKUP (IQVIA_Prod_ID, Prod_Source, Prod_Desc, EAN, iricode14,
                                                  Category, Sub_Category_1, Sub_Category_2, Manufacturer,
                                                  Brand, Product, [Format], DateStamp)
            OUTPUT @run_id, 'INSERT', inserted.Prod_Desc,
                   NULL, NULL, NULL,
                   inserted.EAN, inserted.iricode14, inserted.Prod_Source,
                   SYSDATETIME(), SUSER_SNAME()
            INTO   iqvia.master_prod_ims_lkup_hist (run_id, action, Prod_Desc,
                                                    old_EAN, old_iricode14, old_Prod_Source,
                                                    new_EAN, new_iricode14, new_Prod_Source,
                                                    changed_at, changed_by)
            SELECT b.avp_key, b.Prod_Source, b.Prod_Desc, b.EAN, b.iricode14,
                   b.Category, b.Sub_Category_1, b.Sub_Category_2, b.Manufacturer,
                   b.Brand, b.Product, b.[Format], GETDATE()
            FROM   #batch AS b
            WHERE  b.action = 'INSERT'
              AND  NOT EXISTS (SELECT 1
                               FROM   RDW.MASTER_PROD_IMS_LKUP AS l WITH (UPDLOCK, HOLDLOCK)
                               WHERE  l.Prod_Desc = b.Prod_Desc);

            SET @n_ins = @@ROWCOUNT;

            IF @n_ins <> @x_ins OR @n_upd <> @x_upd
            BEGIN
                SET @msg = CONCAT(N'Applied rows differ from plan (inserted ', @n_ins, N'/', @x_ins,
                                  N', updated ', @n_upd, N'/', @x_upd, N'); rolled back.');
                THROW 50141, @msg, 1;
            END;

            COMMIT TRANSACTION;
            SET @applied = 1;
        END;

        UPDATE iqvia.lkup_merge_run
        SET    batch_rows     = @n_batch,
               inserted_rows  = @x_ins,
               updated_rows   = @x_upd,
               unchanged_rows = @n_same,
               duplicate_rows = @n_dup,
               rejected_rows  = @n_rej,
               warning_rows   = @n_warn,
               status         = CASE WHEN @dry_run = 1 THEN 'DRY_RUN_VALIDATED' ELSE 'APPLIED' END
        WHERE  run_id = @run_id;

        /* ==== 7. Email ======================================================= */
        SELECT @issue_rows = COUNT(*) FROM #issue AS i WHERE i.severity IN ('ERROR', 'WARN');

        SET @subject = CONCAT(N'DANONE: IQVIA LOOKUP MERGE',
                              CASE WHEN @dry_run = 1 THEN N' (DRY RUN)' ELSE N'' END,
                              CASE WHEN @n_rej  > 0 THEN CONCAT(N' - ', @n_rej, N' REJECTED')     ELSE N'' END,
                              CASE WHEN @n_warn > 0 THEN CONCAT(N' - ', @n_warn, N' WARNING(S)')  ELSE N'' END,
                              CASE WHEN @n_rej = 0 AND @n_warn = 0 THEN N' - OK' ELSE N'' END);

        SET @body = CONCAT(
            CONVERT(nvarchar(max), N'<html><body style="font-family:Calibri,Arial,sans-serif;font-size:11pt">'),
            N'<p>IQVIA mapping lookup merge, run ', @run_id,
            CASE WHEN @dry_run = 1 THEN N' (dry run: nothing written to the lookup)' ELSE N'' END, N'.</p>',
            N'<table border="1" cellpadding="4" style="border-collapse:collapse">',
            N'<tr><th align="left">Codes in iqvia.new_products_barcode</th><td>', @n_codes, N'</td></tr>',
            N'<tr><th align="left">Rows in batch (NEW_PRODS_WITH_MAPPING)</th><td>', @n_batch, N'</td></tr>',
            N'<tr><th align="left">Inserted</th><td>',                @x_ins,   N'</td></tr>',
            N'<tr><th align="left">Updated (remap)</th><td>',         @x_upd,   N'</td></tr>',
            N'<tr><th align="left">Unchanged</th><td>',               @n_same,  N'</td></tr>',
            N'<tr><th align="left">Duplicate rows ignored</th><td>',  @n_dup,   N'</td></tr>',
            N'<tr><th align="left">Rejected (not merged)</th><td>',   @n_rej,   N'</td></tr>',
            N'<tr><th align="left">Merged with warnings</th><td>',    @n_warn,  N'</td></tr>',
            N'</table>',
            CASE WHEN @issue_rows > 0 THEN CONCAT(
                CONVERT(nvarchar(max), N'<p>Rejections and warnings'),
                CASE WHEN @issue_rows > 500 THEN N' (first 500)' ELSE N'' END, N':</p>',
                N'<table border="1" cellpadding="4" style="border-collapse:collapse">',
                N'<tr style="background-color:#dddddd"><th>Severity</th><th>Rule</th><th>IQVIA pack</th>',
                N'<th>EAN</th><th>iricode14</th><th>Detail</th><th>Danone item</th><th>Conflicting pack</th></tr>',
                CAST((SELECT TOP (500)
                             td = i.severity,                           N'',
                             td = i.rule_code,                          N'',
                             td = ISNULL(i.Prod_Desc, N''),             N'',
                             td = ISNULL(i.EAN, ''),                    N'',
                             td = ISNULL(i.iricode14, ''),              N'',
                             td = i.message,                            N'',
                             td = CASE WHEN i.mdm_item_dim_key IS NULL THEN N''
                                       ELSE CONCAT(i.mdm_item_dim_key, N' ', i.mdm_prod_desc) END, N'',
                             td = ISNULL(i.conflicting_prod_desc, N'')
                      FROM   #issue AS i
                      WHERE  i.severity IN ('ERROR', 'WARN')
                      ORDER BY CASE i.severity WHEN 'ERROR' THEN 0 ELSE 1 END, i.rule_code, i.Prod_Desc
                      FOR XML PATH('tr'), TYPE) AS nvarchar(max)),
                N'</table>')
                 ELSE N'<p>No rejections or warnings.</p>' END,
            N'<p>Packs without non-zero UK sales are not emitted by NEW_PRODS_WITH_MAPPING, so the batch can be smaller than the code table.</p>',
            N'<p>Rejected rows were not merged; the pack stays unmapped and gets a new code at the next barcode assignment.</p>',
            N'<p>Full detail: iqvia.lkup_merge_issue, run_id = ', @run_id, N'.</p>',
            N'<p>This is an automated email. Please do not reply.</p></body></html>');

        EXEC msdb.dbo.sp_send_dbmail
             @profile_name = @mail_profile,
             @recipients   = @recipients,
             @subject      = @subject,
             @body         = @body,
             @body_format  = 'HTML';

        UPDATE iqvia.lkup_merge_run
        SET    status      = CASE WHEN @dry_run = 1 THEN 'DRY_RUN' ELSE 'SUCCEEDED' END,
               finished_at = SYSDATETIME()
        WHERE  run_id = @run_id;

        SELECT run_id = @run_id, dry_run = @dry_run, batch_rows = @n_batch, inserted = @x_ins, updated = @x_upd,
               unchanged = @n_same, duplicates = @n_dup, rejected = @n_rej, warnings = @n_warn;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0
            ROLLBACK TRANSACTION;

        SET @msg = CONCAT(N'sp_update_MASTER_PROD_IMS_LKUP_tbl (run ', @run_id, N') failed at line ',
                          ERROR_LINE(), N': ', ERROR_MESSAGE());

        UPDATE iqvia.lkup_merge_run
        SET    status        = CASE WHEN @applied = 1 THEN 'APPLIED_NOTIFY_FAILED' ELSE 'FAILED' END,
               finished_at   = SYSDATETIME(),
               error_message = @msg
        WHERE  run_id = @run_id;

        THROW 50149, @msg, 1;
    END CATCH;
END;
