CREATE PROCEDURE [iqvia].[sp_create_ims_fact_tbl]
-- =============================================
-- Author:      Adeel Abid
-- Create date: 07/10/2021
-- Purpose:     Unpivot IMS.LATEST_IMS_DATA_VIEW into IMS.FACT (GB) by month.
-- Inputs:      none (schema-driven from IMS.LATEST_IMS_DATA_VIEW)
-- Outputs:     IMS.FACT (dropped and recreated; 13 cols incl. NET_WEIGHT)
-- Change log:
--   2026-07-30  NET WEIGHT CR: By Sreekesh
--               - 4-tuple CROSS APPLY -> 5-tuple, adds NET_WEIGHT
--               - TimeID driver anchored on UNITS[_]MTH% (was '%mth%')
--               - guard: fail if NET_WEIGHT missing for any UNITS TimeID
--               - CATCH now rethrows (was SELECT-only, which reported the
--                 job step as success after DROP TABLE had already run)
--               NOTE: NET_WEIGHT is stored raw. IQVIA emits '0' (not '-')
--                     for no-sales months. Do not assume '-' semantics.
-- =============================================
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY
        DECLARE @cross_apply_values nvarchar(max) = NULL;
        DECLARE @missing_nw int;
        DECLARE @tid_count  int;

        SELECT @tid_count = COUNT(DISTINCT RIGHT(column_name, 7))
        FROM   information_schema.columns
        WHERE  table_schema = 'IMS'
          AND  table_name   = 'latest_ims_data_view'
          AND  column_name LIKE 'UNITS[_]MTH%';

        IF @tid_count = 0
            THROW 50020, 'sp_create_ims_fact_tbl: no UNITS_MTH columns in IMS.latest_ims_data_view. Run sp_update_latest_ims_data_view_gb first.', 1;

        SELECT @missing_nw = COUNT(*)
        FROM (
            SELECT DISTINCT TimeID = RIGHT(column_name, 7)
            FROM   information_schema.columns
            WHERE  table_schema = 'IMS'
              AND  table_name   = 'latest_ims_data_view'
              AND  column_name LIKE 'UNITS[_]MTH%'
        ) u
        WHERE NOT EXISTS (
            SELECT 1 FROM information_schema.columns nw
            WHERE nw.table_schema = 'IMS'
              AND nw.table_name   = 'latest_ims_data_view'
              AND nw.column_name  = 'NET_WEIGHT_' + u.TimeID
        );

        IF @missing_nw > 0
            THROW 50021, 'sp_create_ims_fact_tbl: NET_WEIGHT column missing for one or more UNITS TimeIDs. Check IQVIA header format / GAP2 exclusion.', 1;

        SELECT @cross_apply_values =
               COALESCE(@cross_apply_values + ',', ' ')
             + '(''' + TimeID + ''', [UNITS_' + TimeID + '], [VALUES_STG_' + TimeID
             + '], [VOLUME_' + TimeID + '], [NET_WEIGHT_' + TimeID + '])
	'
        FROM (
            SELECT DISTINCT
                   TimeID = RIGHT(column_name, 7)
                 , yr     = CAST(RIGHT(column_name, 2) AS int)
                 , mm     = CAST(LEFT(RIGHT(column_name, 4), 2) AS int)
            FROM   information_schema.columns
            WHERE  table_schema = 'IMS'
              AND  table_name   = 'latest_ims_data_view'
              AND  column_name LIKE 'UNITS[_]MTH%'
        ) t
        ORDER BY yr, mm;

        SELECT @cross_apply_values = 'if object_id(''IMS.FACT'') is not null drop table IMS.FACT

	select [IMS_Pack], [Category], [Sub_Category_1], [Sub_Category_2], [Manufacturer], [Brand], [Product], [Format]
	, [FACT_MONTH], [UNITS], [VALUE_STG]=RDW.CleanString([VALUE_STG],''[^0-9.]''), [VOLUME], [NET_WEIGHT]
	into IMS.FACT
	from IMS.LATEST_IMS_DATA_VIEW
	cross apply
	(VALUES
	' + @cross_apply_values + '
	) a (FACT_MONTH, UNITS, VALUE_STG, VOLUME, NET_WEIGHT)';

        EXEC sys.sp_executesql @cross_apply_values;

        IF OBJECT_ID('IMS.FACT') IS NULL
            THROW 50022, 'sp_create_ims_fact_tbl: IMS.FACT was not created.', 1;
    END TRY
    BEGIN CATCH
        DECLARE @err nvarchar(2048) = CONCAT('sp_create_ims_fact_tbl failed at line ',
                                             ERROR_LINE(), ': ', ERROR_MESSAGE());
        THROW 50023, @err, 1;
    END CATCH
END
GO
