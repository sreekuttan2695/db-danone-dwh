CREATE view [tst].[view_sales_file] as
--geog_id 82 = Tesco Online; geog_id 84 = Sainsbury Online
with
	prod_ids as
	(
		select
			prodid
		,	iricode	=	l10name
		,	swcode	=	case --if these are Sainsbury or Tesco PL codes then remove the 27 coding
							when
								l10name like '27_011%' or l10name like '27_052%' or l10name like '27_008%' 
							then
								concat('00000',right(l10name,7))
						else
							stuff(l10name,3,1,'')
						end
		,	prodkey	=	stuff(l10name,3,1,'')
		 from
			rdw.master_prod
		where
			catid			in	(4093,4101)
		and	prodhierid		in	(1,3)
		and	is_llvl			=	1
		and	left(l10name,1)	<>	'I'
	)
-- select * from prod_ids /* 4212 rows
,	tes_ecom as
	(
		select distinct
			d.geogid
		,	ret				=	'tes'
		,	cff_geogid		=	'00001'
		,	d.timeid
		,	d.prodid
		,	p.iricode
		,	p.prodkey
		--,	barcode			=	bc.bc_13
		,	p.swcode
		,	unit_sales		=	d.M00001011_Unit_Sales
		,	val_sales		=	d.M00001013_Val_Sales
		,	unit_price		=	d.M00001041_Unit_Price
		--,	t.IRIWeek
		--,	cff_output		=
		--	concat
		--	(
		--		bc.bc_13
		--	,	'00001'
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001011_Unit_Sales,0)),11)
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001013_Val_Sales,0)),11)
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001041_Unit_Price*100,0)),11)
		--	)
		from
			[ecom].[view_current_build_fact_tes] d
		--join
		--	[rdw].[master_time_iri_xref] t  on cast(t.time_key as int)=d.TIMEID
		join
			prod_ids p on p.prodid=d.prodid
--		cross apply
--			get_bc(p.prodkey) bc	-- barcode inc 27 code used for 13-digit code in MASTER and SALES files
--									-- at David Russell's request
----			get_bc(p.swcode) bc
		where
			d.geogid		=	82
		and	len(d.timeid)	=	7
		and left(d.timeid,1)=	'1'
	)
-- select * from tes_ecom /*
,	jsb_ecom as
	(
		select distinct
			d.geogid
		,	ret			=	'jsb'
		,	cff_geogid	=	'00002'
		,	d.timeid
		,	d.prodid
		,	p.iricode
		,	p.prodkey
		--,	barcode		=	bc.bc_13
		,	p.swcode
		,	unit_sales	=	d.M00001011_Unit_Sales
		,	val_sales	=	d.M00001013_Val_Sales
		,	unit_price	=	d.M00001041_Unit_Price
		--,	t.IRIWeek
		--,	cff_output	=
		--	concat
		--	(
		--		bc.bc_13
		--	,	'00002'
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001011_Unit_Sales,0)),11)
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001013_Val_Sales,0)),11)
		--	,	'+'
		--	,	right(concat('00000000000',round(d.M00001041_Unit_Price*100,0)),11)
		--	)
		from
			[ecom].[view_current_build_fact_sai] d
		--join
		--	[rdw].[master_time_iri_xref] t  on cast(t.time_key as int)=d.TIMEID
		join
			prod_ids p on p.prodid=d.prodid
--		cross apply
--			get_bc(p.prodkey) bc	-- barcode inc 27 code used for 13-digit code in MASTER and SALES files
--									-- at David Russell's request
----			get_bc(p.swcode) bc
		where
			d.geogid		=	84
		and	len(d.timeid)	=	7
		and left(d.timeid,1)=	'1'
		and	d.is_llvl		=	1
	)
-- select * from jsb_ecom /*

select
	ae.geogid
,	ae.ret
,	ae.cff_geogid
,	ae.timeid
,	ae.prodid
,	ae.iricode
,	ae.prodkey
,	barcode		=	bc.bc_13
,	ae.swcode
,	ae.unit_sales
,	ae.val_sales
,	ae.unit_price
,	t.IRIWeek
,	cff_output	=
	concat
	(
		bc.bc_13
	,	'00002'
	,	'+'
	,	right(concat('00000000000',round(ae.unit_sales,0)),11)
	,	'+'
	,	right(concat('00000000000',round(ae.val_sales,0)),11)
	,	'+'
	,	right(concat('00000000000',round(ae.unit_price*100,0)),11)
	)
,	cff_filename	=	concat('infoscan.',cast(t.iriweek as varchar),'.sl1.SALES')
from
(
	select * from jsb_ecom
	union all
	select * from tes_ecom
) ae
join
	rdw.master_time_iri_xref t on cast(t.time_key as int) = ae.timeid
cross apply
	get_bc(ae.prodkey) bc	-- barcode inc 27 code used for 13-digit code in cff MASTER and SALES files at David Russell's request
where
	t.iriweek > 1977
