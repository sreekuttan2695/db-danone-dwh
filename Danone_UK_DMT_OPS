Create FUNCTION [dbo].[checkdig]
	(@barcode char(12))
RETURNS int
AS
BEGIN
  DECLARE @dig AS int

select @dig = ltrim(right(10 - right(((Cast(Left(right(rtrim(@barcode), 11),1) as int) +
	Cast(Left(right(rtrim(@barcode), 9),1) as int) +
	Cast(Left(right(rtrim(@barcode), 7),1) as int) + 
	Cast(Left(right(rtrim(@barcode), 5),1) as int) +
	Cast(Left(right(rtrim(@barcode), 3),1) as int) +
	Cast(Left(right(rtrim(@barcode), 1),1) as int)) * 3) + 
	Cast(Left(right(rtrim(@barcode), 12),1) as int) +
	Cast(Left(right(rtrim(@barcode), 10),1) as int) +
	Cast(Left(right(rtrim(@barcode), 8),1) as int) +
	Cast(Left(right(rtrim(@barcode), 6),1) as int) +
	Cast(Left(right(rtrim(@barcode), 4),1) as int) +
	Cast(Left(right(rtrim(@barcode), 2),1) as int), 1), 1)) 
  RETURN @dig
END



