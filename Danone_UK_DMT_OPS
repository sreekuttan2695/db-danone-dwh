/****** Object:  StoredProcedure [dbo].[wait_until_job_completes]    Script Date: 30/09/2026 07:46:40 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
--/*
create proc [dbo].[wait_until_job_completes]

	@check_job_name	varchar(500)
,	@wait_interval	varchar(8)	=	'00:00:10'
,	@report_cycles	int			=	6

as

---------------------------------------------------------------
/*TEST HERE
exec msdb.dbo.sp_start_job 'RunFor5'
--exec PG_OPS.dbo.CheckJobCompletion 'RunFor5'
exec PG_OPS.dbo.CheckJobCompletion 'Back Up Database - PG_DATA_LIVE1'
*/
---------------------------------------------------------------

declare	@str_err_msg	nvarchar(100)	=	convert(nvarchar,getdate(),120) + ' -> started checking job ' + @check_job_name
declare	@wait_cycle		int				=	0

raiserror(@str_err_msg, 0, 1) with nowait

waitfor delay @wait_interval

while exists
(
select
	0
from
	sys.dm_exec_sessions a 
join
	msdb.dbo.sysjobs b on b.job_id = cast(convert(binary(16),substring(a.[program_name],30,34),1) as uniqueidentifier) 
where
	a.[program_name]	like	'SQLAgent - TSQL JobStep (Job % : Step %)'
and	b.[name]			=		@check_job_name
)
begin
	if	@wait_cycle	=	@report_cycles begin
		select	@str_err_msg	=	convert(nvarchar,getdate(),120) + ' -> waiting for job ' + @check_job_name
		raiserror(@str_err_msg, 0, 1) with nowait
		select	@wait_cycle	=	0
		end
	else
		set @wait_cycle	+=	1

	waitfor delay @wait_interval

end

waitfor delay '00:00:05'

select	@str_err_msg	=	convert(nvarchar,getdate(),120) + ' -> finished checking job ' + @check_job_name

raiserror(@str_err_msg, 0, 1) with nowait
GO
