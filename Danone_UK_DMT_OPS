create proc [BUP].[UPDATE_TIME_MASTER] as

--THIS BUP VERSION HAS A YTD FLAW WHICH MAY MEAN YTD DOES NOT WORK CORRECTLY
--Maintain the TIME dimension for the database

--Time is different from the other dimensions in that IDs can be wiped out and "re-used" because of its use of native keys for time ID...

--First create a union view of all time load tables, to get a complete picture of all time periods loaded
declare @dynsql nvarchar(max)

IF EXISTS (SELECT * FROM sys.views WHERE object_id = OBJECT_ID(N'[RDW].[view_all_loaded_times]'))
  DROP VIEW [RDW].[view_all_loaded_times]

--for debugging purposes refresh the time provenance view
exec rdw.update_time_provenance_view 
-- output can be seen using select * from rdw.view_loaded_time_provenance

select @dynsql=N'CREATE VIEW [RDW].[view_all_loaded_times] AS '
              +STUFF((select N' UNION select TIME_KEY, LONGNAME from ' + T.TABLE_SCHEMA + N'.' + T.TABLE_NAME
                      from INFORMATION_SCHEMA.TABLES T 
                      where T.TABLE_NAME like 'LOAD_TBL_TIME%'
                      AND EXISTS (select 1 from RDW.LOAD_MASTER M
                                  where M.TIME_LOADED=1 AND M.T2FILE_ID=REPLACE(t.table_name, 'LOAD_TBL_TIME_',''))
                      for xml path ('')),1,7,'')
print @dynsql
exec sp_executesql @dynsql

--Refresh the view that sits over the top of the loaded time data and puts nice tidy labels on
exec sp_refreshview N'[RDW].[MASTER_TIME_UPDATE_VIEW]'

--Update the master time table from the refreshed view
truncate table [RDW].[MASTER_TIME]

insert into [RDW].[MASTER_TIME](EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL)
select EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL from RDW.MASTER_TIME_UPDATE_VIEW

--New code to cope with insertion of YTD time periods; added by Chris Westgate on Sept 5 2017

declare @ytd_time_key		varchar(12)=null
declare @ytd_yag_time_key	varchar(12)=null

--This is self-regulating because by the time YTD is 8 or 12 weeks there will be 2 4 week periods that will not appear in #find_ytd
--...and once YTD is >12 weeks there should be more than 1 12 week time period so 12 will not appear in #find_ytd
-- AMENDED by Chris Westgate 10 April 2018 - logic is flawed - since the time periods are "rolling" 13s (not 12s now as 445 schedule)
-- the below logic does not work. skip next comment block, new method below
/*
select latest_wg=rank() over (partition by left(time_key,3) order by count(0), cast(substring(time_key,4,2) as int) desc)
, week_group=left(time_key,3), wg_year=substring(time_key,4,2), num_wg_in_year=count(0) 
into #find_ytd
from rdw.view_all_loaded_times 
where left(time_key,3) not in ('001','005')
--only get for non-single-week-groups where end date is in the max year
and cast(substring(time_key,4,2) as int)=	(
												select max(cast(substring(time_key,4,2) as int))
												from rdw.view_all_loaded_times
											)
group by left(time_key,3),substring(time_key,4,2)
having count(0)=1 --only where a single instance of a "week group" appears in latest year

--Note there has not been a chance to try this logic properly yet, this will only be possible at the start of a new year.
--YTD must be the smallest week grouping that only has 1 time period in the given year. The query below should rank it at ytd=1,
--from the temp table created above which excludes single weeks and five-week periods.
--This WOULD normally be a place where 445 intervention might be required but hopefully this will work for 444 or 445 because of the
--exclusion of 5 week periods in the population of the temp table above.
  select @ytd_time_key=t.time_key 
  from rdw.view_all_loaded_times t
  join (	select ytd=rank() over (order by week_group, wg_year desc), latest_wg, week_group, wg_year, num_wg_in_year
			from #find_ytd) y on y.week_group=left(t.time_key,3) and y.wg_year=substring(t.time_key,4,2)
  where y.ytd=1*/

-- new method of establishing YTD time period is simple. 
-- From all non-single, non 5-week time periods, select the smallest week grouping that has a time_key date equal to the latest (max)
-- time key in the all loaded times view
	select
		@ytd_time_key	=	'017180422' --TIME_KEY
	from
		(
			select
				ytd	=	rank() over (order by cast(time_key as int))
			,	TIME_KEY
			,	LONGNAME
			from
				rdw.view_all_loaded_times
			where	1=1
				and	left(time_key,3) not in ('001','005')
				and right(time_key,6)	=	(	select
													max(cast(right(time_key,6) as int))
												from
													rdw.view_all_loaded_times
											)
		) lat_ytd
	where
		ytd	=	1

	--having established YTD must then establish YTD YAG
	select @ytd_yag_time_key = left(@ytd_time_key,3) + convert(varchar,dateadd(dd,-364,cast(replace(@ytd_time_key,left(@ytd_time_key,3),'20') as date)),12)

--If rows for YTD or YTD YAG time keys already exist, update their shortname to reflect their YTD status
--if rows with the identified time keys do not exist, insert records to RDW.MASTER_TIME for YTD and YTD_YAG
	merge rdw.master_time t
	using	(
				select	EndDate		=	dateadd(dd,-1,cast('20' + right(RTRIM(TIME_KEY),6) as date))
,						TIME_KEY	=	rtrim(time_key)
,						TIME_SORT	=	rtrim(time_key)
,						LONGNAME	=	rtrim(LONGNAME)
,						SHORTNAME	=	'YTD' + case when time_key=@ytd_yag_time_key then ' YAG' else '' end
,						TimeLabel	=	LEFT(LONGNAME,2)+' w/e ' + convert(varchar,dateadd(dd,-1,cast('20' + right(RTRIM(TIME_KEY),6) as date)),106)
,						TLEVEL		=	LEFT(LONGNAME,2)+'WEEK' 
				from
					rdw.view_all_loaded_times
				where	1=1
					and TIME_KEY in (@ytd_time_key, @ytd_yag_time_key)
			) y
	on y.time_key=t.time_key

	when matched then
		update set t.shortname=y.shortname
	when not matched then
		insert (EndDate, TIME_KEY, TIME_SORT, LONGNAME, SHORTNAME, TimeLabel, TLEVEL)
		values (y.EndDate, y.TIME_KEY, y.TIME_SORT, y.LONGNAME, y.SHORTNAME, y.TimeLabel, y.TLEVEL);

--drop table #find_ytd
GO
