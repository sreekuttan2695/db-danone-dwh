CREATE VIEW [ma_monetdb].[mdm_prod_mapping_Adeel] as


with AllIMSProds as (select
Prod_Source = src,
p.[IMS_Pack], 
a.EAN,
a.iricode14,
p.[Category], 
p.[Sub_Category_1], 
p.[Sub_Category_2], 
p.[Manufacturer], 
p.[Brand], 
p.[Product], 
p.[Format]

from [ma_monetdb].[view_xref_ims_prods] a
right join RDW.IMS_AVP b on a.ProdDesc = b.ATR_VALUE and b.ATR_NAME = 'IMS PACK'
inner join IMS.DIM_PROD p on b.atr_value = p.IMS_Pack
--order by src ,p.IMS_Pack
)
-- select * from IntegratedIMSProds /*
,    NotAsYetIntegrated as (select * from AllIMSProds)

-- select * from NotAsYetIntegrated /*
,    FactDataForIMSNAYI as (select Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack, FACT_MONTH, UNITS=cast(replace(UNITS,',','') as int)
                                 , ValSales = cast(cast(VALUE_STG as float) as int)
                            from IMS.FACT_UK 
                            where IMS_Pack in (select IMS_Pack from NotAsYetIntegrated))
-- select * from FactDataForIMSNAYI /*
,    FactsWithoutZeroes as (select * from FactDataForIMSNAYI) --where UNITS <> 0 and CONVERT(int, cast(ValSales as float)) <> 0)
-- select distinct IMS_Pack from FactsWithoutZeroes /*
,    Potential_MapProds as (select Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack
							, earliestsale = 'MTH' + convert(varchar , MIN(convert(int,right(FACT_MONTH,2) + SUBSTRING(FACT_MONTH,4,2))) )
							, latest_sale = 'MTH' + convert(varchar , MAX(convert(int,right(FACT_MONTH,2) + SUBSTRING(FACT_MONTH,4,2))) )
							, NumSaleMonths = COUNT(distinct FACT_MONTH)
							, units = sum(UNITS), val = sum(ValSales) 
							from FactsWithoutZeroes
							group by Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack
--							having SUM(valsales) > 10000 or COUNT(distinct fact_month) < 7
							)
-- select * from Potential_MapProds /*
 
select IMS_Pack, units=cast(units as varchar), val=cast(val as varchar), NumSaleMonths=cast(NumSaleMonths as varchar)
, earliestsale = 'MTH' + right(earliestsale, 2) + SUBSTRING(earliestsale,4,2)
, latest_sale = 'MTH' + right(latest_sale,2) + SUBSTRING(latest_sale,4,2)
, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [FORMAT]
from Potential_MapProds
--order by val desc
