CREATE VIEW [RDW].[master_time_ims_lkup_Adeel_bkp] as

WITH alltimeperiods
     AS (SELECT Datediff(ww, '1979-09-01', CONVERT(DATE, Replace(imsweek, 'w/e '
                                                         , '')))
                IRIWeek,
                *
         FROM   rdw.ims_master_time
         WHERE  imsweek IS NOT NULL),
     all_iri_weeks
     AS (SELECT imsmonth,
                datestamp,
                slt.iriweek
         FROM   alltimeperiods stp
                JOIN [uksqlwp09\bld1].sl_time.dbo.sl_week slt
                  ON stp.iriweek = slt.iriweek),
     week_days
     AS (SELECT dow=0
         UNION ALL
         SELECT dow=1
         UNION ALL
         SELECT dow=2
         UNION ALL
         SELECT dow=3
         UNION ALL
         SELECT dow=4
         UNION ALL
         SELECT dow=5
         UNION ALL
         SELECT dow=6),
     allwkdays
     AS (SELECT DayDate=Dateadd(dd, -d.dow, e.datestamp),
                EndDate=e.datestamp,
                TIME_KEY=CONVERT(VARCHAR, e.datestamp, 112),
				iriweek,
				imsmonth
         FROM   all_iri_weeks e,
                week_days d)
SELECT daydate,
       enddate,
       time_key,
	   iriweek,
	   imsmonth,
       MonthN = Month(daydate),
       ndays=Datediff(day, Dateadd(day, 1 - Day(daydate), daydate),
                   Dateadd(month, 1, Dateadd(day, 1 - Day(daydate), daydate)))
FROM   allwkdays 
