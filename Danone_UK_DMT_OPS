-- =============================================
-- Author:		Chris Westgate
-- Create date: 28 Sep 2020
-- Description:	Returns 1 week of catdesc file data from Tesco and Sainsbury E-Commerce data sent by Danone for specified week
-- Change:		27 Nov 2020 ueacw - restriction so JS data is not included beyond IRI week 2150 as Danone purchased JS Online from IRI
-- Change:		10 Dec 2020 ueacw - temporarily include "rolled forward" JS data because of gap between Danone's purchase and IRI's ability to fulfil in MA
-- Change:		Jan 2021 ueacw	  - instead of rolled forward Danone-supplied JS data, bring through JS online data from Tape 2 files for weeks 2151 onwards
-- Change:		Jan 2021 ueacw    - MA is populated with JS Online data directly from the warehouse, prevent JS data coming through completely
-- =============================================
CREATE FUNCTION [ma_cff].[ufn_1week_catdesc_file_data_CW] 
(	
	-- Add the parameters for the function here
	@iriweek int
)
RETURNS TABLE 
AS
RETURN 
(
with
	all_cc as
	(
		select
			*
		from
			ma_cff.ufn_1week_master_file_data(@iriweek)
	)
,	tes_cc as
	(
		select
			geog_id		=	'tes'
		,	cc.com_lvl
		,	cd.r
		,	cd.MinTime
		,	cd.MaxTime
		,	cc_level	=	right(cc.com_lvl,1)
		,	cf_code		=	cd.code
		,	ef_code		=	cd.code
		,	cd.cat_desc
		from
		(
			select distinct com_lvl='COM1', code=left(comm1,2) from all_cc where geog_id='tes'
			union all
			select distinct com_lvl='COM2', code=left(comm1,3) from all_cc where geog_id='tes'
			union all
			select distinct com_lvl='COM3', code=left(comm1,4) from all_cc where geog_id='tes'
			union all
			select distinct com_lvl='COM4', code=left(comm1,5) from all_cc where geog_id='tes'
		) cc
		join --tst.tes_catdesc cd on cd.code=cc.code
		(	select
				r	=	rank() over (partition by code order by maxtime desc)
			,	*
			from
			(
				select
					*
				from
					ma_cff.tes_catdesc
			) tcd
		) cd on cd.code=cc.code
		where
			cd.r	=	1
	)
-- select * from tes_cc /*
,	jsb_cc as
	(
		select
			geog_id		=	'jsb'
		,	cc.com_lvl
		,	cd.r
		,	cd.MinTime
		,	cd.MaxTime
		,	cc_level	=	right(cc.com_lvl,1)
		,	cf_code		=	cd.code
		,	cc.ef_code
		,	cd.cat_desc
		from
		(
			select distinct com_lvl='COM1', code=comm1,	ef_code=cast(cast(comm1 as int) as varchar) from all_cc where geog_id='jsb'
			union all
			select distinct com_lvl='COM2', code=concat(comm1,comm2), ef_code=concat(cast(comm1 as int),'|',cast(comm2 as int)) from all_cc where geog_id='jsb' --43 rows
		) cc
	join
	(	select
			r	=	rank() over (partition by code order by maxtime desc)
		,	*
		from
		(
			select
				*
			from
				ma_cff.jsb_catdesc
		) jcd
	) cd on cd.code=cc.code
	where
		cd.r		=	1
	and	@iriweek	<	2151	-- NB week 2151 put in here on 27 Nov 2020 because Danone will purchase JS online data from IRI 
								-- from week 2151 onwards and we must not include anything specifically only related to JS
								-- for subsequent weeks where it is not required, i.e. from week 2151 onwards
	)
-- select * from jsb_cc /*
--,	jsb_temp_rollforward_cc as
--	(
--		select
--			geog_id		=	'jsb'
--		,	cc.com_lvl
--		,	cd.r
--		,	cd.MinTime
--		,	cd.MaxTime
--		,	cc_level	=	right(cc.com_lvl,1)
--		,	cf_code		=	cd.code
--		,	cc.ef_code
--		,	cd.cat_desc
--		from
--		(
--			select distinct com_lvl='COM1', code=comm1,	ef_code=cast(cast(comm1 as int) as varchar) from all_cc where geog_id='jsb'
--			union all
--			select distinct com_lvl='COM2', code=concat(comm1,comm2), ef_code=concat(cast(comm1 as int),'|',cast(comm2 as int)) from all_cc where geog_id='jsb' --43 rows
--		) cc
--	join
--	(	select
--			r	=	rank() over (partition by code order by maxtime desc)
--		,	*
--		from
--		(
--			select
--				*
--			from
--				ma_cff.jsb_catdesc
--		) jcd
--	) cd on cd.code=cc.code
--	where
--		cd.r		=	1
--	and	@iriweek	>	2150	-- NB week 2151 put in here on 27 Nov 2020 because Danone will purchase JS online data from IRI 
--								-- from week 2151 onwards and we must not include anything specifically only related to JS
--								-- for subsequent weeks where it is not required, i.e. from week 2151 onwards
--	)
-- select * from jsb_temp_rollforward_cc /*

	select
		acc.*
	,	iriweek			=	@iriweek
	,	cff_output		=	concat(com_lvl,cff_code,cast(cat_desc as char(50)))
	,	cff_filename	=	concat('infoscan.',@iriweek,'.sl1.CATDESC')
	,	ecf_output		=	concat
							(
								right(com_lvl,1)	,	char(9)
							,	ecf_code			,	char(9)
							,	ecf_parent			,	char(9)
							,	cat_desc
							)
	,	ecf_filename	=	concat('common.uk.',@iriweek,'.sl1.CATDESC')
	from
	(
		select *, cff_code=cast(left(cf_code,2) as char(24)), ecf_code=left(cf_code,2), ecf_parent='' from tes_cc where com_lvl='COM1'
		union all
		select *, cff_code=cast(concat(cast(left(cf_code,2) as char(6)),cast(left(cf_code,3) as char(6))) as char(24)), ecf_code=concat(left(cf_code,2),'|',left(cf_code,3)), ecf_parent=left(cf_code,2) from tes_cc where com_lvl='COM2'
		union all
		select *, cff_code=cast(concat(cast(left(cf_code,2) as char(6)),cast(left(cf_code,3) as char(6)),cast(left(cf_code,4) as char(6))) as char(24)), ecf_code=concat(left(cf_code,2),'|',left(cf_code,3),'|',left(cf_code,4)), ecf_parent=concat(left(cf_code,2),'|',left(cf_code,3)) from tes_cc where com_lvl='COM3'
		union all
		select *, cff_code=concat(cast(left(cf_code,2) as char(6)),cast(left(cf_code,3) as char(6)),cast(left(cf_code,4) as char(6)),cast(left(cf_code,5) as char(6))), ecf_code=concat(left(cf_code,2),'|',left(cf_code,3),'|',left(cf_code,4),'|',left(cf_code,5)), ecf_parent=concat(left(cf_code,2),'|',left(cf_code,3),'|',left(cf_code,4)) from tes_cc where com_lvl='COM4'
		union all
		select *, cff_code=cast(cf_code as char(24)), ecf_code=ef_code, ef_parent='' from jsb_cc where com_lvl='COM1'
		union all
		select *, cff_code=cast(cf_code as char(24)), ecf_code=ef_code, ef_parent=left(ef_code,charindex('|',ef_code)-1) from jsb_cc where com_lvl='COM2'
		--union all
		--select *, cff_code=cast(cf_code as char(24)), ecf_code=ef_code, ef_parent='' from jsb_temp_rollforward_cc where com_lvl='COM1'
		--union all
		--select *, cff_code=cast(cf_code as char(24)), ecf_code=ef_code, ef_parent=left(ef_code,charindex('|',ef_code)-1) from jsb_temp_rollforward_cc where com_lvl='COM2'
	) acc
)
