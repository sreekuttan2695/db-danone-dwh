CREATE   VIEW [iqvia].[PRODUCT_EAN_LIST]
/* =============================================================================
   Purpose : One row per IQVIA pack in the current delivery (IMS.dim_prod) with
             its lookup mapping, Danone MDM match and mapping status.
   Grain   : IMS_Pack. GB/UK attribute variants collapse to one row
             (gb_uk_attribute_variants > 1 flags them).
   Change  : 2026-09-23  initial version
   ============================================================================= */
AS
WITH packs AS
(
    SELECT p.IMS_Pack, p.Category, p.Sub_Category_1, p.Sub_Category_2,
           p.Manufacturer, p.Brand, p.Product, p.[Format],
           rn = ROW_NUMBER() OVER (PARTITION BY p.IMS_Pack
                                   ORDER BY p.Category, p.Sub_Category_1, p.Sub_Category_2,
                                            p.Manufacturer, p.Brand, p.Product, p.[Format]),
           attribute_variants = COUNT(*) OVER (PARTITION BY p.IMS_Pack)
    FROM   IMS.dim_prod AS p
    WHERE  p.IMS_Pack IS NOT NULL
),
lkp AS
(
    SELECT l.Prod_Desc,
           lkp_rows    = COUNT(*),
           EAN         = MAX(l.EAN),
           iricode14   = MAX(l.iricode14),
           Prod_Source = MAX(l.Prod_Source),
           mapped_on   = MAX(l.DateStamp)
    FROM   RDW.MASTER_PROD_IMS_LKUP AS l
    WHERE  l.Prod_Desc IS NOT NULL
    GROUP BY l.Prod_Desc
),
mdm AS
(
    SELECT i.iricode13,
           mdm_items    = COUNT(DISTINCT i.item_dim_key),
           item_dim_key = MIN(i.item_dim_key),
           iricode14    = MIN(i.iricode14),
           prod_desc    = MIN(LEFT(CONVERT(nvarchar(4000), i.prod_desc), 255))
    FROM   ma_monetdb.view_item_identifiers AS i
    WHERE  i.iricode13 IS NOT NULL
    GROUP BY i.iricode13
),
sales AS
(
    SELECT f.IMS_Pack,
           latest_yymm = MAX(RIGHT(f.FACT_MONTH, 2) + SUBSTRING(f.FACT_MONTH, 4, 2))
    FROM   IMS.FACT_UK AS f
    WHERE  TRY_CONVERT(decimal(19, 4), f.UNITS) <> 0
    GROUP BY f.IMS_Pack
),
pending AS
(
    SELECT b.Prod_Desc, pending_iricode13 = MIN(b.IRICode13)
    FROM   iqvia.new_products_barcode AS b
    WHERE  b.Prod_Desc IS NOT NULL
    GROUP BY b.Prod_Desc
)
SELECT Prod_Desc                = pk.IMS_Pack,
       mapping_status           = CASE
                                      WHEN ISNULL(l.lkp_rows, 0) = 0 AND x.is_excluded = 1        THEN 'EXCLUDED_CATEGORY'
                                      WHEN ISNULL(l.lkp_rows, 0) = 0 AND pd.Prod_Desc IS NOT NULL THEN 'BARCODE_ASSIGNED_NOT_MERGED'
                                      WHEN ISNULL(l.lkp_rows, 0) = 0                              THEN 'UNMAPPED'
                                      WHEN l.lkp_rows > 1                                         THEN 'DUPLICATE_MAPPING'
                                      WHEN m.iricode13 IS NULL                                    THEN 'MAPPED_NOT_IN_MDM'
                                      WHEN m.mdm_items > 1                                        THEN 'MAPPED_MDM_AMBIGUOUS'
                                      WHEN ISNULL(m.iricode14, '') <> ISNULL(l.iricode14, '')     THEN 'MAPPED_CODE14_MISMATCH'
                                      ELSE 'MAPPED'
                                  END,
       Prod_Source              = CASE WHEN l.lkp_rows = 1 THEN l.Prod_Source END,
       EAN                      = CASE WHEN l.lkp_rows = 1 THEN l.EAN END,
       iricode14                = CASE WHEN l.lkp_rows = 1 THEN l.iricode14 END,
       mapped_on                = CASE WHEN l.lkp_rows = 1 THEN l.mapped_on END,
       lookup_rows              = ISNULL(l.lkp_rows, 0),
       mdm_item_dim_key         = m.item_dim_key,
       mdm_prod_desc            = m.prod_desc,
       pending_iricode13        = CASE WHEN ISNULL(l.lkp_rows, 0) = 0 THEN pd.pending_iricode13 END,
       latest_sale_month_uk     = CASE WHEN s.latest_yymm IS NOT NULL
                                       THEN 'MTH' + RIGHT(s.latest_yymm, 2) + LEFT(s.latest_yymm, 2) END,
       pk.Category,
       pk.Sub_Category_1,
       pk.Sub_Category_2,
       pk.Manufacturer,
       pk.Brand,
       pk.Product,
       pk.[Format],
       gb_uk_attribute_variants = pk.attribute_variants
FROM   packs AS pk
LEFT JOIN lkp     AS l  ON l.Prod_Desc  = pk.IMS_Pack
LEFT JOIN mdm     AS m  ON m.iricode13  = l.EAN
                       AND l.lkp_rows   = 1
LEFT JOIN sales   AS s  ON s.IMS_Pack   = pk.IMS_Pack
LEFT JOIN pending AS pd ON pd.Prod_Desc = pk.IMS_Pack
CROSS APPLY (SELECT is_excluded = CASE WHEN EXISTS (SELECT 1
                                                    FROM   RDW.excluded_IMS_categories AS e
                                                    WHERE  e.category = pk.Category)
                                       THEN 1 ELSE 0 END) AS x
WHERE  pk.rn = 1;
GO
