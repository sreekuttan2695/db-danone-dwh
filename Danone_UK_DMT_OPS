	(
	select * from tst.upd_stb_gen_history
	)
-- select * from stb_gen_hist h join stubprods p on p.prodkey=h.prodkey and p.gencode=h.generation /*
     --mxgencode as (select prodkey, MAX(gencode) mgencode
     --              from stubprods group by PRODKEY),
     --mgcswcode as (select * from stubprods s where exists (select 1 from mxgencode m where m.PRODKEY=s.PRODKEY and m.mgencode=s.GenCode)),
,     masterprd as (select * from rdw.MASTER_PROD where CatID<>9999 and ProdHierID in (1,3) and IS_LLVL=1)

select h.iricode, h.WEEK_FIRST_MOVED, h.WEEK_LAST_MOVED, 
sp.SWCODE, P.* from masterprd P
join stubprods sp on stuff(sp.prodkey,3,0,sp.gencode)=p.L10Name
