create view [redslim].[eib_and_tape2_3] as

select
	d.rn
,	d.ORIGINAL_KEY
,	d.TIME_KEY
,	d.GEOG_KEY
,	d.PROD_KEY
,	GT1_tape2_units		=	d.M00001011_Unit_Sales
,	GT1_EIB_units		=	o.EIBUnit
,	GT1_domestic_units	=	d.M00001011_Unit_Sales	-	o.EIBUnit
,	GT1_neg_unit_flag	=	case when d.M00001011_Unit_Sales	-	o.EIBUnit < 0 then -1 else null end
,	GT1_tape2_val		=	d.M00001013_Val_Sales
,	GT1_EIB_val			=	o.EIBValue
,	GT1_domestic_value	=	d.M00001013_Val_Sales	-	o.EIBValue
,	GT1_neg_val_flag	=	case when d.M00001013_Val_Sales		-	o.EIBValue < 0 then -1 else null end
,	GT1_tape2_volume	=	d.M00001012_Vol_Sales
,	GT1_EIB_volume		=	o.EIBVolume
,	GT1_domestic_volume	=	d.M00001012_Vol_Sales	-	o.EIBVolume
,	GT1_neg_vol_flag	=	case when d.M00001012_Vol_Sales		-	o.EIBVolume < 0 then -1 else null end
,	d.M00001011_Unit_Sales
,	d.M00001013_Val_Sales
,	d.M00001012_Vol_Sales
,	d.M00008990_CWD_Wtd_Dist
,	d.M00002020_ACV_Wtd_Dist
,	d.M00003010_pc_Stores_Selling
,	d.M00001041_Unit_Price
,	d.M00001042_Vol_Price
from
	redslim.LOAD_TBL_FACT_3 d
join
	(select TIME_KEY from RDW.MASTER_TIME where TLEVEL in ('04WEEK','05WEEK')) t on t.time_key=d.time_key
left outer join 
	redslim.view_fact_eib_prodagg_3 o on o.EIB_join_key=d.original_key
where
	d.GEOG_KEY in ('502141','502142','502143')
