-- =============================================
-- Author:		Chris Westgate
-- Create date: 5 May 2020
-- Description:	Returns a string with a constructed query to link EIB data and tape 2 keys
-- =============================================
CREATE FUNCTION [redslim].[ufn_fact_eib_prodagg_view_sql_template]
(	
	-- Add the parameters for the function here
	@meas_tbl_name			nvarchar(max)
,	@eib_timeagg_tbl_name	nvarchar(max)
,	@fact_tbl_name			nvarchar(max)
)
RETURNS TABLE 
AS
RETURN 
(
select	eib_prodagg_view_sql = 
N'with
	EIB_all_level_keys_at_lowest_level as
	(
		select
			ll_key	=	concat	(	d.catid
								,	d.time_key
								,	d.geog_key
								,	case 
										when right(d.prod_key,34)=replicate(''0'',34) then	''101''
										when right(d.prod_key,31)=replicate(''0'',31) then	''202''
										when right(d.prod_key,28)=replicate(''0'',28) then	''303''
										when right(d.prod_key,25)=replicate(''0'',25) then	''404''
										when right(d.prod_key,22)=replicate(''0'',22) then	''505''
										when right(d.prod_key,19)=replicate(''0'',19) then	''606''
										when right(d.prod_key,16)=replicate(''0'',16) then	''707''
										when right(d.prod_key,13)=replicate(''0'',13) then	''808''
										else												''900''
									end
								,	d.prod_key
								,	left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4)
								) --[win0287\bld1].danone_uk_dmt_ops.stg.load_tbl_meas_10),4))
              ,      l8_key =	concat(d.catid,d.time_key,d.geog_key,''808'',left(d.prod_key,24),REPLICATE(''0'',13),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l7_key =	concat(d.catid,d.time_key,d.geog_key,''707'',left(d.prod_key,21),REPLICATE(''0'',16),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l6_key =	concat(d.catid,d.time_key,d.geog_key,''606'',left(d.prod_key,18),REPLICATE(''0'',19),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l5_key =	concat(d.catid,d.time_key,d.geog_key,''505'',left(d.prod_key,15),REPLICATE(''0'',22),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l4_key =	concat(d.catid,d.time_key,d.geog_key,''404'',left(d.prod_key,12),REPLICATE(''0'',25),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l3_key =	concat(d.catid,d.time_key,d.geog_key,''303'',left(d.prod_key, 9),REPLICATE(''0'',28),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l2_key =	concat(d.catid,d.time_key,d.geog_key,''202'',left(d.prod_key, 6),REPLICATE(''0'',31),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      l1_key =	concat(d.catid,d.time_key,d.geog_key,''101'',left(d.prod_key, 3),REPLICATE(''0'',34),left(concat(''00'',(select cast(count(1) as varchar) from ' + @meas_tbl_name + N')),4))
              ,      o.OBSUnit     --     EIB Units
              ,      o.OBSValue    --     EIB Value
              ,      o.OBSVolume   --     EIB Volume
              from
                     ' + @eib_timeagg_tbl_name + N' o
              join
                     ' + @fact_tbl_name + N' d on cast(d.time_key as int)=o.TimeID and d.GEOG_KEY=o.GeogID and right(d.PROD_KEY,13)=right(o.PROD_KEY,13)
       )
,      EIB_all_levels_for_grouping
as (
              select
                     join_key=coalesce(ll_key, l8_key, l7_key, l6_key, l5_key, l4_key, l3_key, l2_key, l1_key)
              ,      OBSUnit
              ,      OBSValue
              ,      OBSVolume
              from
                     EIB_all_level_keys_at_lowest_level
              group by GROUPING sets
                     (
                           (OBSUnit, OBSValue, OBSVolume, l1_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key, l5_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key, l5_key, l6_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key, l5_key, l6_key, l7_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key, l5_key, l6_key, l7_key, l8_key),
                           (OBSUnit, OBSValue, OBSVolume, l1_key, l2_key, l3_key, l4_key, l5_key, l6_key, l7_key, l8_key, ll_key)
                     )
       )

select
       EIB_join_key	=	join_key
,      EIBUnit		=	sum(OBSUnit)
,      EIBValue		=	sum(OBSValue)
,      EIBVolume	=	sum(OBSVolume)
from
       EIB_all_levels_for_grouping
group by
       join_key'
)
GO
