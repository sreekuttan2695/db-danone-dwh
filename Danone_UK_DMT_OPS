declare @move_load_jobname nvarchar(50)

select
 @tbl_suffix=convert(nvarchar,T2FILE_ID), @dtsx_filepath=MOVE_LOAD_DTSX_FILEPATH ,@move_load_jobname=MOVE_LOAD_JOBNAME
from RDW.LOAD_MASTER where T2FILE_NAME=@T2_FNAME

