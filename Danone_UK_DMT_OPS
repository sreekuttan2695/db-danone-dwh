CREATE proc [RDW].[UPDATE_GEOG_MASTER] as

--Maintain the GEOG dimension for the database

--First create a union view of all GEOG load tables, to get a complete picture of all geographies loaded
--NOTE deliberate use of UNION not UNION ALL as any geography may be present in multiple load tables
declare @dynsql nvarchar(max)

IF EXISTS (SELECT * FROM sys.views WHERE object_id = OBJECT_ID(N'[RDW].[MASTER_GEOG_UPDATE_VIEW]'))
  DROP VIEW [RDW].[MASTER_GEOG_UPDATE_VIEW]

select @dynsql=N'CREATE VIEW [RDW].[MASTER_GEOG_UPDATE_VIEW] AS '
              + STUFF((select N' UNION select ltrim(rtrim(substring(geog_key,3,99))) GEOG_KEY, ltrim(rtrim(GEOG_NAME)) LONGNAME' + 
                              N', RDW.CleanString(GEOG_NAME,''[^A-Za-z0-9]'') CLEANNAME from ' + T.TABLE_SCHEMA + N'.' + T.TABLE_NAME
                              from INFORMATION_SCHEMA.TABLES T 
                              where T.TABLE_NAME like 'LOAD_TBL_GEOG%'
                              AND EXISTS (select 1 from RDW.LOAD_MASTER M
                                          where M.GEOG_LOADED=1 AND M.T2FILE_ID=REPLACE(t.table_name, 'LOAD_TBL_GEOG_',''))
                              for xml path ('')),1,7,'')
print @dynsql
exec sp_executesql @dynsql

--Now maintain geography master
insert into RDW.MASTER_GEOG_HISTORY
 (ChangeAction, NEW_GEOG_ID, OLD_GEOG_ID, NEW_GEOG_KEY, OLD_GEOG_KEY, NEW_LONGNAME, OLD_LONGNAME, NEW_CLEANNAME, OLD_CLEANNAME, NEW_IN_USE, OLD_IN_USE)
select ChangeAction, NEW_GEOG_ID, OLD_GEOG_ID, NEW_GEOG_KEY, OLD_GEOG_KEY, NEW_LONGNAME, OLD_LONGNAME, NEW_CLEANNAME, OLD_CLEANNAME, NEW_IN_USE, OLD_IN_USE
from
(merge RDW.MASTER_GEOG G using (select * from RDW.MASTER_GEOG_UPDATE_VIEW) V
                         on V.GEOG_KEY=G.GEOG_KEY
 when matched and (G.LONGNAME <> V.LONGNAME or G.CLEANNAME<>V.CLEANNAME) then 
   update set LONGNAME=V.LONGNAME, CLEANNAME=V.CLEANNAME
 when not matched then 
   insert (GEOG_KEY, LONGNAME, CLEANNAME, IN_USE)
   values (V.GEOG_KEY, V.LONGNAME, V.CLEANNAME, 1)
 when not matched by source and G.GEOG_KEY<>'000000' and G.IN_USE<>1 then
   update set IN_USE=0
 output $action, Inserted.GEOG_ID, deleted.GEOG_ID, Inserted.GEOG_KEY, deleted.GEOG_KEY, Inserted.LONGNAME, deleted.LONGNAME
      , Inserted.CLEANNAME, deleted.CLEANNAME, Inserted.IN_USE, deleted.IN_USE)
 as Changes (ChangeAction, NEW_GEOG_ID, OLD_GEOG_ID, NEW_GEOG_KEY, OLD_GEOG_KEY, NEW_LONGNAME, OLD_LONGNAME, NEW_CLEANNAME, OLD_CLEANNAME
           , NEW_IN_USE, OLD_IN_USE);

declare @NonAutoCSDBuildReason varchar(500)

--Put check in place that relevant CSD table is ready in case any new geography clusters have been created
select * into #MissingCSDTables from (select distinct DBN + 'ST.FACT_' + upper(left(cleanname,3)) MT
                                      from Danone_UK_DMT_OPS.rdw.master_geog,
                                      (select 'Danone_UK_DMT_CSD_DB1.' DBN union all select 'Danone_UK_DMT_CSD_DB2.' DBN) a
                                      where GEOG_KEY<>'000000'
                                      except
                                      select * from (select 'Danone_UK_DMT_CSD_DB1.ST.' + table_name MT 
                                      from Danone_UK_DMT_CSD_DB1.information_schema.tables where table_name like '%FACT%'
                                      union all
                                      select 'Danone_UK_DMT_CSD_DB2.ST.' + table_name MT
                                      from Danone_UK_DMT_CSD_DB2.information_schema.tables where table_name like '%FACT%') a
                                      ) T

if exists (select 0 from #MissingCSDTables) begin
  select @NonAutoCSDBuildReason=N'<H2>A new geography cluster was created and the item(s) below are not present:</H2>'
                              + N'<table border="1">'
                              + N'<tr><th>Item Type</th><th>Item Name</th></tr>'
                              + CONVERT(NVARCHAR(MAX),(SELECT VS td,'',
                                                              VN td,''
                                                       FROM #MissingCSDTables
                                                       FOR XML PATH('tr'), TYPE)
                                        )
                              + N'</table>'
  update RDW.PAUSE_AFTER_DATA_PROCESSING set AutoCSDBuild=0, ReasonForNotProceedingToCSDBuild=ReasonForNotProceedingToCSDBuild+@NonAutoCSDBuildReason
end
GO
