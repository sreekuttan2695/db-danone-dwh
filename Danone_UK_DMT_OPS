/****** Object:  StoredProcedure [BUP].[stuff_jsb_ecom_live_before_format_change_20200930]    Script Date: 30/09/2026 07:46:40 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
create proc [BUP].[stuff_jsb_ecom_live_before_format_change_20200930] as begin

declare @status_msg varchar(255)

--1. prep DMT linking data
select @status_msg=convert(varchar,getdate(),126) + '--> preparing DMT linking data'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_fs') is not null drop table ecom.jsb_xrv_fs
select
	timeid
,	prodid
,	fs_val
,	fs_uni
,	fs_vol
into
	ecom.jsb_xrv_fs
from
	ecom.view_jsb_xref_data_fascia_summary

--2. create complete list of weeks and prodids for next step
select @status_msg=convert(varchar,getdate(),126) + '--> creating DMT product list over time'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_all_time_prod') is not null drop table ecom.jsb_xrv_all_time_prod

select distinct
	timeid
,	prodid
into
	ecom.jsb_xrv_all_time_prod
from
	ecom.jsb_xrv_fs

--3 create multi-value table, joined to products to give IRICodes for mapping
select @status_msg=convert(varchar,getdate(),126) + '--> preparing DMT linking data table'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_all_linkable_dmt_data') is not null drop table ecom.jsb_xrv_all_linkable_dmt_data
select
	tp.timeid
,	tp.prodid
,	p.level1
,	p.level1_Attr
,	p.proddesc
,	p.IRICode
,	prod_id = case when IRICode like '27_011%' then '00000' + right(iricode,7) else STUFF(iricode,3,1,'') end
,	fs.fs_val
,	fs.fs_uni
,	fs.fs_vol
into
	ecom.jsb_xrv_all_linkable_dmt_data
from
	ecom.jsb_xrv_all_time_prod tp
join
	(				select prodid, level1, level1_attr, proddesc, iricode from PRD.DIM_PROD_4093 where PLV=9
		union all	select prodid, level1, level1_attr, proddesc, iricode from PRD.DIM_PROD_4101 where PLV=9
	) p on p.prodid=tp.prodid
left outer join
	ecom.jsb_xrv_fs fs on fs.timeid=tp.timeid and fs.prodid=tp.prodid

--4 reduce working size of JS E-Commerce data
select @status_msg=convert(varchar,getdate(),126) + '--> create ecommerce working dataset'
raiserror(@status_msg , 0, 1) with nowait

if object_id(N'ecom.jsb_working_dataset') is not null drop table ecom.jsb_working_dataset
select
	product
,	e_week
,	spend
,	units
,	price_per_pack
into
	ecom.jsb_working_dataset
from
--	danone_uk_dmt_ops.ecom.jsb_backdata --<-- this must have been loaded using new routine...--COMMENTED FOR BACKUP PURPOSES ONLY TO PREVENT COMPILE ERRORS WHEN BACKING UP
	danone_uk_dmt_ops.bup.jsb_ecom_backdata_before_format_change_20200930

--5 create data table with timeid for linking later
select @status_msg=convert(varchar,getdate(),126) + '--> add timeid to ecommerce data'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_data_forlive') is not null drop table ecom.jsb_data_forlive
select
	d.product
,	d.e_week
,	value_sales			=	d.spend
,	unit_sales			=	d.units
,	d.price_per_pack
,	tx.IRIWeek
,	timeid				=	cast(tx.time_key as int)
into
	ecom.jsb_data_forlive
from
	ecom.jsb_working_dataset d 
join
	rdw.MASTER_TIME_IRI_XREF tx on tx.EndDate=d.e_week
order by
	tx.IRIWeek

--6 create list of ecommerce products to be able to create xrefs
select @status_msg=convert(varchar,getdate(),126) + '--> create list of ecommerce products'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_prod_list') is not null drop table ecom.jsb_prod_list
select distinct
	prod_sel	=	right(ltrim(rtrim(product)),charindex(' ',reverse(rtrim(product)))-1)
,	product		=	ltrim(rtrim(product))
into
	ecom.jsb_prod_list
from
	ecom.jsb_working_dataset

if object_id(N'ecom.jsb_products') is not null drop table ecom.jsb_products
select
	prod_sel
,	product_code	=	right('000000000000'+prod_sel,12)
,	prod_name		=	replace(product,' - '+prod_sel,'')
,	product
into
	ecom.jsb_products 
from
	ecom.jsb_prod_list

--7 master summary table to match by product names
select @status_msg=convert(varchar,getdate(),126) + '--> import JSB master summary table from SLDB'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_mst') is not null drop table ecom.jsb_mst
select
	mintime
,	maxtime
,	geog_id
,	prod_id
,	comm1
,	comm2
,	prod_name
into
	ecom.jsb_mst
from
	[uksqlwp09\bld1].sl_jsb.dbo.sl_master_summary_table 

--8 remove duplication from master summary table; latest files received will have latest product descriptions anyway
select @status_msg=convert(varchar,getdate(),126) + '--> remove duplicates from MST'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_mst_nodups') is not null drop table ecom.jsb_mst_nodups
select
	mintime		=	min(mintime)
,	maxtime		=	max(maxtime)
,	prod_id
,	prod_name	=	ltrim(rtrim(replace(Prod_name,'''','')))
into
	ecom.jsb_mst_nodups 
from
	ecom.jsb_mst
group by
	prod_id
,	prod_name

--9 bring across xrefs from shelf edge label tables in SL_JSB db
select @status_msg=convert(varchar,getdate(),126) + '--> import JSB shelf-edge label table from SLDB'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_prod_sel_xref') is not null
	drop table ecom.jsb_prod_sel_xref

create table
	ecom.jsb_prod_sel_xref
	(
		prod_sel		nvarchar(500)	NOT NULL
	,	product_code	nvarchar(12)	NOT NULL
	,	prod_name		nvarchar(4000)	NOT NULL
	,	product			nvarchar(500)	NOT NULL
	,	barcode			varchar(13)		NOT NULL
	,	prod_id			varchar(12)		NOT NULL
	,	wfm				int				NOT NULL
	,	wlm				int				NOT NULL
	)
on [PRIMARY]

insert into
	ecom.jsb_prod_sel_xref
execute
	[uksqlwp09\bld1].sl_jsb.dbo.sp_executesql
N'
select
	prod_sel
,	product_code
,	prod_name
,	product
into
	#prods_for_xref
from
	[win0287\bld1].danone_uk_dmt_ops.ecom.jsb_products

select
	x.prod_sel
,	x.product_code
,	x.prod_name
,	x.product
,	l.barcode
,	prod_id			=	left(l.barcode,12)
,	wfm				=	min(l.iri_week)
,	wlm				=	max(l.iri_week)
from
	shelf_edge_label l
join
	#prods_for_xref x on x.product_code=l.product_code
group by
	x.prod_sel
,	x.product_code
,	x.prod_name
,	x.product
,	l.barcode

drop table #prods_for_xref'

--10 create xref tables to use to link ecom products to multiple potential SWCode, from SEL table and from master summary table
select @status_msg=convert(varchar,getdate(),126) + '--> create ecommerce to DMT prod xref tables'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xref_dups') is not null
	truncate table ecom.jsb_xref_dups

insert into
	ecom.jsb_xref_dups
select
	p.product
,	mintime		=	m.mintime
,	maxtime		=	m.maxtime
,	prod_id		=	m.prod_id
,	prod_name	=	m.prod_name
from
	ecom.jsb_products p --802 rows
join
	ecom.jsb_mst_nodups m on m.Prod_name=p.prod_name --825 rows
where p.product in (select product from ecom.jsb_products
					except
					select product from ecom.jsb_prod_sel_xref)
union all
select
	product
,	wfm
,	wlm
,	prod_id
,	prod_name
from
	ecom.jsb_prod_sel_xref

--11 refresh stub attributes - it should probably be done somewhere else than here as it's also used by stuffing tes ecomm live...
select @status_msg=convert(varchar,getdate(),126) + '--> refresh stub attributes'
raiserror(@status_msg , 0, 1) with nowait
truncate table ecom.stub_attrs
insert into
	ecom.stub_attrs
select
	category
,	prodkey
,	gencode
,	l1name
,	l2name
,	l3name
,	l4name
,	l5name
,	l6name
,	l7name
,	l8name
,	l9name
,	volequiv
,	promotype
,	swcode
from
	[uksqlwp09\bld1].sl_stubs.dbo.stb_library
where
	category in (4093,4101)

--12 create the table linking actual DMT data from potential xref barcodes to JSB product descriptions
--   join preference based on DMT product with highest value sales in the connecting week being ranked as most preferable link
select @status_msg=convert(varchar,getdate(),126) + '--> create xref table with values and linking preferences'
raiserror(@status_msg , 0, 1) with nowait
if object_id(N'ecom.jsb_xrv_data_with_potential_xref_links') is not null drop table ecom.jsb_xrv_data_with_potential_xref_links
select
	ld.timeid
,	ld.prodid
,	ld.level1
,	ld.level1_Attr
,	ld.proddesc
,	ld.IRICode
,	s.volequiv
,	x.prod_id
,	item		=	x.product
,	ld.fs_val
,	ld.fs_uni
,	ld.fs_vol
,	join_val	=	ld.fs_val
,	dmt_value	=	ld.fs_val
,	dmt_units	=	ld.fs_uni
,	dmtvolume	=	ld.fs_vol
,	join_pref	=	rank() over (partition by ld.timeid, x.product order by ld.fs_val desc)
,	xprod		=	x.product
into
	ecom.jsb_xrv_data_with_potential_xref_links
from
	ecom.jsb_xrv_all_linkable_dmt_data ld
join
	ecom.jsb_xref_dups x on x.prod_id = ld.prod_id
join
	ecom.stub_attrs s on stuff(s.stub_prodkey,3,0,s.gencode)=ld.iricode


--13 check correct build DB so following deletes/inserts go to correct database
select @status_msg=convert(varchar,getdate(),126) + '--> set build DB'
raiserror(@status_msg , 0, 1) with nowait
if OBJECT_ID(N'ecom.view_current_build_fact_sai','V') is not null
	drop view ecom.view_current_build_fact_sai

if (select DB_TO_BUILD from RDW.CURRENT_BUILD_CSD) = 'Danone_UK_DMT_CSD_DB1'
	exec sp_executesql N'create view ecom.view_current_build_fact_sai as select * from Danone_UK_DMT_CSD_DB1.st.fact_sai'
else
	exec sp_executesql N'create view ecom.view_current_build_fact_sai as select * from Danone_UK_DMT_CSD_DB2.st.fact_sai'

--14 allow re-run with no issue by deleting any existing JS e-commerce data for geogid 83 and 84 from the CSD database
select @status_msg=convert(varchar,getdate(),126) + '--> remove any JS Instore/Online data from CSD DB'
raiserror(@status_msg , 0, 1) with nowait
if exists(select 1 from ecom.view_current_build_fact_sai where geogid in (83,84))
	delete
		ecd
	from
		ecom.view_current_build_fact_sai ecd
	where
		ecd.geogid in (83,84)

--15 insert leaf level online fact data (geogid 84), joining the online backdata to the relevant DMT products on a week-by-week basis 
--eliminating duplicates xrefs by selecting the referenced EAN with the highest value sales for the given week (WHERE join_pref=1)
select @status_msg=convert(varchar,getdate(),126) + '--> insert leaf level for geogid 84 (Online)'
raiserror(@status_msg , 0, 1) with nowait
insert into
	ecom.view_current_build_fact_sai
	(	geogid
	,	timeid
	,	prodid
	,	plv
	,	is_llvl
	,	M00001011_Unit_Sales
	,	M00001013_Val_Sales
	,	M00001012_Vol_Sales
	,	M00001041_Unit_Price
	,	M00001042_Vol_Price
	)
select
	geogid				=	g.geog_id
,	px.timeid
,	px.prodid
,	plv					=	9
,	is_llvl				=	1
,	od.unit_sales
,	od.value_sales
,	vol_sales			=	od.unit_sales * px.volequiv
,	od.price_per_pack
,	vol_price			=	od.value_sales/((od.unit_sales*1.00)*px.volequiv)
from
	Danone_UK_DMT_OPS.ecom.jsb_xrv_data_with_potential_xref_links px
join
	Danone_UK_DMT_OPS.ecom.jsb_data_forlive od on od.timeid=px.timeid and od.product=px.xprod
join
	Danone_UK_DMT_OPS.rdw.master_geog g on g.longname='Sainsburys Online'
where
	cast(od.unit_sales as float)	<>	cast(0 as float)
and	cast(od.value_sales as float)	<>	cast(0 as float)
and	px.join_pref	=	1

--16 now create the Sainsburys Instore geography, left join total estate to now-existing online, do appropriate calcs
select @status_msg=convert(varchar,getdate(),126) + '--> create data for instore geog 83'
raiserror(@status_msg , 0, 1) with nowait
insert into
	ecom.view_current_build_fact_sai
	(	geogid
	,	timeid
	,	prodid
	,	plv
	,	is_llvl
	,	M00001011_Unit_Sales
	,	M00001013_Val_Sales
	,	M00001012_Vol_Sales
	,	M00001041_Unit_Price
	,	M00001042_Vol_Price)
select
	geogid		=	g.geog_id
,	ld.timeid
,	ld.prodid
,	plv			=	9
,	is_llvl		=	1
,	dmt_units	=	ld.fs_uni - isnull(od.M00001011_Unit_Sales,0)
,	dmt_value	=	ld.fs_val - isnull(od.M00001013_Val_Sales,0)
,	dmtvolume	=	ld.fs_vol - isnull(od.M00001012_Vol_Sales,0)
,	avg_unitp	=	od.M00001041_Unit_Price
,	avg_vol_p	=	od.M00001042_Vol_Price
from
	Danone_UK_DMT_OPS.ecom.jsb_xrv_all_linkable_dmt_data ld
join
	Danone_UK_DMT_OPS.rdw.master_geog g on g.longname='Sainsburys Instore'
left outer join
(
	select
		timeid
	,	prodid
	,	M00001011_Unit_Sales
	,	M00001012_Vol_Sales
	,	M00001013_Val_Sales
	,	M00001041_Unit_Price
	,	M00001042_Vol_Price
	from
		ecom.view_current_build_fact_sai
	where
		geogid	=	84
) od on od.timeid=ld.timeid and od.prodid=ld.prodid

--17 find anywhere where there are negative instore values; correct to zero or remove records
select @status_msg=convert(varchar,getdate(),126) + '--> delete zero or negative instore values'
raiserror(@status_msg , 0, 1) with nowait
truncate table tmp_deleted_jsbnegs 

delete	negfacts
output	deleted.*
into	tmp_deleted_jsbnegs
from	ecom.view_current_build_fact_sai negfacts
where	negfacts.geogid=83 and (negfacts.M00001011_Unit_Sales<0 or negfacts.M00001013_Val_Sales<0)

delete	negfacts
output	deleted.*
into	tmp_deleted_jsbnegs
from	ecom.view_current_build_fact_sai negfacts
where	negfacts.geogid=84 and (negfacts.M00001011_Unit_Sales<0 or negfacts.M00001013_Val_Sales<0)

delete	negfacts
output	deleted.*
into	tmp_deleted_jsbnegs
from	ecom.view_current_build_fact_sai negfacts
where	negfacts.geogid in (83,84) and negfacts.M00001011_Unit_Sales=0

--18 now perform time aggregations for two new created geographies
select @status_msg=convert(varchar,getdate(),126) + '--> perform time aggregations for instore/online'
raiserror(@status_msg , 0, 1) with nowait
insert into
	ecom.view_current_build_fact_sai
	(
		geogid
	,	timeid
	,	prodid
	,	plv
	,	is_llvl
	,	M00001011_Unit_Sales
	,	M00001013_Val_Sales
	,	M00001012_Vol_Sales
	,	M00001041_Unit_Price
	,	M00001042_Vol_Price
	)
select
	d.geogid
,	timeid					=	ta.AggTimeID
,	d.PRODID
,	d.PLV
,	d.IS_LLVL
,	M00001011_Unit_Sales	=	SUM(M00001011_Unit_Sales	)
,	M00001013_Val_Sales		=	SUM(M00001013_Val_Sales		)
,	M00001012_Vol_Sales		=	SUM(M00001012_Vol_Sales		)
,	M00001041_Unit_Price	=	SUM(M00001013_Val_Sales		) / SUM(M00001011_Unit_Sales)
,	M00001042_Vol_Price		=	SUM(M00001012_Vol_Sales		) / SUM(M00001011_Unit_Sales)
from
	ecom.view_current_build_fact_sai d
join
	rdw.master_time_agg ta on ta.WTimeID=d.TIMEID
where
	d.GEOGID in (83,84)
group by
	d.GEOGID
,	ta.AggTimeID
,	d.PRODID
,	d.PLV
,	d.IS_LLVL

select @status_msg=convert(varchar,getdate(),126) + '--> FINISHED!!'
raiserror(@status_msg , 0, 1) with nowait

end
