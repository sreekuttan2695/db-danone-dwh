CREATE   PROCEDURE [iqvia].[usp_assert_job_not_running]
/* =============================================================================
   Purpose : Throw if the named SQL Agent job is executing. Stops the mapping and
             barcode procedures from reading IMS tables while the build rebuilds them.
   Inputs  : @job_name - Agent job name; NULL skips the check
   Outputs : none; THROW 50110 when the job is running
   Needs   : read on msdb.dbo.sysjobactivity (SQLAgentReaderRole or sysadmin)
   Change  : 2026-09-23  initial version
   ============================================================================= */
    @job_name sysname
AS
BEGIN
    SET NOCOUNT ON;

    IF @job_name IS NULL
        RETURN;

    IF EXISTS (SELECT 1
               FROM msdb.dbo.sysjobactivity AS ja
               JOIN msdb.dbo.sysjobs        AS j ON j.job_id = ja.job_id
               WHERE j.name = @job_name
                 AND ja.session_id = (SELECT MAX(s.session_id) FROM msdb.dbo.syssessions AS s)
                 AND ja.start_execution_date IS NOT NULL
                 AND ja.stop_execution_date IS NULL)
    BEGIN
        DECLARE @msg nvarchar(2048) = CONCAT(N'Agent job "', @job_name, N'" is running. Retry after it completes.');
        THROW 50110, @msg, 1;
    END;
END;
GO
