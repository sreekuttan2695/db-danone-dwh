CREATE proc [redslim].[eib_transform] as

declare @DynSQL nvarchar(4000)
declare @OBSRowCount int

--Requires DMT update to already have completed
--This is because no checks are made here for missing products or geogs etc
--and no stub refresh is performed

--differs from STG.OBS_TRANSFORM because no non-aggregated EIB is incorporated and PROD_KEY is used throughout
--instead of ProdID

truncate table redslim.fact_eib_nonagg

--NOTE prepending 1 to time_sort here to counter the removal of the prepended week count from time_sort
--  as part of 445 changes... 
insert into
	redslim.fact_eib_nonagg
select
	g.GEOG_ID
,	p.PROD_KEY
,	TimeID		=	convert(int,'1' + t.time_sort)
,	o.* 
from obs.LatestData o
join RDW.MASTER_GEOG_XREF g on g.ret_desc=o.RET_DESC
join RDW.MASTER_TIME_IRI_XREF t on t.IRIWeek=o.iriweek
join RDW.MASTER_PROD_XREF p on p.SWCODE=left(o.UPC,12) and o.iriweek between p.week_first_moved and p.WEEK_LAST_MOVED

--Next create Geography aggregations. This step must be run before aggregating for time (see below)
truncate table redslim.fact_eib_geogagg

insert into redslim.fact_eib_geogagg select g.AggGeogId, d.prod_key, d.TimeID, g.AggGeogName, d.iriweek
,d.upc, sum(OBSUnit), sum(OBSValue), sum(OBSVolume) from redslim.fact_eib_nonagg d
join redslim.view_master_geog_agg G on g.GeogID=d.GeogID
group by g.AggGeogId, d.prod_key, d.TimeID, g.AggGeogName, d.iriweek,d.upc

--Now create Time aggregations. Geography aggregation must be done first
truncate table redslim.fact_eib_timeagg

insert into redslim.fact_eib_timeagg
select d.geogid, d.prod_key, t.aggtimeid, d.ret_desc, max(iriweek), d.UPC
, sum(OBSUnit), sum(OBSValue), sum(OBSVolume) 
from redslim.fact_eib_geogagg d
join RDW.MASTER_TIME_AGG t on t.WTimeID=d.TimeID
group by d.geogid, d.prod_key, t.aggtimeid, d.ret_desc, d.UPC
GO
