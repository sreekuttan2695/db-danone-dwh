GO
SET QUOTED_IDENTIFIER ON
GO
create view [ecom].[view_tes_all_tpns_in_l156w] as

with
	tes_backdata as
	(
		select
			TPN
		,	Item_Name
		,	mon_week_date
		,	iriweek			=	datediff
								(
									ww
								,	'1979-09-01'
								,	cast(sat_week_end_date as date)
								)
		from
			ecom.tesco_all_backdata_pivot
	)
,	tes_time_limited_backdata as
	(
		select
			*
		from
			tes_backdata
		where
			iriweek in	(select distinct top 156 iriweek from tes_backdata order by iriweek desc)
	)
,	tes_all_tpns_in_l156w as
	(
		select
			bd.tpn
		,	swcode	=	left(x.ean,12)
		,	bd.iriweek
		from
			tes_time_limited_backdata bd
		join
			rdw.ecom_tes_prod_master_tpn_ean_xref x on x.tpn=bd.tpn
	)

select * from tes_all_tpns_in_l156w
