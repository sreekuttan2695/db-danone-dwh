         , GEOG_LOADED, TIME_LOADED, MEAS_LOADED, CSD_VIEWS_CREATED)
  values (M.FN, 1, 0
--         , 'Danone_UK_ELN_MT_TapeII_LOAD_' + REPLACE(REPLACE(RIGHT(M.FN_NoWeek,LEN(M.FN_NoWeek)-(patindex('%\W%',M.FN_NoWeek)+2)),'.DESC',''),'.','_'), 0
--This stored procedure comes up in a search for potential 444 vs 445 system clashes. Whilst not strictly necessary, commenting the above and altering to the below will ensure no clash occurrs #445_change
         , 'Danone_UK_ELN_MT_445_TapeII_LOAD_' + REPLACE(REPLACE(RIGHT(M.FN_NoWeek,LEN(M.FN_NoWeek)-(patindex('%\W%',M.FN_NoWeek)+2)),'.DESC',''),'.','_'), 0
         , 'STG.' + REPLACE(REPLACE(RIGHT(M.FN_NoWeek,LEN(M.FN_NoWeek)-(patindex('%\W%',M.FN_NoWeek)+2)),'.DESC',''),'.','_') + '_FACTVIEW'
         , REPLACE(REPLACE(REPLACE(M.FN_NoWeek,'ToLoad\W','LoadPackages\Load'),'.','_'),'_DESC','.dtsx'), 0
         , '_', 0, 0, 0, 0, 0, 0, M.MC, 0, 0, 0, 0, 0);

declare @tbl_suffix nvarchar(5)
