create view [tst].[restate1_IMS_TIME_VIEW] as
with AllTime as (select * from tst.restate1_ims_master_time),
     TL1 as (select TimeID, 1 TLV, 0 IS_TLLVL, TimeID YearID, IMSYear YearName, null IMSQuID, null IMSQName
                   , null IMSMonthID, null IMSMonthName, null IMSWeekID, null IMSWeekName from AllTime where IMSQuarter is null),
     TL2 as (select ll.TimeID, 2 TLV, 0 IS_TLLVL,hl.YearID, hl.YearName, ll.TimeID IMSQuID, IMSQuarter IMSQName
                   , null IMSMonthID, null IMSMonthName, null IMSWeekID, null IMSWeekName
             from AllTime ll
             join TL1 hl on hl.YearName=ll.IMSYear
             where ll.IMSQuarter is not null and ll.IMSMonth is null),
     TL3 as (select ll.TimeID, 3 TLV, 0 IS_TLLVL,hl.YearID, hl.YearName, hl.IMSQuID, hl.IMSQName
                   , ll.TimeID IMSMonthID, ll.IMSMonth IMSMonthName, null IMSWeekID, null IMSWeekName
             from AllTime ll
             join TL2 hl on hl.YearName=ll.IMSYear and hl.IMSQName=ll.IMSQuarter
             where ll.IMSMonth is not null and ll.IMSWeek is null),
     TL4 as (select ll.TimeID, 4 TLV, 1 IS_TLLVL, hl.YearID, hl.YearName, hl.IMSQuID, hl.IMSQName
                   ,hl.IMSMonthID, hl.IMSMonthName, ll.TimeID IMSWeekID, ll.IMSWeek IMSWeekName
             from AllTime ll
             join TL3 hl on hl.YearName=ll.IMSYear and hl.IMSQName=ll.IMSQuarter and hl.IMSMonthName=ll.IMSMonth
             where ll.IMSWeek is not null)

select * from TL1
union all
