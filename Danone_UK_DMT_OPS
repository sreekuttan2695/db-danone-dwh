CREATE view [RDW].[master_time_ims_lkup_old] as

with all_weeks as (select time_key, longname, weekdate=cast('20'+right(longname,8) as date) from rdw.view_all_loaded_times where longname like '01%' )
,     week_days as (select dow=0 union all select dow=1 union all select dow=2 union all select dow=3 union all 
					select dow=4 union all select dow=5 union all select dow=6)
,     allwkdays as (select DayDate=dateadd(dd,-d.dow, e.weekdate), EndDate=e.weekdate, TIME_KEY=convert(varchar,e.weekdate,112)
					from all_weeks e, week_days d)

select
  DayDate
, EndDate
, TIME_KEY
, MonthN = month(DayDate)
, ndays=datediff(day, dateadd(day, 1-day(DayDate), DayDate), dateadd(month, 1, dateadd(day, 1-day(DayDate), DayDate)))
from 
  allwkdays



