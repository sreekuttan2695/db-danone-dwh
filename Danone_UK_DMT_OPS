create view [STG].[Danone_UK_ELN_MT_445_TapeII_LOAD_C4101N_R1210J5_dt_view] as

with package as (select * from RDW.PACKAGE_MASTER)

select DTSX_FILE_LINE_NUM, dtsx_xml_line from package where MOVE_ID_COL_NUM is not null
union all
select DTSX_FILE_LINE_NUM, replace(DTSX_XML_LINE,'MOVEFILE_DESTINATION_TABLE','STG.LOAD_TBL_FACT_44')
  from package where dest_truncate_line=1 or DESTINATION_LINE=1
union all
select DTSX_FILE_LINE_NUM, replace(dtsx_xml_line,'SOURCE_FILE_PATH','D:\Projects\Danone\SSIS\ToLoad\W2194.C4101N.R1210J5.MOVE')
  from package where SOURCEFILE_LINE=1 and DTSX_XML_LINE like '%ConnectionString%'
union all
select DTSX_FILE_LINE_NUM, replace(dtsx_xml_line,'SOURCE_FILE_PATH','D:\Projects\Danone\SSIS\ToLoad\W2194.C4101N.R1210J5.DESC')
  from package where SOURCEFILE_LINE=1 and DTSX_XML_LINE like '%SQLTask%'
union all
select DTSX_FILE_LINE_NUM, REPLACE(DTSX_XML_LINE,'MEAS_COL_NAME','' + RDW.CleanMeasureName(MEAS_KEY,longname,0) + '')
  from STG.LOAD_TBL_MEAS_44 m 
  join package p on p.MOVE_MEASCOL_NUM=m.meas_id
  where m.MEAS_ID < (select MAX(meas_id) from STG.LOAD_TBL_MEAS_44)
union all
select DTSX_FILE_LINE_NUM, REPLACE(DTSX_XML_LINE,'MEAS_COL_NAME','' + RDW.CleanMeasureName(MEAS_KEY,longname,0) + '')
  from STG.LOAD_TBL_MEAS_44 m, package p
  where m.MEAS_ID = (select MAX(meas_id) from STG.LOAD_TBL_MEAS_44) and p.MOVE_MEASCOL_NUM=999
union all
select DTSX_FILE_LINE_NUM, replace(DTSX_XML_LINE,'TARGET_FOLDER_FOR_LOADED_MOVE_FILE','D:\Projects\Danone\SSIS\Loaded')
  from package where MOVEFILE_TARGET_FOLDER_LINE=1 
union all
select DTSX_FILE_LINE_NUM, replace(replace(DTSX_XML_LINE,'TAPE2_LOADER_SQL_SERVER_INSTANCE_NAME','' + convert(varchar,SERVERPROPERTY('ServerName')) + N''),'TAPE2_LOADER_SQL_SERVER_DB_NAME','' + DB_NAME() + N'')
  from package where SERVER_DB_LINE=1
union all
select DTSX_FILE_LINE_NUM, DTSX_XML_LINE from package where DEST_TRUNCATE_LINE is null and DESTINATION_LINE is null
and SOURCEFILE_LINE is null and MOVE_ID_COL_NUM is null and MOVE_MEASCOL_NUM is null
