-- =============================================
-- Author:		Adeel Abid
-- Create date: 12/10/2021
-- Description:	This procedure will create the CFACT_IMS table
-- =============================================
CREATE PROCEDURE [iqvia].[create_cfact_ims_tbl]

AS

BEGIN
	-- SET NOCOUNT ON added to prevent extra result sets from
	-- interfering with SELECT statements.
	SET NOCOUNT ON;

    -- Insert statements for procedure here
	
	BEGIN TRY

		IF OBJECT_ID('PRD.CFACT_IMS') IS NOT NULL  
		DROP TABLE PRD.CFACT_IMS;

		select * into PRD.CFACT_IMS 
		from (
		select
			Geogid = 1
		,	ProdID = i.AVP_Key
		,	t.TimeID
		,	C_UNITS = NULLIF(REPLACE(f.[VOLUME],'#N/A','-'),'-')
		,	UNITS = NULLIF(REPLACE(f.[UNITS],'#N/A','-'),'-')
		,	VAL_STG = NULLIF(replace( f.VALUE_STG,',',''),'-')
		--into PRD.CFACT_IMS
		from [IMS].[FACT] f
		inner join (select * from Danone_UK_DMT_OPS.RDW.IMS_AVP where ATR_NAME = 'IMS Pack') i on i.ATR_VALUE = f.IMS_Pack
		join (select * from prd.dim_time_ims where TLV=3) t on t.IMSMonthName=f.Fact_Month
		where f.VALUE_STG <> ''
		union all
		select
			Geogid = 2
		,	ProdID = i.AVP_Key
		,	t.TimeID
		,	C_UNITS = NULLIF(REPLACE(f.[VOLUME],'#N/A','-'),'-')
		,	UNITS = NULLIF(REPLACE(f.[UNITS],'#N/A','-'),'-')
		,	VAL_STG = NULLIF(replace( f.VALUE_STG,',',''),'-')
