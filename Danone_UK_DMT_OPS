CREATE PROCEDURE [iqvia].[sp_update_latest_ims_data_view_gb]
-- =============================================
-- Author:      Adeel Abid
-- Create date: 07/10/2021
-- Purpose:     Regenerate IMS.latest_ims_data_view from IMS.initial_bridge_load,
--              deriving MTHmmyy column aliases from the IQVIA header row.
-- Inputs:      none (schema + header-row driven)
-- Outputs:     IMS.latest_ims_data_view (CREATE or ALTER)
-- Change log:
--   2026-07-30  NET WEIGHT CR: By Sreekesh
--               - exclude GAP2 separator column
--               - force nvarchar(max) concatenation (was silently truncating
--                 select_cols at 4000 chars once the 4th measure block landed)
--               - integrity guard on generated column list
--               - TRY/CATCH with rethrow (previously none)
-- =============================================
AS
BEGIN
    SET NOCOUNT ON;

    BEGIN TRY
        DECLARE @dsql table(select_cols nvarchar(max));
        DECLARE @dyn_sql  nvarchar(max) = NULL;
        DECLARE @cols     nvarchar(max);
        DECLARE @expected int;
        DECLARE @actual   int;
        DECLARE @msg      nvarchar(2048);

        select @dyn_sql=coalesce(@dyn_sql+'
	,','') + colname
	from (
	select ORDINAL_POSITION,colname='['+COLUMN_NAME+']' from INFORMATION_SCHEMA.COLUMNS where table_schema='IMS' and table_name='initial_bridge_load' and ORDINAL_POSITION<9
	union all
	select ORDINAL_POSITION,colname=
	'[''+replace(
	replace(left(replace(ltrim(' + column_name + '),'' '',''_''), charindex(''/'',replace(ltrim(' + column_name + '),'' '',''_''))),''Month/'',''MTH'')
	+right(''00'' + left(right(rtrim(' + column_name + '), len(' + column_name + ')-charindex(''/'',' + column_name + ')),charindex(''/'',right(rtrim(' + column_name + '), len(' + column_name + ')-charindex(''/'',' + column_name + ')))-1),2)
	+substring(right(rtrim(' + column_name + '), len(rtrim(' + column_name + '))-charindex(''/'',rtrim(' + column_name + '))),charindex(''/'',right(rtrim(' + column_name + '), len(rtrim(' + column_name + '))-charindex(''/'',rtrim(' + column_name + '))))+3,2)
	,char(10),''_'') + '']=[' + column_name + ']' from information_schema.columns where table_schema='IMS' and table_name='initial_bridge_load' and ORDINAL_POSITION>8 and column_name not in ('GAP','GAP2')
	) a order by ORDINAL_POSITION;

        IF @dyn_sql IS NULL
            THROW 50010, 'sp_update_latest_ims_data_view_gb: no columns resolved from IMS.initial_bridge_load.', 1;

        -- FIX: seed the concatenation with an nvarchar(max) operand so the whole
        -- chain is evaluated as max. Without this the result is nvarchar(4000)
        -- and is truncated BEFORE the outer cast, with no error raised.
        select @dyn_sql='select cast(cast(N'''' as nvarchar(max)) + ''' + @dyn_sql + ''' as nvarchar(max)) from ims.initial_bridge_load where IMS_Pack=''IQVIA Pack''';

        insert into @dsql
        exec sys.sp_executesql @dyn_sql;

        select @cols = select_cols from @dsql;

        IF @cols IS NULL OR LEN(@cols) = 0
            THROW 50011, 'sp_update_latest_ims_data_view_gb: header row (IMS_Pack = ''IQVIA Pack'') not found in IMS.initial_bridge_load.', 1;

        -- integrity guard: one ']=[' per measure column, list must close on ']'
        select @expected = count(*)
        from   information_schema.columns
        where  table_schema = 'IMS'
          and  table_name   = 'initial_bridge_load'
          and  ORDINAL_POSITION > 8
          and  column_name not in ('GAP','GAP2');

        set @actual = (DATALENGTH(@cols) - DATALENGTH(REPLACE(@cols, N']=[', N''))) / 2 / 3;

        IF @actual <> @expected OR RIGHT(@cols, 1) <> N']'
        BEGIN
            SET @msg = CONCAT('sp_update_latest_ims_data_view_gb: generated column list is truncated or malformed. ',
                              'chars=', DATALENGTH(@cols)/2,
                              ' measure_cols_found=', @actual,
                              ' expected=', @expected,
                              ' tail=', RIGHT(@cols, 60));
            THROW 50012, @msg, 1;
        END

        select @dyn_sql =
        case when object_id('IMS.latest_ims_data_view') is null then 'CREATE ' else 'ALTER ' end + 'VIEW IMS.latest_ims_data_view AS
	-- NOTE: dynamically regenerated by iqvia.sp_update_latest_ims_data_view_gb on ' + cast(GETDATE() as nvarchar(max)) + '
	select
	 ' + @cols + '
	from IMS.initial_bridge_load where IMS_Pack not in ('''',''IQVIA Pack'')';

        exec sys.sp_executesql @dyn_sql;
    END TRY
    BEGIN CATCH
        DECLARE @err nvarchar(2048) = CONCAT('sp_update_latest_ims_data_view_gb failed at line ',
                                             ERROR_LINE(), ': ', ERROR_MESSAGE());
