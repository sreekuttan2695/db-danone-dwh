-- =============================================
-- Author:		Adeel Abid
-- Create date: 23/08/2021
-- Description:	Returns latest integrated IQVIA dataset from the base table
-- =============================================
CREATE Proc [ma_monetdb].[up_iqvia_export_for_monetdb_Adeel_todelete]

AS
BEGIN

	IF OBJECT_ID(N'tmp.DailyData_IMS', N'U') IS NOT NULL  
    DROP TABLE [tmp].[DailyData_IMS];

	select 
	DataType_ID	=	cast(1 as int),	
	vn_dim_key	=	cast(715700 as int),
	i.it_dim_key,
	tm_dim_key  =   t.iriweek,
	cast(replace(f.UNITS,'-',0) as float)/t.ndays as unitsales,
	cast(replace(f.VALUE_STG,'-',0) as float)/t.ndays as valsales,
	cast(replace(f.VOLUME,'-',0) as float)/t.ndays as volsales
	into [tmp].[DailyData_IMS]
	from ims.fact f
	join [ma_monetdb].[view_xref_ims_prods] i on i.ProdDesc = f.IMS_Pack
	join [RDW].[master_time_ims_lkup_Adeel] t on f.FACT_MONTH = t.imsmonth;

	IF OBJECT_ID(N'tmp.WeeklyData_IMS', N'U') IS NOT NULL  
    DROP TABLE [tmp].[WeeklyData_IMS];
	
	SELECT 
	DataType_ID,
	vn_dim_key,
	it_dim_key,
	tm_dim_key,
	ValueSales	=	sum(cast(round(valsales*100,0) as int)),
	UnitSales	=	sum(cast(round(unitsales,0) as int)),
	VolumeSales	=	sum(cast(round(volsales*100,0) as int))
	into [tmp].[WeeklyData_IMS]
	from [tmp].[DailyData_IMS]
	group by
	DataType_ID,
	vn_dim_key,
	it_dim_key,
	tm_dim_key
	having sum(cast(volsales as float)) > 0

END
GO
