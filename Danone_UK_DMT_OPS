CREATE VIEW [iqvia].[NEW_PRODS_WITH_MAPPING] as


with NewIntegratedProds as (select P.*, np.IRIcode13, np.IRIcode14 from IMS.DIM_PROD P
							JOIN iqvia.new_products_barcode np on P.IMS_Pack = np.prod_desc
							--only retrieve products we care about - that is, not ones which we automatically include
							where Category not in (select category from rdw.excluded_IMS_categories)
							)
--select * from NewIntegratedProds /*
,    FactDataForIMSNIP as (select np.*, FACT_MONTH,
							UNITS = cast(cast(REPLACE(REPLACE(UNITS, '#N/A', ''), '-', '') as float) as int) 
						   ,ValSales = cast(cast(REPLACE(REPLACE(VALUE_STG, '#N/A', ''), '-', '') as float) as int) 
						   ,VOLUME = cast(cast(REPLACE(REPLACE(VOLUME, '#N/A', ''), '-', '') as float) as int) 
						   ,NET_WEIGHT = cast(cast(REPLACE(REPLACE(NET_WEIGHT, '#N/A', ''), '-', '') as float) as int) 
						 from IMS.FACT_UK f
                            JOIN NewIntegratedProds np on f.IMS_Pack = np.IMS_Pack)  
--select * from FactDataForIMSNIP /*  
,    FactsWithoutZeroes as (select * from FactDataForIMSNIP where UNITS <> 0 and CONVERT(int, cast(ValSales as float)) <> 0)  
-- select distinct IMS_Pack from FactsWithoutZeroes /*  
,    Potential_MapProds as (select Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack, IRICode13, IRICode14  
       , earliestsale = 'MTH' + convert(varchar , MIN(convert(int,right(FACT_MONTH,2) + SUBSTRING(FACT_MONTH,4,2))) )  
       , latest_sale = 'MTH' + convert(varchar , MAX(convert(int,right(FACT_MONTH,2) + SUBSTRING(FACT_MONTH,4,2))) )  
       , NumSaleMonths = COUNT(distinct FACT_MONTH)  
       , units = sum(UNITS)
	   , valsales = sum(ValSales)
	   , volsales = sum(VOLUME)
	   , netweight = SUM(NET_WEIGHT)
        from FactsWithoutZeroes  
       group by Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack, IRICode13, IRICode14  
--       having SUM(valsales) > 10000 or COUNT(distinct fact_month) < 7  
       )  
-- select * from Potential_MapProds /*  
   
select Prod_Source = 'mock_prod'
, Prod_Desc  = IMS_Pack
, EAN = IRICode13
, iricode14
, unit_sales=cast(units as varchar)
, val_sales=cast(valsales as varchar)
, vol_sales=cast(volsales as varchar)
, net_weight=cast(netweight as varchar)
, NumSaleMonths=cast(NumSaleMonths as varchar)  
, earliestsale = 'MTH' + right(earliestsale, 2) + SUBSTRING(earliestsale,4,2)  
, latest_sale = 'MTH' + right(latest_sale,2) + SUBSTRING(latest_sale,4,2)  
, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [FORMAT]  
from Potential_MapProds  
--order by val desc  
