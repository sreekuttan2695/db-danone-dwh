						,	'+'
						,	right(concat('00000000000',round(ae.unit_sales,0)),11)
						,	'+'
						,	right(concat('00000000000',round(ae.val_sales,0)),11)
						,	'+'
						,	right(concat('00000000000',round(ae.unit_price,0)),11)
						)
,	cff_filename	=	concat('infoscan.',t.iriweek,'.sl1.SALES')
,	ecf_output		=	concat
						(
