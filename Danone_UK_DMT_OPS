CREATE   PROCEDURE [iqvia].[sp_send_monthly_product_ean_list]
/* =============================================================================
   Purpose : Write iqvia.PRODUCT_EAN_LIST to <@file_path><@file_name>_<MTHmmyy>.csv
             and email a status summary. Build job step after
             "Email IQVIA mapping notification".
   Inputs  : @recipients   - email recipients (required)
             @file_path    - UNC folder, trailing backslash optional (required)
             @mail_profile - Database Mail profile
             @file_name    - file name stem
   Outputs : CSV file, summary email. On failure: failure email, then THROW 50159.
   Change  : 2026-09-23  initial version
   ============================================================================= */
    @recipients   nvarchar(max)='UKSIDanoneDMT@circana.com; UKTSGSERVICE@Circana.com;',
    @file_path    nvarchar(260)='\\win0702.infores.com\PROJECTS\DANONE\IQVIA\Extracts\New_MDM_Prods_Mapping\',
    @mail_profile sysname       = N'DBA',
    @file_name    nvarchar(128) = N'IQVIA_Product_EAN_List'
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @latest_month nvarchar(7);
    DECLARE @expected     int;
    DECLARE @rows         int;
    DECLARE @file_full    nvarchar(400);
    DECLARE @query        nvarchar(3000);
    DECLARE @subject      nvarchar(255);
    DECLARE @body         nvarchar(max);
    DECLARE @msg          nvarchar(2048);

    BEGIN TRY
        IF NULLIF(LTRIM(RTRIM(@recipients)), N'') IS NULL
           OR NULLIF(LTRIM(RTRIM(@file_path)), N'') IS NULL
           OR NULLIF(LTRIM(RTRIM(@file_name)), N'') IS NULL
            THROW 50150, N'@recipients, @file_path and @file_name are required.', 1;

        SET @file_path = LTRIM(RTRIM(@file_path));
        IF RIGHT(@file_path, 1) <> N'\'
            SET @file_path = @file_path + N'\';

        SELECT TOP (1) @latest_month = d.TimeID
        FROM   IMS.dim_time AS d
        WHERE  d.TimeID LIKE N'MTH[0-9][0-9][0-9][0-9]'
        ORDER BY RIGHT(d.TimeID, 2) DESC, SUBSTRING(d.TimeID, 4, 2) DESC;

        IF @latest_month IS NULL
            THROW 50151, N'IMS.dim_time has no months - build step 6 did not populate it.', 1;

        SELECT @expected = COUNT(*) FROM iqvia.PRODUCT_EAN_LIST;

        IF @expected = 0
            THROW 50152, N'iqvia.PRODUCT_EAN_LIST is empty - IMS.dim_prod was not populated by build step 6.', 1;

        SET @file_full = CONCAT(@file_path, @file_name, N'_', @latest_month, N'.csv');
        SET @query     = CONCAT(N'SELECT csv_line FROM ', QUOTENAME(DB_NAME()),
                                N'.iqvia.PRODUCT_EAN_LIST_CSV ORDER BY sort_key, sort_name');

        EXEC iqvia.usp_bcp_queryout @query = @query, @file_full = @file_full, @rows_out = @rows OUTPUT;

        IF @rows <> @expected + 1
        BEGIN
            SET @msg = CONCAT(N'CSV row count mismatch: bcp wrote ', @rows, N', expected ', @expected + 1, N' (incl. header).');
            THROW 50153, @msg, 1;
        END;

        SET @subject = CONCAT(N'DANONE: IQVIA PRODUCT LIST WITH EAN DETAILS - ', @latest_month);

        SET @body = CONCAT(
            CONVERT(nvarchar(max), N'<html><body style="font-family:Calibri,Arial,sans-serif;font-size:11pt">'),
            N'<p>Hi,</p><p>IQVIA product list with EAN details for the ', @latest_month, N' delivery.</p>',
            N'<p>File: ', @file_full, N'<br>Products: ', @expected, N'</p>',
            N'<table border="1" cellpadding="4" style="border-collapse:collapse">',
            N'<tr style="background-color:#dddddd"><th>Mapping status</th><th>Products</th></tr>',
            CAST((SELECT td = s.mapping_status, N'', td = s.n
                  FROM   (SELECT v.mapping_status, n = COUNT(*)
                          FROM   iqvia.PRODUCT_EAN_LIST AS v
                          GROUP BY v.mapping_status) AS s
                  ORDER BY s.n DESC
                  FOR XML PATH('tr'), TYPE) AS nvarchar(max)),
            N'</table>',
            N'<p><b>MAPPED</b>: EAN resolves to one Danone item. ',
            N'<b>MAPPED_NOT_IN_MDM</b>: EAN not (yet) in view_item_identifiers; expected for new mock products until created. ',
            N'<b>MAPPED_MDM_AMBIGUOUS</b>: EAN matches more than one Danone item. ',
            N'<b>MAPPED_CODE14_MISMATCH</b>: lookup iricode14 differs from MDM. ',
            N'<b>DUPLICATE_MAPPING</b>: more than one lookup row for the pack. ',
            N'<b>BARCODE_ASSIGNED_NOT_MERGED</b>: code assigned, lookup merge not yet run. ',
            N'<b>UNMAPPED</b>: no mapping and no code. ',
            N'<b>EXCLUDED_CATEGORY</b>: category excluded from mapping.</p>',
            N'<p>This is an automated email. Please do not reply.</p></body></html>');

        EXEC msdb.dbo.sp_send_dbmail
             @profile_name = @mail_profile,
             @recipients   = @recipients,
             @subject      = @subject,
             @body         = @body,
             @body_format  = 'HTML';
    END TRY
    BEGIN CATCH
        SET @msg = CONCAT(N'sp_send_monthly_product_ean_list failed at line ', ERROR_LINE(), N': ', ERROR_MESSAGE());

        BEGIN TRY
            IF NULLIF(LTRIM(RTRIM(@recipients)), N'') IS NOT NULL
                EXEC msdb.dbo.sp_send_dbmail
                     @profile_name = @mail_profile,
                     @recipients   = @recipients,
                     @subject      = N'DANONE: IQVIA PRODUCT LIST WITH EAN DETAILS - FAILED',
                     @body         = @msg,
                     @body_format  = 'TEXT';
        END TRY
        BEGIN CATCH
            PRINT CONCAT(N'Failure email not sent: ', ERROR_MESSAGE());
        END CATCH;

        THROW 50159, @msg, 1;
    END CATCH;
END;
GO
