CREATE view [t2_output].[view_2] as
select top 9999999 
rn,t2_output_format=original_key
 + isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_units,M00001011_Unit_Sales)) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_value,M00001013_Val_Sales)) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_volume,M00001012_Vol_Sales)) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(06,1),M00008990_CWD_Wtd_Dist) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(06,1),M00002020_ACV_Wtd_Dist) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(05,1),M00003010_pc_Stores_Selling) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(08,2),M00001041_Unit_Price) as varchar),11),space(10)+'*')
 + isnull(right(space(11) + cast(convert(decimal(08,2),M00001042_Vol_Price) as varchar),11),space(10)+'*')
from redslim.eib_and_tape2_2 order by rn
union all
select top 1 rn=rn+1, t2_output_format=
	stuff(original_key,7,59,replicate('ÿ',57) + '01')
+	right(space(11)+cast((select count(1)+1 from redslim.eib_and_tape2_2) as varchar),11)
+	'          0'
+	right(space(15)+cast(convert(decimal(18,0),sum(M00001013_Val_Sales) over (partition by 1)) as varchar),15)
+	space	(	len	(	original_key
					+	isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_units,M00001011_Unit_Sales)) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_value,M00001013_Val_Sales)) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(11,0),isnull(GT1_domestic_volume,M00001012_Vol_Sales)) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(06,1),M00008990_CWD_Wtd_Dist) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(06,1),M00002020_ACV_Wtd_Dist) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(05,1),M00003010_pc_Stores_Selling) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(08,2),M00001041_Unit_Price) as varchar),11),space(10)+'*')
					+	isnull(right(space(11) + cast(convert(decimal(08,2),M00001042_Vol_Price) as varchar),11),space(10)+'*')
					)
			-
				len	(	stuff(original_key,7,59,replicate('ÿ',57) + '01')
					 +	right(space(11)+cast(count(1) over (partition by 1)+1 as varchar),11)
					 +	'          0'
					 +	right(space(15)+cast(convert(decimal(18,0),(select sum(M00001013_Val_Sales) from redslim.eib_and_tape2_2)) as varchar),15)
					)
			)
from 
(
	select top 1 * from redslim.eib_and_tape2_2 order by rn desc
) a
order by rn
