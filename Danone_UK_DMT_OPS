CREATE function [STG].[RemoveRepeatedStrings]
/* 
--TEST STRINGS BELOW
select STG.RemoveRepeatedStrings('APTAMIL FIRST FIRST STAGE POWDER',default)
select STG.RemoveRepeatedStrings('APTAMIL FIRST FIRST STAGE POWDER',',')
select STG.RemoveRepeatedStrings('COW & GATE FIRST INFANT FIRST STAGE POWDER',' ')
--*/
--===== Define I/O parameters
        (@pString varchar(8000), @pDelimiter char(1)=' ')
--WARNING!!! DO NOT USE MAX DATA-TYPES HERE!  IT WILL KILL PERFORMANCE!

returns varchar(8000) as begin

--*/
/* TO ALLOW FUNCTION TO COMPILE REMOVE THE -- AT THE START OF THIS LINE
--declare @pString varchar(8000)='APTAMIL FIRST FIRST STAGE POWDER'
--declare @pString varchar(8000)='COW & GATE FIRST INFANT FIRST STAGE POWDER'
declare @pString varchar(8000)='COW & GATE COW & GATE BABY BALANCE BREAKFAST BABY RICE STAGE 1 BOX'
declare @pDelimiter char(1)=' '
--*/

declare @ReturnString varchar(8000)
--specific replacement instance to cope with "COW & GATE COW & GATE"
set @pString=replace(@pstring,' & ','|&|')
--select @pString
--===== "Inline" CTE Driven "Tally Table" produces values from 1 up to 10,000...
     -- enough to cover VARCHAR(8000)
;  with E1(N)   as (select 1 union all select 1 union all select 1 union all
                    select 1 union all select 1 union all select 1 union all
                    select 1 union all select 1 union all select 1 union all select 1
                    )                          --10E+1 or 10 rows
,       E2(N)   as (select 1 from E1 a, E1 b)  --10E+2 or 100 rows
,       E4(N)   as (select 1 from E2 a, E2 b)  --10E+4 or 10,000 rows max
, cteTally(N)   as (--==== This provides the "base" CTE and limits the number of rows right up front
                     -- for both a performance gain and prevention of accidental "overruns"
                    select top (ISNULL(DATALENGTH(@pString),0)) ROW_NUMBER() over (order by (select NULL)) from E4
                    )
, cteStart(N1)  as (--==== This returns N+1 (starting position of each "element" just once for each delimiter)
                    select 1 union all
                    select t.N+1 from cteTally t where SUBSTRING(@pString,t.N,1) = @pDelimiter
                    )
, cteLen(N1,L1) as (--==== Return start and length (for use in substring)
                    select s.N1, --==== The ISNULL/NULLIF combo handles the length for the final element when no delimiter is found.
                           ISNULL(NULLIF(CHARINDEX(@pDelimiter,@pString,s.N1),0)-s.N1,8000)
                    from cteStart s
                    )
, SplitData     as (--===== Do the actual split.
                    select ItemNumber = ROW_NUMBER() over (order by l.N1),
                           Item       = SUBSTRING(@pString, l.N1, l.L1)
--                           Item       = REPLACE(SUBSTRING(@pString, l.N1, l.L1),'-&-','')
                    from cteLen l
                    where SUBSTRING(@pString, l.N1, l.L1) <> '')
--select * from SplitData /*
, RemoveRepeats as (select s.ItemNumber, s.Item from SplitData s where not exists (select 0 from SplitData d where d.Item=s.Item and d.ItemNumber=s.ItemNumber+1))

--select * from RemoveRepeats /*

select @ReturnString = REPLACE(
                               STUFF((select ' ' + Item
                               from RemoveRepeats
                               order by ItemNumber
                               for xml path (''), root('MyString'), type).value('/MyString[1]','varchar(max)'
                               )
                               ,1,1,'')
                              ,'|&|',' & ')

return @ReturnString

end
