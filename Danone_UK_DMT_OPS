CREATE PROC [iqvia].[new_products_barcode_asign] as

DECLARE @Prefix13 VARCHAR(9) = '271000910';
DECLARE @Prefix14 VARCHAR(9) = '2701000910';
DECLARE @CurrentMax INT;

SELECT @CurrentMax = MAX(CAST(RIGHT(iricode13,5) AS INT))
FROM [ma_monetdb].[view_item_identifiers]
WHERE iricode13 LIKE @Prefix13 + '%'
  AND iricode13 <> '2710009199999';

-- Create backup only if main table exists
IF OBJECT_ID('iqvia.new_products_barcode', 'U') IS NOT NULL
BEGIN
    -- Remove previous backup
    DROP TABLE IF EXISTS iqvia.new_products_barcode_bkp;

    -- Create fresh backup
    SELECT *
    INTO iqvia.new_products_barcode_bkp
    FROM iqvia.new_products_barcode;

    -- Drop main table
    DROP TABLE iqvia.new_products_barcode;
END;

WITH Products AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY Prod_Desc) AS SeqNo,
        Prod_Desc
    FROM [iqvia].[PROD_WITH_NO_MAPPING]
),

Numbers AS (
    SELECT 1 AS N
    UNION ALL
    SELECT N + 1
    FROM Numbers
    WHERE N < 100
),

AvailableCodes AS (
    SELECT
        ROW_NUMBER() OVER (ORDER BY N) AS SeqNo,
        @Prefix13 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5) AS IRICode13,
		@Prefix14 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5) AS IRICode14
    FROM Numbers
    WHERE NOT EXISTS (
        SELECT 1
        FROM [ma_monetdb].[view_item_identifiers] vi
        WHERE vi.iricode13 =
              @Prefix13 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5)
			OR
			  vi.iricode14 =
              @Prefix14 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5)
    )
    AND NOT EXISTS (
        SELECT 1
        FROM [Danone_UK_DMT_OPS].[RDW].[MASTER_PROD_IMS_LKUP] ml
        WHERE ml.EAN =
              @Prefix13 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5)
           OR ml.iricode14 =
              @Prefix14 + RIGHT('00000' + CAST(@CurrentMax + N AS VARCHAR(5)),5)
    )
)



SELECT
    p.Prod_Desc,
    a.IRICode13,
	a.IRICode14
INTO iqvia.new_products_barcode
FROM Products p
JOIN AvailableCodes a
    ON p.SeqNo = a.SeqNo
ORDER BY p.SeqNo
OPTION (MAXRECURSION 100);
GO
