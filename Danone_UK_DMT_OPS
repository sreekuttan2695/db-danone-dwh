-- Description:	Returns latest integrated IQVIA dataset from the most recently-built CSD DB
-- =============================================
CREATE function [ma_monetdb].[ufn_iqvia_export_for_monetdb]
(
	@force_db	int	=	null
)
RETURNS 
@iqvia_dataset TABLE 
(
	DataType_ID	int
,	vn_dim_key	int
,	it_dim_key	int
,	tm_dim_key	int
,	ValueSales	int
,	UnitSales	int
,	VolumeSales	int
)
AS
BEGIN
	if @force_db=1 or (select top 1 csd_database from qc.view_csd_db_build_dates order by build_date desc) = 'Danone_UK_DMT_CSD_DB1'
		insert into
			@iqvia_dataset
		select distinct 
			DataType_ID	=	cast(1 as int)
		,	vn_dim_key	=	cast(715700 as int)			-- this is the vn_dim_key for Chemits excl BT, SD & WL
		,	it_dim_key	=	cast(x.item_dim_key as int)
		,	tm_dim_key	=	cast(t.IRIWeek as int)
		,	ValueSales	=	cast(round(iqdata.M00001013_Val_Sales*100,0) as int)
		,	UnitSales	=	cast(round(iqdata.M00001011_Unit_Sales,0) as int)
		,	VolumeSales	=	cast(round(iqdata.M00001012_Vol_Sales*100,0) as int)
		from
		(
			select
				prodid				=	case when prodid=624 then 623 else prodid end
			,	timeid
			,	M00001013_Val_Sales
			,	M00001011_Unit_Sales
			,	M00001012_Vol_Sales
			from
				Danone_UK_DMT_CSD_DB1.st.fact_ims_infoscan
			where
				geogid		=	61
			and	is_llvl		=	1
			and len(timeid)	=	7
			and timeid		like '1%'
		) iqdata
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=iqdata.TIMEID
		join
			ma_monetdb.view_xref_dmt_prodid_to_ma_item_key_with_proddesc x on x.prodid=iqdata.PRODID
	else
		insert into
			@iqvia_dataset
		select distinct 
			DataType_ID	=	cast(1 as int)
		,	vn_dim_key	=	cast(715700 as int)			-- this is the vn_dim_key for Chemits excl BT, SD & WL
		,	it_dim_key	=	cast(x.item_dim_key as int)
		,	tm_dim_key	=	cast(t.IRIWeek as int)
		,	ValueSales	=	cast(round(iqdata.M00001013_Val_Sales*100,0) as int)
		,	UnitSales	=	cast(round(iqdata.M00001011_Unit_Sales,0) as int)
		,	VolumeSales	=	cast(round(iqdata.M00001012_Vol_Sales*100,0) as int)
		from
		(
			select
				prodid				=	case when prodid=624 then 623 else prodid end
			,	timeid
			,	M00001013_Val_Sales
			,	M00001011_Unit_Sales
			,	M00001012_Vol_Sales
			from
				Danone_UK_DMT_CSD_DB2.st.fact_ims_infoscan
			where
				geogid		=	61
			and	is_llvl		=	1
			and len(timeid)	=	7
			and timeid		like '1%'
		) iqdata
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=iqdata.TIMEID
		join
			ma_monetdb.view_xref_dmt_prodid_to_ma_item_key_with_proddesc x on x.prodid=iqdata.PRODID

	RETURN 
END
