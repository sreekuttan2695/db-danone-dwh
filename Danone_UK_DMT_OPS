	Source.[iricode14], 
	Source.[Category], 
	Source.[Sub_Category_1], 
	Source.[Sub_Category_2], 
	Source.[Manufacturer], 
	Source.[Brand], 
	Source.[Product], 
	Source.[Format],
	GETDATE()
	)
    -- For Updates
    --WHEN MATCHED THEN UPDATE SET
    --    Target.[EAN]		= Source.[EAN],
    --    Target.[iricode14]	= Source.[iricode14]
	;
