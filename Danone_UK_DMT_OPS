 union all
 select 'LatestIMSData' TSSource, 'Danone_UK_DMT_CSD_DB1' DB_TO_BUILD, MAX(CONVERT(datetime,REPLACE(IMSWeekName,'w/e ',''))) DBDate
  from (select IMSWeekName from Danone_UK_DMT_CSD_DB1.ST.DIM_TIME_IMS where IMSWeekName is not null) a
 union all
 select 'LatestIRIData' TSSource, 'Danone_UK_DMT_CSD_DB2' DB_TO_BUILD, MAX(EndDate) DBDate from Danone_UK_DMT_CSD_DB2.ST.DIM_TIME
 union all
 select 'LatestIMSData' TSSource, 'Danone_UK_DMT_CSD_DB2' DB_TO_BUILD, MAX(CONVERT(datetime,REPLACE(IMSWeekName,'w/e ',''))) DBDate
  from (select IMSWeekName from Danone_UK_DMT_CSD_DB2.ST.DIM_TIME_IMS where IMSWeekName is not null) a
 union all
 select 'ManualDBBuild' TSSource, DBName DB_TO_BUILD, timeid DBDate from RDW.MANUAL_BUILD_DB_CHOICE
 union all
 select top 1 * from (select 'LatestBuildDT' TSSource, 'Danone_UK_DMT_CSD_DB1' DB_TO_BUILD, CONVERT(datetime,'02 Feb 1943') DBDate
                      union all
                      select 'LatestBuildDT' TSSource, 'Danone_UK_DMT_CSD_DB1' DB_TO_BUILD, build_date DBDate
                       from Danone_UK_DMT_CSD_DB1.dbo.db_last_updated_date) b order by DBDate desc
 union all
 select top 1 * from (select 'LatestBuildDT' TSSource, 'Danone_UK_DMT_CSD_DB2' DB_TO_BUILD, CONVERT(datetime,'02 Feb 1943') DBDate
                      union all
                      select 'LatestBuildDT' TSSource, 'Danone_UK_DMT_CSD_DB2' DB_TO_BUILD, build_date DBDate
                       from Danone_UK_DMT_CSD_DB2.dbo.db_last_updated_date) b order by DBDate desc)

select * from AllCSDDates;

