/****** Object:  View [RDW].[MASTER_GEOG_XREF]    Script Date: 30/09/2026 07:46:39 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER OFF
GO
CREATE view [RDW].[MASTER_GEOG_XREF] as

with eib_retailers as (select distinct ret_desc from OBS.Data20210919)

select
	g.geog_id
,	g.geog_key
,	g.longname
,	g.cleanname
,	g.in_use
,	d.ret_desc
from
	rdw.master_geog g
join
	eib_retailers d on
		(d.ret_desc=g.longname	and g.longname <> 'SUPERDRUG')
	or	(d.ret_desc='CO-OP'		and g.longname like '%COOP%')
	or	(d.ret_desc like 'J%'	and replace(d.ret_desc,'J','')=g.longname)
	or	(d.ret_desc='SUPERDRUG'	and	d.ret_desc + ' Instore'=g.longname and g.in_use=1)
GO
