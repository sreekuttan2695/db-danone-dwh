CREATE view [ma_cff].[view_store_file] AS

with
	store_setup as
	(
		select 
			Store_No	=	'00001'
		,	Fascia		=	'NA'
		,	ISBA		=	'A'
		,	Store_Name	=	'TES Online data from Danone'
		,	Address_1	=	'NA'
		,	Address_2	=	'NA'
		,	Address_3	=	'NA'
		,	Post_Town	=	'NA'
		,	County		=	'NA'
		,	Post_Code	=	'NA'
		,	IRIWeek
		from
			rdw.master_time_iri_xref
		union all
		select 
			Store_No	=	'00002'
		,	Fascia		=	'NA'
		,	ISBA		=	'A'
		,	Store_Name	=	'JSB Online data from Danone'
		,	Address_1	=	'NA'
		,	Address_2	=	'NA'
		,	Address_3	=	'NA'
		,	Post_Town	=	'NA'
		,	County		=	'NA'
		,	Post_Code	=	'NA'
		,	IRIWeek
		from
			rdw.master_time_iri_xref
	)

select
	Store_No
,	Fascia
,	ISBA
,	Store_Name
,	Address_1
,	Address_2
,	Address_3
,	Post_Town
,	County
,	Post_Code
,	IRIWeek
,	cff_output		=	concat
					(	Store_No
					,	cast(Fascia		as char(30))
					,	ISBA
					,	cast(Store_Name	as char(30))
					,	cast(Address_1	as char(40))
					,	cast(Address_2	as char(40))
					,	cast(Address_3	as char(40))
					,	cast(Post_Town	as char(30))
					,	cast(County		as char(30))
					,	cast(Post_Code	as char( 8))
					)
,	cff_filename	=	concat('infoscan.',iriweek,'.sl1.STORE')
,	ecf_output		=	concat
					(	Store_No	,	char(9)
					,	Fascia		,	char(9)
					,	Store_Name	,	char(9)
					,	Address_1	,	char(9)
					,	Address_2	,	char(9)
					,	Address_3	,	char(9)
					,	Post_Town	,	char(9)
					,	County		,	char(9)
					,	Post_Code	,	char(9)
					,	'01012010'	,	char(9)	--	Open date
					,	'31122099'	,	char(9) --	Closed date
					,	0			,	char(9)	--	Floor area
					--	Cafe,			Carpark,		Creche,			Home Delivery
					,	'N', char(9),	'N', char(9),	'N', char(9),	'Y', char(9)
					--	 Petrol Forecourt,	Pharmacy,		Photo	
					,	'N', char(9),		'N', char(9),	'N'
					)
,	ecf_filename	=	concat('common.uk.',iriweek,'.sl1.STORE')
from
	store_setup
where
	IRIWeek > 1977
GO
