       , NumSaleMonths = COUNT(distinct FACT_MONTH)  
       , units = sum(UNITS)
	   , valsales = sum(ValSales)
	   , volsales = sum(VOLUME)
	   , netweight = SUM(NET_WEIGHT)
        from FactsWithoutZeroes  
       group by Prod_Source, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [Format], IMS_Pack, EAN, IRICode14  
--       having SUM(valsales) > 10000 or COUNT(distinct fact_month) < 7  
       )  
-- select * from Potential_MapProds /*  
   
select Prod_Source
, Prod_Desc  = IMS_Pack
, EAN
, iricode14
, unit_sales=cast(units as varchar)
, val_sales=cast(valsales as varchar)
, vol_sales=cast(volsales as varchar)
, net_weight=cast(netweight as varchar)
, NumSaleMonths=cast(NumSaleMonths as varchar)  
, earliestsale = 'MTH' + right(earliestsale, 2) + SUBSTRING(earliestsale,4,2)  
, latest_sale = 'MTH' + right(latest_sale,2) + SUBSTRING(latest_sale,4,2)  
, Category, Sub_Category_1, Sub_Category_2, Manufacturer, Brand, Product, [FORMAT]  
from Potential_MapProds  
--order by val desc  
