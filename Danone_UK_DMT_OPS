		,	UnitSales	=	cast(round(iqdata.M00001011_Unit_Sales,0) as int)
		,	VolumeSales	=	cast(round(iqdata.M00001012_Vol_Sales*100,0) as int)
		from
			Danone_UK_DMT_CSD_DB1.st.fact_ims_infoscan iqdata
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=iqdata.TIMEID
		join
			ma_mdm.view_xref_dmt_prodid_to_ma_item_key x on x.prodid=iqdata.PRODID
		where
			iqdata.GEOGID		=	61
		and	iqdata.IS_LLVL		=	1
		and len(iqdata.timeid)	=	7
		and iqdata.timeid		like '1%'
	else
		insert into
			@iqvia_dataset
		select distinct 
			DataType_ID	=	cast(1 as int)
		,	vn_dim_key	=	cast(715700 as int)			-- this is the vn_dim_key for Chemits excl BT, SD & WL
		,	it_dim_key	=	cast(x.item_dim_key as int)
		,	tm_dim_key	=	cast(t.IRIWeek as int)
		,	ValueSales	=	cast(round(iqdata.M00001013_Val_Sales*100,0) as int)
		,	UnitSales	=	cast(round(iqdata.M00001011_Unit_Sales,0) as int)
		,	VolumeSales	=	cast(round(iqdata.M00001012_Vol_Sales*100,0) as int)
		from
			Danone_UK_DMT_CSD_DB2.st.fact_ims_infoscan iqdata
		join
			rdw.MASTER_TIME_IRI_XREF t on cast(t.TIME_KEY as bigint)=iqdata.TIMEID
		join
			ma_mdm.view_xref_dmt_prodid_to_ma_item_key x on x.prodid=iqdata.PRODID
		where
			iqdata.GEOGID		=	61
		and	iqdata.IS_LLVL		=	1
		and len(iqdata.timeid)	=	7
		and iqdata.timeid		like '1%'

	RETURN 
END
