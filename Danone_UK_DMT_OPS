--*/	declare	@hierarchy_id			int		=	12365545				/*
--*/	declare	@full_attribute_list	char(1)	=	'Y'						/*
--*/

--local variable declarations
declare @dyn_sql nvarchar(4000)
declare @job_log_id int

set nocount on

raiserror('stored proc ma_mdm.usp_refresh_mdm_attributes started',0,1) with nowait

if object_id(N'tempdb..#extract_list') is not null
	drop table #extract_list

create table #extract_list
(
	content_client_id		int			not null
,	content_create_dt		datetime	not null
,	job_log_id				int			not null
,	country_code_tx			varchar(2)	not null
,	environment_code_tx		varchar(10)	not null
,	process_iri_week_key	int			not null
,	record_cnt				int			not null
,	process_cd				varchar(10)	not null
,	client_name_tx			varchar(255)not null
)

raiserror('retrieving list of mdm extracts for client danonesn',0,1) with nowait

exec
	[uksqlwp09\BLD1].mdm_extracts.dbo.sp_executesql
N'if object_id(N''danonesn.extract_list'') is not null drop table danonesn.extract_list
select
	CONTENT_CLIENT_ID, CONTENT_CREATE_DT, JOB_LOG_ID, COUNTRY_CODE_TX, ENVIRONMENT_CODE_TX, PROCESS_IRI_WEEK_KEY, RECORD_CNT, PROCESS_CD, CLIENT_NAME_TX
 into
	danonesn.extract_list
from
openquery
(	[SV05MDMP]
,	''select s.CONTENT_CLIENT_ID, s.CONTENT_CREATE_DT, s.JOB_LOG_ID, s.COUNTRY_CODE_TX, s.ENVIRONMENT_CODE_TX, s.PROCESS_IRI_WEEK_KEY, s.RECORD_CNT, s.PROCESS_CD, c.CLIENT_NAME_TX
from
	mdm.stg_catalog s
,	mdm.client c
where
	s.content_client_id		=	c.client_id 
and c.client_name_tx		=	''''DANONESN''''
and	s.table_name_tx			=	''''STG_IT_KEY'''' 
and	s.environment_code_tx	=	''''PRD''''
and	s.country_code_tx		=	''''UK''''
and	s.process_cd			=	''''SUCC''''''
)
order by content_create_dt desc'

insert into
	#extract_list
select * from
	[uksqlwp09\bld1].mdm_extracts.danonesn.extract_list

if @retrieve_job_log_id is null
	raiserror('checking for new mdm extracts for client danonesn',0,1) with nowait
else
	if exists (select 1 from #extract_list where job_log_id=@retrieve_job_log_id) begin
		raiserror('re-retrieving attributes for requested retrieve job_log_id %i',0,1,@retrieve_job_log_id)
		delete from ma_mdm.extract_list where job_log_id=@retrieve_job_log_id
	end else
		raiserror('requested retrieve job_log_id %i does not exist',0,1,@retrieve_job_log_id)

if	exists
	(
		select * from #extract_list
		except
		select * from ma_mdm.extract_list
	) begin

	insert into
		ma_mdm.extract_list
	select * from #extract_list
	except
	select * from ma_mdm.extract_list

	select
		@job_log_id	=	isnull(@retrieve_job_log_id,max(job_log_id))
	from
		ma_mdm.extract_list

	if @retrieve_job_log_id is null
		raiserror('new extract found for client danonesn, job_log_id=%i. Retrieving attributes...',0,1,@job_log_id) with nowait

	select
		@dyn_sql	=	concat
						(	N'if object_id(N''danonesn.attributes'') is not null drop table danonesn.attributes
'						,	N'
'						,	N'select
'						,	N'	JOB_LOG_ID
'						,	N',	DIM_KEY
'						,	N',	HIERARCHY_ID
'						,	N',	ATTRIBUTE_NAME_TX
'						,	N',	AVP_KEY
'						,	N',	ATTRIBUTE_VALUE_TX
'						,	N'into
'						,	N'	danonesn.attributes
'						,	N'from
'						,	N'	openquery
'						,	N'	(	[SV05MDMP]
'						,	N'	,	''select
'						,			N'	a.JOB_LOG_ID
'						,			N',	a.DIM_KEY
'						,			N',	a.HIERARCHY_ID
'						,			N',	coalesce(v.attribute_name_tx,a.attribute_name_tx) as ATTRIBUTE_NAME_TX
'						,			N',	coalesce(v.avp_key,a.avp_key) as AVP_KEY
'						,			N',	coalesce(v.attribute_value_tx,a.attribute_value_tx) as ATTRIBUTE_VALUE_TX
'						,			N'from
'						,			N'	mdm.stg_it_attribute a
'						,			N'left join
'						,			N'	mdm.stg_it_value_mapping v on v.job_log_id=a.job_log_id and v.avp_key=a.avp_key and v.hierarchy_id=a.hierarchy_id
'						,			N'where
'						,			N'	a.job_log_id=',	@job_log_id,N'
'						,			N'and	a.HIERARCHY_ID in (0,',cast(@hierarchy_id as nvarchar(max)),N') and a.DIM_KEY in (select distinct DIM_KEY from mdm.stg_it_attribute where job_log_id=',cast(@job_log_id as nvarchar(max)) + ' and HIERARCHY_ID=',cast(@hierarchy_id as nvarchar(max)),')
'						,	case when @full_attribute_list='N' then 
								N'and	coalesce(v.attribute_name_tx,a.attribute_name_tx) in (''''DESCRIPTION'''',''''SYSTEM'''',''''GENERATION'''',''''ITEM'''',''''VENDOR'''',''''EAN'''',''''UPC'''')''
'							else N'''' end
						,	N'	)'
						)

	exec [uksqlwp09\BLD1].mdm_extracts.dbo.sp_executesql @dyn_sql
 
	if object_id(N'ma_mdm.danonesn_attributes') is not null drop table ma_mdm.danonesn_attributes

	select * into
		ma_mdm.danonesn_attributes
	from
		[uksqlwp09\BLD1].mdm_extracts.danonesn.attributes
 
	raiserror('updating table ma_mdm.danone_sn_item_dim_keys',0,1) with nowait

	if object_id(N'ma_mdm.danone_sn_item_dim_keys') is not null
		drop table ma_mdm.danone_sn_item_dim_keys

	select
		s.job_log_id
	,	s.dim_key
	,	barcode		=	e.attribute_value_tx
	,	iricode13	=	concat	(	s.attribute_value_tx
								,	g.attribute_value_tx
								,	v.attribute_value_tx
								,	i.attribute_value_tx
								)
	,	iricode14	=	concat	(	s.attribute_value_tx
								,	right(concat('00',g.attribute_value_tx),2)
								,	v.attribute_value_tx
								,	i.attribute_value_tx
								)
	,	prod_desc	=	d.attribute_value_tx
	into
		ma_mdm.danone_sn_item_dim_keys
	from
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='SYSTEM') s
	join
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='GENERATION') g on g.dim_key=s.dim_key
	join
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='VENDOR') v on v.dim_key=s.dim_key
	join
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='ITEM') i on i.dim_key=s.dim_key
	join
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='EAN') e on e.dim_key=s.dim_key
	join
		(select job_log_id, dim_key, attribute_value_tx from ma_mdm.danonesn_attributes where attribute_name_tx='DESCRIPTION') d on d.dim_key=s.dim_key

	if @full_attribute_list='Y' begin
		raiserror('something else needs to be done here to transform all the attributes',0,1) with nowait
		select
			@dyn_sql	=
				concat
				(
