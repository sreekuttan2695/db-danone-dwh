create view [ff_ext].[view_formatted_for_xinlin_4_wks_2173_on] as
	select
		g.retailer_name
	,	g.fascia
	,	g.store_number
	,	g.address1
	,	g.posttown
	,	g.postcode
	,	store			=	concat
							(
								g.store_number
							,	' - '
							,	g.address1
							,	' '
							,	posttown
							,	' '
							,	postcode
							)
	,	d.prod_desc
	,	t.timeid
	,	t.datenum_date
	,	t.week_label
	,	d.tot_val
	,	d.eib_val
	,	d.dom_val
	from
		ff_ext.data_for_xinlin_20210611 d
	join
		ff_ext.dim_time t on t.timeid=d.iri_week
	join
		ff_ext.dim_geog g on g.ret_id=d.ret_id and g.store_id=d.store_id
