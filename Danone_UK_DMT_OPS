/****** Object:  View [RDW].[MASTER_TIME_AGG]    Script Date: 30/09/2026 07:46:39 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO



CREATE view [RDW].[MASTER_TIME_AGG] as

with w01 as (select * from rdw.master_time where tlevel='01WEEK'),
     w04 as (select * from rdw.master_time where tlevel='04WEEK'),
	 w05 as (select * from rdw.master_time where tlevel='05WEEK'),
	 w13 as (select * from rdw.master_time where tlevel='13WEEK'),
     w52 as (select * from rdw.master_time where tlevel='52WEEK'),
	 --Added 8 Sept 2017 by Chris Westgate to accommodate YTD and YTDYAG changes
	 wYD as (select * from rdw.master_time where TIME_KEY in (select TIME_KEY from PRD.DIM_TIME where YTD=1 or YTD_YAG=1)
	 --modified 5 Feb 2018 by Chris Westgate to only "add" time aggregations to this view for YTD and YTD YAG if they
	 --do not already exist in the above views - to avoid adding the same key twice, which lead to a doubling error
	 and TIME_KEY not in (	select TIME_KEY from w04 union select TIME_KEY from w05 union
							select TIME_KEY from w13 union select TIME_KEY from w52)
	 )

select convert(int,w01.Time_Key) WTimeID, convert(int,w04.Time_Key) AggTimeID
from w01 join w04 on w01.EndDate between dateadd(dd,(-(4*7))+1,w04.enddate) and w04.enddate
union all
select convert(int,w01.Time_Key) WTimeID, convert(int,w05.Time_Key) AggTimeID
from w01 join w05 on w01.EndDate between dateadd(dd,(-(5*7))+1,w05.enddate) and w05.enddate
union all
select convert(int,w01.Time_Key) WTimeID, convert(int,w13.Time_Key) AggTimeID
from w01 join w13 on w01.EndDate between dateadd(dd,(-(13*7))+1,w13.enddate) and w13.enddate
union all
select convert(int,w01.Time_Key) WTimeID, convert(int,w52.Time_Key) AggTimeID
from w01 join w52 on w01.EndDate between dateadd(dd,(-(52*7))+1,w52.enddate) and w52.enddate
union all
select convert(int,w01.Time_Key) WTimeID, convert(int,wYD.Time_Key) AggTimeID
from w01 join wYD on w01.EndDate between dateadd(dd,(-((cast(left(wYD.TLEVEL,2) as int))*7))+1,wYD.enddate) and wYD.enddate




GO
