-- =============================================
-- Author:		Chris Westgate
-- Create date: 28 Sep 2020
-- Description:	Returns data for a MASTER file matching the selected week of data from the SALES file function
-- Change:		27 Nov 2020 ueacw - restriction so JS data is not included beyond IRI week 2150 as Danone purchased JS Online from IRI
-- Change:		10 Dec 2020 ueacw - temporarily include "rolled forward" JS data because of gap between Danone's purchase and IRI's ability to fulfil in MA
-- Change:		Jan 2021 ueacw	  - instead of rolled forward Danone-supplied JS data, bring through JS online data from Tape 2 files for weeks 2151 onwards
-- Change:		Jan 2021 ueacw    - MA is populated with JS Online data directly from the warehouse, prevent JS data coming through completely
-- =============================================
CREATE FUNCTION [ma_cff].[ufn_1week_master_file_data_CW] 
(	
	@iriweek int
)
RETURNS TABLE 
AS
RETURN 
(
	with
	prod_ids as
	(
		select
			lgc	=	rank() over (partition by prodkey order by iricode desc)
		,	*
		from
		(
			select distinct
				prodid
			,	iricode
			,	prodkey	=	stuff(iricode,3,1,'')
			,	barcode
			,	swcode
			from
				ma_cff.ufn_1week_sales_data(@iriweek)
		) sfp
	)
-- select * from prod_ids order by iricode desc/*
,	tes_prods as
	(
		select
			* 
		from
			prod_ids p
		join
			ma_cff.tes_mst m on m.prod_id=p.swcode
		where
			p.lgc				=	1
		and
		(
			left(p.prodkey,2)	<>	'27'
		or	left(p.prodkey,5)	=	'27008'
		)
)
-- select * from tes_prods where barcode='5024121626104'/* 897 rows
,	jsb_prods as
	(
		select
			*
		from
			prod_ids p
		join
			ma_cff.jsb_mst m on m.prod_id=p.swcode
		where
			p.lgc	=	1
		and not exists (select 1 from tes_prods tp where tp.iricode=p.iricode)
		and
		(	left(p.prodkey,2)	<>	'27'
			or	left(p.prodkey,5)	in	('27011','27052')
		)	--	jsb
		and	@iriweek	<	2151	-- NB week 2151 put in here on 27 Nov 2020 because Danone will purchase JS online data from IRI 
									-- from week 2151 onwards and we must not include anything specifically only related to JS
									-- for subsequent weeks where it is not required, i.e. from week 2151 onwards
	)
-- select * from jsb_prods /* 422 rows
--,	jsb_tmp_rollforward_prods as
--	(
--		select
--			*
--		from
--			prod_ids p
--		join
--			ma_cff.jsb_mst m on m.prod_id=p.swcode -- this source may need to change once data is sourced from tape 2??
--		where
--			p.lgc	=	1
--		and not exists (select 1 from tes_prods tp where tp.iricode=p.iricode)
--		and
--		(	left(p.prodkey,2)	<>	'27'
--			or	left(p.prodkey,5)	in	('27011','27052')
--		)	--	jsb
--		and	@iriweek	>	2150	-- NB week 2151 put in here on 27 Nov 2020 because Danone will purchase JS online data from IRI 
--									-- from week 2151 onwards and we must not include anything specifically only related to JS
--									-- for subsequent weeks where it is not required, i.e. from week 2151 onwards
--	)	--*/
-- select * from jsb_tmp_rollforward_prods /* 422 rows

	select
		amp.*
	,	iriweek			=	@iriweek
	,	cff_filename	=	concat('infoscan.',@iriweek,'.sl1.MASTER')
	from
	(
		select
			*
		,	cff_output	=	concat
							(
								barcode
							,	cast(left(comm1,2) as char(6))
							,	cast(left(comm1,3) as char(6))
							,	cast(left(comm1,4) as char(6))
							,	cast(left(comm1,5) as char(6))
							,	cast(prod_name as char(90))
							)
		,	ecf_output	=	concat
							(
								stuff(iricode,3,0,'0')	,	char(9)
							,	left(comm1,2)			,	'|'
							,	left(comm1,3)			,	'|'
							,	left(comm1,4)			,	'|'
							,	left(comm1,5)			,	char(9)
							,	prod_name
							)
		from
			(
				select
					*
				,	r	=	rank() over(partition by prod_id order by maxtime desc)
				from
					tes_prods
			) p
		where
			r	=	1
		union all
		select
			*
		,	cff_output	=	concat
							(
								barcode
							,	cast(comm1 as char(6))
							,	cast(comm2 as char(6))
							,	space(12)
							,	cast(prod_name as char(90))
							)
		,	ecf_output	=	concat
							(
								stuff(iricode,3,0,'0')	,	char(9)
							,	cast(comm1 as int)		,	'|'
							,	cast(comm2 as int)		,	char(9)
							,	prod_name
							)
		from
			(
				select
					*
				,	r	=	rank() over(partition by prod_id order by maxtime desc)
				from
					jsb_prods
			) p
		where
			r	=	1
		--union all
		--select
		--	*
		--,	cff_output	=	concat
		--					(
		--						barcode
		--					,	cast(comm1 as char(6))
		--					,	cast(comm2 as char(6))
		--					,	space(12)
		--					,	cast(prod_name as char(90))
		--					)
		--,	ecf_output	=	concat
		--					(
		--						stuff(iricode,3,0,'0')	,	char(9)
		--					,	cast(comm1 as int)		,	'|'
		--					,	cast(comm2 as int)		,	char(9)
		--					,	prod_name
		--					)
		--from
		--	(
		--		select
		--			*
		--		,	r	=	rank() over(partition by prod_id order by maxtime desc)
		--		from
		--			jsb_tmp_rollforward_prods
		--	) p
		--where
		--	r	=	1	--*/
	) amp
)
