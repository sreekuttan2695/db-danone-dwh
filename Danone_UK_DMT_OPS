+ N' ,  CONSTRAINT [PK_' + RIGHT(@TBL_NAME,len(@TBL_NAME)-charindex('.',@TBL_NAME)) + N'] PRIMARY KEY CLUSTERED 
               (
	             [TIME_KEY] ASC,
                 [GEOG_KEY] ASC,
	             [PROD_KEY] ASC
