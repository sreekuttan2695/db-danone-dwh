CREATE VIEW [RDW].[SELECT_CORRECT_CSD_DB_TO_BUILD] as

with ManualB as (select TSSource, DB_TO_BUILD, DBDate from RDW.MANUAL_CHECK_DB_DATES_FOR_BUILD where TSSource='ManualDBBuild')
    ,IRIData as (select TSSource, DB_TO_BUILD, DBDate from RDW.MANUAL_CHECK_DB_DATES_FOR_BUILD where TSSource='LatestIRIData')
    ,IMSData as (select TSSource, DB_TO_BUILD, DBDate from RDW.MANUAL_CHECK_DB_DATES_FOR_BUILD where TSSource='LatestIMSData')
    ,BuildDT as (select TSSource, DB_TO_BUILD, DBDate from RDW.MANUAL_CHECK_DB_DATES_FOR_BUILD where TSSource='LatestBuildDT')
    ,LiveOPP as (SELECT 'CurrentLiveDB' TSSource
                      , 'Danone_UK_DMT_CSD_DB' + CONVERT(VARCHAR,3-CONVERT(INT,SUBSTRING(CurrentDBInTimeView,PATINDEX('%DB[0-9]%',CurrentDBInTimeView)+2,1))) DB_TO_BUILD
                      , CONVERT(datetime,'1 Jan 1900') DBDate
				--Note that backslash below causes this to appear in search for clash between 444 and 445 systems but no #445_change is required
                 FROM [WIN0285\PRD2].Danone_UK_DMT_VIEWS_QC.[ST].[CSD_VERSIONS] where AdvantageInstance='LIVE instance')

select DB_TO_BUILD = ISNULL(NULLIF(L.DB_TO_BUILD,A.DB_TO_BUILD),A.DB_TO_BUILD)
from LiveOPP L, (
select DB_TO_BUILD = 
 case when COUNT(distinct DBDate)<>2 then 
  (select case when COUNT(distinct DBDate)<>2 then 
    (select case when COUNT(distinct DBDate)<>2 then 
       --use database build time to determine database to build to
       --ie build to database that was built longest ago
       (select top 1 DB_TO_BUILD from BuildDT order by DBDate)
     else
     --use earliest latest IMS data time to determine database to build to
     --ie build to database with oldest IMS data
      (select top 1 DB_TO_BUILD from IMSData order by DBDate)
     end 
     from IMSData)
   else
   --use earliest latest IRI data time to determine database to build to
   --ie build to database with oldest IRI data
    (select top 1 DB_TO_BUILD from IRIData order by DBDate)
   end 
   from IRIData)
else
--use earliest datatime from Manual Build Override table RDW.MANUAL_BUILD_DB_CHOICE to determine database to build to
--ie ignore all automatic criteria and manually select database to build by entering a 1900s date in manual build table
 (select top 1 DB_TO_BUILD from ManualB order by DBDate)
end
from ManualB) A







