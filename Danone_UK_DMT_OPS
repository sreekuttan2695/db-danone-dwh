CREATE PROC [STG].[CREATE_MOVE_LOAD_JOB]
     @dtsxpath nvarchar(2000),
     @JobName nvarchar(200),
     @LoadDelayMins int=1

AS

--version 1v1

DECLARE @JobCat nvarchar(200)
DECLARE @JobCommand nvarchar(200)
DECLARE @JobDesc nvarchar(500)
DECLARE @JobStepName nvarchar(200)

--RAISERROR('Stored proc STG.FACT_CSD_VIEW_CREATE requires a correct Job category for the job to be created',16,1)
--RETURN

SET @JobCat=N'Danone_ELN_MT_Update'
SET @JobCommand=N'/FILE "' + @dtsxpath + N'" /CHECKPOINTING OFF /REPORTING E'
SET @JobDesc=N'Executes dtsx package ' + @dtsxpath + N' to load move file into database Danone_UK_DMT_OPS.
'           +N'Automatically created and scheduled by stored procedure STG.CREATE_MOVE_LOAD_JOB on ' + convert(varchar, getdate(),106) + '
'           +N'Should self delete on successful completion' 
SET @JobStepName=@JobName + N'_step_1'

BEGIN TRANSACTION

  DECLARE @ReturnCode INT
  SET @ReturnCode = 0

  DECLARE @jobId BINARY(16)
  select @jobId=job_id from msdb.dbo.sysjobs where [name] = @JobName

  if @JobId is not null exec msdb.dbo.sp_delete_job @JobId
  set @JobID = null

  if @jobid is null BEGIN
    EXEC @ReturnCode = msdb.dbo.sp_add_job
            @job_name=@JobName,
            @enabled=1,
            @notify_level_eventlog=0,
            @notify_level_email=2,
            @notify_level_netsend=2,
            @notify_level_page=2,
            @delete_level=1,
            @description=@JobDesc,
            @category_name=@JobCat,
            @owner_login_name=N'UKNT001\SQLService', @job_id = @jobId OUTPUT
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback

    EXEC @ReturnCode = msdb.dbo.sp_update_job @job_id = @jobId, @start_step_id = 1
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback

    EXEC @ReturnCode = msdb.dbo.sp_add_jobserver @job_id = @jobId, @server_name = N'(local)'
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback
  END

  if not exists(select * from msdb.dbo.sysjobsteps where job_id=@jobId) begin
    EXEC @ReturnCode = msdb.dbo.sp_add_jobstep
            @job_id=@jobId, @step_name=@JobStepName,
            @step_id=1,
            @cmdexec_success_code=0,
            @on_success_action=3,
            @on_success_step_id=0,
            @on_fail_action=2,
            @on_fail_step_id=0,
            @retry_attempts=0,
            @retry_interval=0,
            @os_run_priority=0, @subsystem=N'SSIS',
            @command=@JobCommand,
            @database_name=N'master',
            @flags=0
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback end

    EXEC @ReturnCode = msdb.dbo.sp_add_jobstep
         @job_id=@jobId, @step_name=N'EXEC STG.START_DATA_PROCESS_IF_ALL_MOVE_FILES_LOADED',
         @step_id=2,
         @cmdexec_success_code=0,
         @on_success_action=1,
         @on_success_step_id=0,
         @on_fail_action=2,
         @on_fail_step_id=0,
         @retry_attempts=0,
         @retry_interval=0,
         @os_run_priority=0, @subsystem=N'TSQL',
         @command=N'EXEC STG.START_DATA_PROCESS_IF_ALL_MOVE_FILES_LOADED',
         @database_name=N'Danone_UK_DMT_OPS',
         @flags=0
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback
  ELSE BEGIN
    EXEC msdb.dbo.sp_update_jobstep @job_id=@jobId, @step_id=1, @command=@JobCommand
    IF (@@ERROR <> 0 OR @ReturnCode <> 0) GOTO QuitWithRollback
  END

COMMIT TRANSACTION

GOTO EndSave

QuitWithRollback:
  IF (@@TRANCOUNT > 0) ROLLBACK TRANSACTION
  DECLARE @ErrMsg varchar(200)
  set @ErrMsg='Job creation/step change FAILED when creating/altering ' + @JobName
  RAISERROR(@ErrMsg,16,1)
  RETURN

EndSave:

if @LoadDelayMins=0
  exec msdb.dbo.sp_start_job @job_id=@jobId
  --NB sp_start_job call above was detected in search for potential clash between 444 and 445 processes but no #445_change is required here
else begin
  DECLARE @schedule_id int
  DECLARE @schedule_name nvarchar(100)
  DECLARE @active_s_date int
  DECLARE @active_s_time int

  set @schedule_name=@JobName + N'_Schedule'
  select @schedule_id=schedule_id from msdb.dbo.sysschedules where [name]=@schedule_name
  select @active_s_date=convert(int,CONVERT(varchar,dateadd(mi,@LoadDelayMins,GETDATE()),112))
  select @active_s_time=convert(int,REPLACE(CONVERT(varchar,dateadd(mi,@LoadDelayMins,GETDATE()),108),':',''))

  if @schedule_id is null
    EXEC msdb.dbo.sp_add_jobschedule @job_id=@jobId, @name=@schedule_name,
        @enabled=1,
        @freq_type=1,
        @freq_interval=1,
        @freq_subday_type=0,
        @freq_subday_interval=0,
        @freq_relative_interval=0,
        @freq_recurrence_factor=1,
        @active_start_date=@active_s_date,
        @active_end_date=99991231,
        @active_start_time=@active_s_time,
        @active_end_time=235959, @schedule_id = @schedule_id OUTPUT
  ELSE
    EXEC msdb.dbo.sp_update_jobschedule @job_id=@jobId, @name=@schedule_name,
        @enabled=1,
        @freq_type=1,
        @freq_interval=1,
        @freq_subday_type=0,
        @freq_subday_interval=0,
        @freq_relative_interval=0,
        @freq_recurrence_factor=1,
        @active_start_date=@active_s_date,
        @active_end_date=99991231,
        @active_start_time=@active_s_time,
        @active_end_time=235959
end

GO
