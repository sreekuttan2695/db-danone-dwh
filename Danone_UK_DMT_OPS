		'		,	N'	drop table ma_mdm.danone_sn_attribute_pivoted
		'		,	N'
		'		,	N'create table
		'		,	N'	ma_mdm.danone_sn_attribute_pivoted
		'		,	N'	(
		'		,	N'		[job_log_id]	int
		'		,	N'	,	[dim_key]		int
		'		,	N'	,	[hierarchy_id]	int
		'		,	N'	,	[iricode]		varchar(14)
		'		,	(
						select
						(
							select
								concat
								(
									N'	,	[' , cast(attr as nvarchar(max)), N']	nvarchar(255)
		'						)
							from
							(
								select distinct top 1000
									attr	=	lower(attribute_name_tx)
								from
									ma_mdm.danonesn_attributes
								order by attr
							) a
							for
								xml path	('')
							,	root		('MyString')
							,	type
						).value('/MyString[1]','varchar(max)')
					)
				,	N'	);
		'		,	N'
		'		,	N'with
		'		,	N'	tbl_attr_to_pivot
		'		,	N'as
		'		,	N'(
		'		,	N'	select
		'		,	N'		job_log_id
		'		,	N'	,	dim_key
		'		,	N'	,	hierarchy_id		=	',@hierarchy_id,N'
		'		,	N'	,	attribute_name_tx
		'		,	N'	,	attribute_value_tx	=	case when attribute_name_tx in (''generation'',''system'')
		'		,	N'									then
		'		,	N'										right(concat(''00'',attribute_value_tx),2)
		'		,	N'								else
		'		,	N'									attribute_value_tx
		'		,	N'								end
		'		,	N'	from
		'		,	N'		ma_mdm.danonesn_attributes
		'		,	N')
		'		,	N'
		'		,	N'insert into
		'		,	N'	ma_mdm.danone_sn_attribute_pivoted
		'		,	N'select
		'		,	N'	[job_log_id]
		'		,	N',	[dim_key]
		'		,	N',	[hierarchy_id]
		'		,	N',	[iricode]		=	concat([system],[generation],[vendor],[item])
		'		,	(
						select
						(
							select
								concat
								(
									N',	[' , cast(attr as nvarchar(max)), ']
		'						)
							from
							(
								select distinct top 1000
									attr	=	lower(attribute_name_tx)
								from
									ma_mdm.danonesn_attributes
								order by attr
							) a
							for
								xml path	('')
							,	root		('MyString')
							,	type
						).value('/MyString[1]','varchar(max)')
					)
				,	N'from
		'		,	N'	(
		'		,	N'		select
		'		,	N'			job_log_id
		'		,	N'		,	dim_key
		'		,	N'		,	hierarchy_id
		'		,	N'		,	attribute_name_tx
		'		,	N'		,	attribute_value_tx
		'		,	N'		from
		'		,	N'			tbl_attr_to_pivot
		'		,	N'	) ttp
		'		,	N'pivot
		'		,	N'(
		'		,	N'	max(attribute_value_tx)
		'		,	N'	for attribute_name_tx in
		'		,	N'	(
		'		,	N'		[iricode]
		'		,	(
						select
						(
							select
								concat
								(
									'	,	[' , cast(attr as nvarchar(max)), ']
		'						)
							from
							(
								select distinct top 1000
									attr	=	lower(attribute_name_tx)
								from
									ma_mdm.danonesn_attributes
								order by attr
							) a
							for
								xml path	('')
							,	root		('MyString')
							,	type
						).value('/MyString[1]','varchar(max)')
					)
				,	N'	)
		'		,	N') pvt'
				)
		select @dyn_sql
		exec sp_executesql @dyn_sql
	end
end
else begin
	select
		@job_log_id	=	max(job_log_id)
	from
		ma_mdm.extract_list

	raiserror('no new extract found for client danonesn; attributes in table ma_mdm.danone_sn_item_dim_keys come from existing job_log_id=%i',0,1,@job_log_id) with nowait
end

raiserror('stored proc ma_mdm.usp_refresh_mdm_attributes completed',0,1) with nowait

end
